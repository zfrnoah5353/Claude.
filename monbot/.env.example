# Copie ce fichier en ".env" et remplis-le.

# Le jeton du bot (Discord Developer Portal > ton appli > Bot > Reset Token). NE LE PARTAGE JAMAIS.
DISCORD_TOKEN=

# Nom affiché dans le panel
BOT_NAME=MonBot

# Port du panel (l'app .exe se connecte ici)
API_PORT=3000

# Clé secrète du panel (invente une longue phrase sans espaces). L'app .exe te la demandera.
PANEL_KEY=

# (optionnel) Juge IA des procès : clé sur https://console.anthropic.com (payant, quelques centimes par analyse)
ANTHROPIC_API_KEY=

# (optionnel) Pour les alertes Twitch du module Réseaux sociaux : https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
