Config.Hammers = {
	{ id = "wood", name = "Maillet en bois", rarity = 1, head = "B5835A", handle = "7A4E36", accent = "D9A066", shape = "mallet", bonus = 1.1, desc = "Le marteau de départ des apprentis confiseurs." },
	{ id = "gum", name = "Marteau Gomme", rarity = 1, head = "FF8FB8", handle = "FFFFFF", accent = "FF5A8A", shape = "mallet", bonus = 1.15, desc = "Rebondit à chaque coup." },
	{ id = "mint", name = "Marteau Menthe", rarity = 1, head = "7EE0B8", handle = "FFFFFF", accent = "3DBE8C", shape = "mallet", bonus = 1.2, desc = "Frais comme une pastille." },
	{ id = "lolly", name = "Sucette Massue", rarity = 2, head = "FFD54A", handle = "FFFFFF", accent = "FF5A6E", shape = "lolly", bonus = 1.35, desc = "Une sucette géante qui fait mal." },
	{ id = "cane", name = "Canne Sucrée", rarity = 2, head = "FF5A6E", handle = "FFFFFF", accent = "FFFFFF", shape = "cane", bonus = 1.4, desc = "Rayée rouge et blanc, crochet compris." },
	{ id = "choco", name = "Marteau Praliné", rarity = 2, head = "6B4430", handle = "E8B64A", accent = "D9A066", shape = "mallet", bonus = 1.45, desc = "Tout en chocolat noir." },
	{ id = "donut", name = "Donut Cogneur", rarity = 3, head = "E8A85A", handle = "FFFFFF", accent = "FF8FB8", shape = "donut", bonus = 1.7, desc = "Glaçage rose et vermicelles." },
	{ id = "ice", name = "Cornet Glacé", rarity = 3, head = "BDE9FF", handle = "E8A85A", accent = "FFFFFF", mat = "Glass", shape = "cone", bonus = 1.8, desc = "Gèle les tas de bonbons." },
	{ id = "jelly", name = "Marteau Gelée", rarity = 3, head = "B69CFF", handle = "6B5BD6", accent = "E2D8FF", mat = "Glass", shape = "mallet", bonus = 1.9, desc = "Translucide et tremblotant." },
	{ id = "cupcake", name = "Massue Cupcake", rarity = 4, head = "FFB3CF", handle = "FFFFFF", accent = "E8344E", shape = "cupcake", bonus = 2.3, desc = "Avec sa cerise sur le dessus." },
	{ id = "crystal", name = "Marteau Cristal", rarity = 4, head = "7FD6FF", handle = "C9C0FF", accent = "FFFFFF", mat = "Neon", shape = "crystal", bonus = 2.5, desc = "Brille dans le noir." },
	{ id = "gold", name = "Marteau d'Or", rarity = 5, head = "FFD23F", handle = "8C5A2A", accent = "FFF3B8", mat = "Foil", shape = "mallet", bonus = 3.2, desc = "Pour les rois du bonbon." },
	{ id = "comet", name = "Comète Cosmique", rarity = 5, head = "C04BD8", handle = "2A2350", accent = "7FD6FF", mat = "Neon", shape = "star", bonus = 3.5, desc = "Laisse une traînée d'étoiles." },
	{ id = "rainbow", name = "Marteau Arc-en-ciel", rarity = 6, head = "FF8FB8", handle = "FFFFFF", accent = "FFD54A", mat = "Neon", shape = "rainbow", bonus = 5, desc = "Toutes les couleurs à chaque coup." },
	{ id = "olympus", name = "Foudre d'Olympe", rarity = 6, head = "FFF3B8", handle = "E8B64A", accent = "7FD6FF", mat = "Neon", shape = "bolt", bonus = 6, desc = "Le marteau de Zeus en sucre d'orge." },
} :: { Hammer }
-- chances de tirage par rareté (en %), le reste va au Commun
Config.HAMMER_ODDS = { [1] = 47.5, [2] = 30, [3] = 15, [4] = 6, [5] = 1.3, [6] = 0.2 }
Config.HAMMER_ROLL_SECONDS = 25 -- prix d'un tirage = 25 s de gains (au moins 300 pièces)
Config.HAMMER_REFUND = 0.25 -- un doublon rend 25 % du prix

-- Vignettes des mondes et voyage : couleurs du ciel (haut, bas)
Config.WorldSky = {
	{ "7FC8FF", "FFD1EA" },
	{ "F3B98A", "FFE6C8" },
	{ "9FDCFF", "F2FBFF" },
	{ "120E2A", "6B3FA0" },
}

Config.Potions = {
	{ id = "coins", name = "Potion de pièces x2", color = hex("FFD54A"), gems = 10 },
	{ id = "luck", name = "Potion de chance x2", color = hex("7EE0B8"), gems = 10 },
	{ id = "dmg", name = "Potion de force x2", color = hex("FF5A6E"), gems = 10 },
}
Config.POTION_TIME = 600

---------------------------------------------------------------------------
-- Quêtes, index, cadeau
---------------------------------------------------------------------------
export type Quest = { text: string, kind: string, goal: number, coins: number, gems: number }

Config.StarterQuests = {
	{ text = "Casse 10 tas de bonbons", kind = "piles", goal = 10, coins = 150, gems = 0 },
	{ text = "Ouvre ton premier œuf", kind = "hatch", goal = 1, coins = 300, gems = 0 },
	{ text = "Équipe 3 pets", kind = "equip", goal = 3, coins = 0, gems = 5 },
	{ text = "Récolte 5K pièces", kind = "coins", goal = 5000, coins = 1500, gems = 0 },
	{ text = "Achète une amélioration", kind = "upgrade", goal = 1, coins = 0, gems = 5 },
	{ text = "Ouvre 15 œufs", kind = "hatch", goal = 15, coins = 0, gems = 10 },
	{ text = "Fusionne un pet doré", kind = "golden", goal = 1, coins = 0, gems = 20 },
	{ text = "Bats le Gummy Golem", kind = "boss", goal = 1, coins = 0, gems = 30 },
	{ text = "Débloque Choco Land", kind = "world", goal = 2, coins = 0, gems = 30 },
	{ text = "Fais ton premier Rebirth", kind = "rebirth", goal = 1, coins = 0, gems = 60 },
	{ text = "Ouvre 150 œufs", kind = "hatch", goal = 150, coins = 0, gems = 60 },
	{ text = "Débloque Ice Cream Island", kind = "world", goal = 3, coins = 0, gems = 100 },
	{ text = "Fusionne un pet arc-en-ciel", kind = "rainbow", goal = 1, coins = 0, gems = 120 },
	{ text = "Débloque Gummy Galaxy", kind = "world", goal = 4, coins = 0, gems = 200 },
	{ text = "Atteins le Rebirth 5", kind = "rebirth", goal = 5, coins = 0, gems = 300 },
} :: { Quest }

-- Quêtes dont la progression est l'état actuel (et non un compteur depuis le début)
Config.AbsoluteQuest = { equip = true, world = true, rebirth = true }

Config.DailyText = {
	piles = "Casse %s tas de bonbons",
	hatch = "Ouvre %s œufs",
	taps = "Clique %s fois sur des bonbons",
	coins = "Récolte %s pièces",
	boss = "Bats le boss %s fois",
	golden = "Fusionne %s pet doré",
}

Config.IndexMilestones = {
	{ need = 5, gems = 10 },
	{ need = 10, gems = 20 },
	{ need = 18, gems = 40 },
	{ need = 26, gems = 60 },
	{ need = 34, gems = 100 },
	{ need = 42, gems = 250 },
	{ need = 53, gems = 1000 },
}

Config.GiftLabels = { "Pièces", "10 gemmes", "Potion de pièces", "15 gemmes", "Potion de chance", "25 gemmes", "50 gemmes + force" }

---------------------------------------------------------------------------
-- Formules
---------------------------------------------------------------------------
Config.PILE_HP = { 15, 80, 600 } -- petit, moyen, coffre
Config.BASE_SLOTS = 4
Config.BASE_STORAGE = 60
Config.BOSS_INTERVAL = 600
Config.BOSS_WINDOW = 120
Config.BOSS_FIGHT = 90

function Config.rebirthCost(r: number): number
	return 250e3 * 12 ^ r
end

function Config.rebirthMult(r: number): number
	return 1 + 0.5 * r
end

function Config.tierMult(tier: number): number
	if tier == 1 then
		return 3
	elseif tier == 2 then
		return 10
	end
	return 1
end

Config.TierNames = { [0] = "", [1] = "Doré", [2] = "Arc-en-ciel" }

local suffixes = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234567 -> "1.23M"
function Config.fmt(n: number): string
	if n ~= n then
		return "0"
	end
	if n < 0 then
		return "-" .. Config.fmt(-n)
	end
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local i = 0
	while n >= 1000 and i < #suffixes do
		n /= 1000
		i += 1
	end
	local s
	if n < 10 then
		s = string.format("%.2f", math.floor(n * 100) / 100)
	elseif n < 100 then
		s = string.format("%.1f", math.floor(n * 10) / 10)
	else
		s = string.format("%d", math.floor(n))
	end
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s .. suffixes[i]
end

function Config.fmtTime(sec: number): string
	sec = math.max(0, math.floor(sec))
	if sec >= 3600 then
		return string.format("%dh %02dm", sec // 3600, (sec % 3600) // 60)
	end
	return string.format("%02d:%02d", sec // 60, sec % 60)
end

function Config.fmtChance(c: number): string
	if c >= 10 then
		return string.format("%d %%", math.floor(c + 0.5))
	elseif c >= 1 then
		return string.format("%.1f %%", c)
	elseif c >= 0.1 then
		return string.format("%.2f %%", c)
	end
	return string.format("%.3f %%", c)
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">HammerModels</string>
          <string name="Source"><![CDATA[--!strict
-- Modèles des marteaux à bonbons. La poignée part de l'origine (la main) vers +Y,
-- la tête est en haut. Utilisé dans la main des joueurs et dans les vignettes.

local Config = require(script.Parent.Config)

local HammerModels = {}

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

local MAT: { [string]: Enum.Material } = {
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
	Foil = Enum.Material.Foil,
}

function HammerModels.def(id: string): Config.Hammer
	for _, h in Config.Hammers do
		if h.id == id then
			return h
		end
	end
	return Config.Hammers[1]
end

-- scale : 1 = taille dans la main (environ 3,6 studs de long)
function HammerModels.build(id: string, scale: number?, anchored: boolean?): Model
	local h = HammerModels.def(id)
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = "Hammer_" .. h.id
	local headMat = if h.mat then MAT[h.mat] else Enum.Material.SmoothPlastic

	local function add(shape: string, size: Vector3, cf: CFrame, color: string, mat: Enum.Material?): BasePart
		local p = Instance.new("Part")
		p.Size = size * s
		p.CFrame = CFrame.new(cf.Position * s) * cf.Rotation
		p.Color = hex(color)
		p.Material = mat or Enum.Material.SmoothPlastic
		p.Anchored = anchored == true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape == "ball" then
			p.Shape = Enum.PartType.Ball
		elseif shape == "cyl" then
			p.Shape = Enum.PartType.Cylinder
		end
		p.Parent = model
		return p
	end
	local UP = CFrame.Angles(0, 0, math.rad(90)) -- cylindre vertical
	local FACE = CFrame.Angles(0, math.rad(90), 0) -- disque face à l'avant (-Z)

	-- poignée
	local handle = add("cyl", Vector3.new(2.6, 0.32, 0.32), CFrame.new(0, 1.2, 0) * UP, h.handle)
	handle.Name = "Handle"
	add("cyl", Vector3.new(0.3, 0.42, 0.42), CFrame.new(0, 0.05, 0) * UP, h.accent)
	add("cyl", Vector3.new(0.3, 0.42, 0.42), CFrame.new(0, 2.3, 0) * UP, h.accent)
	local top = 2.9

	if h.shape == "mallet" or h.shape == "rainbow" then
		add("cyl", Vector3.new(1.7, 1.05, 1.05), CFrame.new(0, top, 0), h.head, headMat)
		for _, x in { -0.85, 0.85 } do
			add("cyl", Vector3.new(0.22, 1.2, 1.2), CFrame.new(x, top, 0), h.accent, headMat)
		end
		if h.shape == "rainbow" then
			local cols = { "FF5A6E", "FF9A3C", "FFD54A", "7EE0B8", "7FD6FF", "B69CFF" }
			for i, c in cols do
				add("cyl", Vector3.new(0.24, 1.1, 1.1), CFrame.new(-0.7 + (i - 1) * 0.28, top, 0), c, Enum.Material.Neon)
			end
		end
	elseif h.shape == "lolly" then
		add("cyl", Vector3.new(0.3, 1.9, 1.9), CFrame.new(0, top + 0.3, 0) * FACE, h.head, headMat)
		add("cyl", Vector3.new(0.34, 1.25, 1.25), CFrame.new(0, top + 0.3, 0) * FACE, h.accent)
		add("cyl", Vector3.new(0.38, 0.6, 0.6), CFrame.new(0, top + 0.3, 0) * FACE, h.head, headMat)
	elseif h.shape == "cane" then
		for i = 0, 5 do
			add("cyl", Vector3.new(0.45, 0.5, 0.5), CFrame.new(0, 2.5 + i * 0.4, 0) * UP, if i % 2 == 0 then h.head else h.accent)
		end
		for k = 1, 6 do
			local a = math.pi * k / 6
			add("ball", Vector3.one * 0.52, CFrame.new(0.5 - math.cos(a) * 0.5, 4.8 + math.sin(a) * 0.5, 0), if k % 2 == 0 then h.head else h.accent)
		end
	elseif h.shape == "donut" then
		for i = 0, 11 do
			local a = i / 12 * math.pi * 2
			local p = CFrame.new(math.cos(a) * 0.7, top + 0.4 + math.sin(a) * 0.7, 0)
			add("ball", Vector3.one * 0.62, p, h.head, headMat)
			add("ball", Vector3.one * 0.46, p * CFrame.new(0, 0, -0.18), h.accent)
		end
	elseif h.shape == "cone" then
		for i = 0, 3 do
			add("cyl", Vector3.new(0.3, 0.35 + i * 0.22, 0.35 + i * 0.22), CFrame.new(0, 2.4 + i * 0.3, 0) * UP, "E8A85A")
		end
		add("ball", Vector3.one * 1.2, CFrame.new(0, 3.75, 0), h.head, headMat)
		add("ball", Vector3.one * 0.95, CFrame.new(0, 4.5, 0), h.accent)
		add("ball", Vector3.one * 0.3, CFrame.new(0, 5.05, 0), "E8344E")
	elseif h.shape == "cupcake" then
		add("cyl", Vector3.new(0.8, 1.2, 1.2), CFrame.new(0, top, 0) * UP, h.accent)
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			add("ball", Vector3.one * 0.7, CFrame.new(math.cos(a) * 0.4, top + 0.6, math.sin(a) * 0.4), h.head)
		end
		add("ball", Vector3.one * 0.8, CFrame.new(0, top + 1.0, 0), h.head)
		add("ball", Vector3.one * 0.38, CFrame.new(0, top + 1.5, 0), "E8344E")
	elseif h.shape == "crystal" then
		for i = 0, 2 do
			add("block", Vector3.new(0.5, 1.8, 0.5), CFrame.new(0, top + 0.4, 0) * CFrame.Angles(0, math.rad(i * 60), math.rad(18 * (i - 1))), h.head, headMat)
		end
		add("ball", Vector3.one * 0.7, CFrame.new(0, top, 0), h.accent, Enum.Material.Neon)
	elseif h.shape == "star" then
		for i = 0, 4 do
			add("block", Vector3.new(0.5, 1.9, 0.3), CFrame.new(0, top + 0.5, 0) * CFrame.Angles(0, 0, math.rad(i * 72)), h.head, headMat)
		end
		add("ball", Vector3.one * 0.8, CFrame.new(0, top + 0.5, 0), h.accent, Enum.Material.Neon)
	elseif h.shape == "bolt" then
		local zig = { { 0.0, 2.6, 25 }, { 0.3, 3.3, -30 }, { -0.1, 4.0, 25 }, { 0.25, 4.7, -30 } }
		for _, z in zig do
			add("block", Vector3.new(0.4, 0.9, 0.35), CFrame.new(z[1], z[2], 0) * CFrame.Angles(0, 0, math.rad(z[3])), h.head, headMat)
		end
		add("ball", Vector3.one * 0.6, CFrame.new(0.1, 5.2, 0), h.accent, Enum.Material.Neon)
	end

	-- brillance pour les plus rares
	if h.rarity >= 5 then
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(hex(h.head), hex(h.accent))
		pe.LightEmission = 1
		pe.Rate = 10
		pe.Lifetime = NumberRange.new(0.5, 1)
		pe.Speed = NumberRange.new(0.5, 1.5)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3 * s), NumberSequenceKeypoint.new(1, 0) })
		local head = model:GetChildren()[#model:GetChildren()] :: BasePart
		pe.Parent = head
	end
	model.PrimaryPart = handle
	return model
end

return HammerModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MapDecor</string>
          <string name="Source"><![CDATA[--!strict
-- Décor des mondes, calculé sans Roblox (pur Luau) : une liste de pièces.
-- Le serveur les crée ; tools/web peut aussi les afficher pour un aperçu.
-- Repère : origine du monde, champ de bonbons |x| < 110 et -70 < z < 110,
-- place des œufs autour de z = -115, murs à |x| = 202 et |z| = 172.
-- Une pièce : { s = forme, size = {x,y,z}, p = {x,y,z}, r = {rx,ry,rz} en degrés,
-- c = couleur hex, m = matériau, t = transparence, col = collision, light = portée,
-- fx = "sparkle" | "bubbles" | "snow" | "stars" }

export type Spec = {
	s: string,
	size: { number },
	p: { number },
	r: { number }?,
	c: string,
	m: string?,
	t: number?,
	col: boolean?,
	light: number?,
	fx: string?,
}

local Decor = {}

-- champ de bonbons (les tas apparaissent dedans) : |x| < FX, Z0 < z < Z1
Decor.FX, Decor.Z0, Decor.Z1 = 110, -70, 110
local FX, Z0, Z1 = Decor.FX, Decor.Z0, Decor.Z1
-- bosquets dans le champ (les tas de bonbons évitent un rayon de GROVE_R autour)
Decor.GROVES = { { -75, -35 }, { 75, -35 }, { -78, 62 }, { 78, 62 }, { -32, 96 }, { 34, 96 } }
Decor.GROVE_R = 14

type Ctx = { out: { Spec }, rnd: () -> number }

local function rand(ctx: Ctx, a: number, b: number): number
	return a + (b - a) * ctx.rnd()
end

local function pick<T>(ctx: Ctx, list: { T }): T
	return list[math.floor(ctx.rnd() * #list) + 1]
end

local function add(ctx: Ctx, s: string, size: { number }, p: { number }, c: string, extra: { [string]: any }?): Spec
	local spec: Spec = { s = s, size = size, p = p, c = c }
	if extra then
		for k, v in extra do
			(spec :: any)[k] = v
		end
	end
	table.insert(ctx.out, spec)
	return spec
end

local function ball(ctx: Ctx, d: number, x: number, y: number, z: number, c: string, extra: { [string]: any }?)
	return add(ctx, "ball", { d, d, d }, { x, y, z }, c, extra)
end

-- cylindre vertical (l'axe d'un cylindre Roblox est X : on le tourne de 90° sur Z)
local function pole(ctx: Ctx, d: number, h: number, x: number, y0: number, z: number, c: string, extra: { [string]: any }?)
	local e: { [string]: any } = extra or {}
	e.r = { 0, 0, 90 }
	return add(ctx, "cyl", { h, d, d }, { x, y0 + h / 2, z }, c, e)
end

-- disque horizontal
local function disc(ctx: Ctx, d: number, h: number, x: number, y: number, z: number, c: string, extra: { [string]: any }?)
	local e: { [string]: any } = extra or {}
	e.r = { 0, 0, 90 }
	return add(ctx, "cyl", { h, d, d }, { x, y, z }, c, e)
end

local function box(ctx: Ctx, sx: number, sy: number, sz: number, x: number, y: number, z: number, c: string, extra: { [string]: any }?)
	return add(ctx, "block", { sx, sy, sz }, { x, y, z }, c, extra)
end

---------------------------------------------------------------------------
-- Accessoires
---------------------------------------------------------------------------
local function lollipop(ctx: Ctx, x: number, z: number, h: number, c: string, c2: string)
	pole(ctx, h * 0.07, h, x, 0, z, "FFFFFF", { col = true })
	local d = h * 0.55
	local yaw = rand(ctx, 0, 180)
	local y = h + d * 0.4
	-- disque face caméra : cylindre couché tourné sur Y
	add(ctx, "cyl", { d * 0.16, d, d }, { x, y, z }, c, { r = { 0, yaw, 0 } })
	add(ctx, "cyl", { d * 0.18, d * 0.66, d * 0.66 }, { x, y, z }, c2, { r = { 0, yaw, 0 } })
	add(ctx, "cyl", { d * 0.2, d * 0.33, d * 0.33 }, { x, y, z }, c, { r = { 0, yaw, 0 } })
	add(ctx, "block", { d * 0.22, d * 0.06, d * 0.1 }, { x, y + h * 0.02, z }, "FFFFFF", { r = { 0, yaw + 90, 0 } })
end

local function candyCane(ctx: Ctx, x: number, z: number, h: number, yaw: number, c: string)
	local d = math.max(0.8, h * 0.08)
	local n = math.max(4, math.floor(h / (d * 1.2)))
	for i = 0, n - 1 do
		pole(ctx, d, h / n, x, i * h / n, z, if i % 2 == 0 then c else "FFFFFF", { col = i == 0 })
	end
	-- crochet
	local r = h * 0.16
	local ry = math.rad(yaw)
	for k = 1, 6 do
		local a = math.pi * k / 6
		local cx, cy = r - math.cos(a) * r, h + math.sin(a) * r
		add(ctx, "ball", { d * 1.02, d * 1.02, d * 1.02 }, { x + math.cos(ry) * cx, cy, z - math.sin(ry) * cx }, if k % 2 == 0 then c else "FFFFFF")
	end
end

local function gumdropTree(ctx: Ctx, x: number, z: number, h: number, cols: { string })
	pole(ctx, h * 0.12, h * 0.6, x, 0, z, "FFF6E6", { col = true })
	for i = 1, 4 do
		local d = h * rand(ctx, 0.32, 0.45)
		ball(ctx, d, x + rand(ctx, -h * 0.18, h * 0.18), h * 0.62 + rand(ctx, -h * 0.05, h * 0.18), z + rand(ctx, -h * 0.18, h * 0.18), pick(ctx, cols))
	end
end

local function cottonTree(ctx: Ctx, x: number, z: number, h: number, c: string)
	pole(ctx, h * 0.08, h * 0.55, x, 0, z, "FFFFFF", { col = true })
	for i = 1, 6 do
		local d = h * rand(ctx, 0.25, 0.36)
		ball(ctx, d, x + rand(ctx, -h * 0.2, h * 0.2), h * 0.6 + rand(ctx, 0, h * 0.25), z + rand(ctx, -h * 0.2, h * 0.2), c, { m = "Sand" })
	end
end

local function bush(ctx: Ctx, x: number, z: number, s: number, cols: { string })
	for i = 1, 3 do
		ball(ctx, s * rand(ctx, 0.7, 1.1), x + rand(ctx, -s * 0.5, s * 0.5), s * 0.3, z + rand(ctx, -s * 0.5, s * 0.5), pick(ctx, cols), { col = i == 1 })
	end
end

local function cupcakeHouse(ctx: Ctx, x: number, z: number, s: number, wrap: string, frost: string, yaw: number)
	-- moule cannelé
	local n = 14
	for i = 0, n - 1 do
		local a = 2 * math.pi * i / n
		box(ctx, s * 0.42, s * 0.9, s * 0.2, x + math.cos(a) * s * 0.62, s * 0.45, z + math.sin(a) * s * 0.62, if i % 2 == 0 then wrap else "FFFFFF", { r = { 0, -math.deg(a) + 90, 0 }, col = true })
	end
	disc(ctx, s * 1.3, s * 0.9, x, s * 0.45, z, wrap)
	-- glaçage en boules
	for k = 0, 2 do
		local rr = s * (0.62 - k * 0.2)
		local m = 9 - k * 3
		for i = 0, m - 1 do
			local a = 2 * math.pi * i / m + k
			ball(ctx, s * (0.55 - k * 0.1), x + math.cos(a) * rr, s * (1.0 + k * 0.3), z + math.sin(a) * rr, frost)
		end
	end
	ball(ctx, s * 0.32, x, s * 1.85, z, "E8344E")
	-- porte et fenêtres lumineuses
	local ry = math.rad(yaw)
	local fx, fz = math.sin(ry), math.cos(ry)
	box(ctx, s * 0.28, s * 0.46, 0.3, x + fx * s * 0.72, s * 0.23, z + fz * s * 0.72, "7A4E36", { r = { 0, yaw, 0 } })
	for _, side in { -1, 1 } do
		local ox, oz = math.cos(ry) * side * s * 0.4, -math.sin(ry) * side * s * 0.4
		box(ctx, s * 0.18, s * 0.18, 0.3, x + fx * s * 0.6 + ox, s * 0.58, z + fz * s * 0.6 + oz, "FFE27A", { r = { 0, yaw + side * 30, 0 }, m = "Neon" })
	end
end

local function donut(ctx: Ctx, x: number, z: number, R: number, dough: string, icing: string)
	local n = 14
	for i = 0, n - 1 do
		local a = 2 * math.pi * i / n
		local cx, cy = x + math.cos(a) * R, R + 0.6 * R + math.sin(a) * R
		ball(ctx, R * 0.85, cx, cy, z, dough, { col = i == 0 })
		ball(ctx, R * 0.62, cx, cy, z - R * 0.25, icing)
	end
	for i = 1, 10 do
		local a = rand(ctx, 0, 2 * math.pi)
		box(ctx, R * 0.25, R * 0.08, R * 0.08, x + math.cos(a) * R, 1.6 * R + math.sin(a) * R, z - R * 0.6, pick(ctx, { "FF5A8A", "7FD6FF", "FFD54A", "FFFFFF", "7EE0B8" }), { r = { 0, 0, rand(ctx, 0, 180) } })
	end
end

local function lamp(ctx: Ctx, x: number, z: number, c: string)
	pole(ctx, 0.7, 9, x, 0, z, "FFFFFF", { col = true })
	ball(ctx, 2.4, x, 9.8, z, c, { m = "Neon", light = 18 })
	disc(ctx, 2.8, 0.4, x, 8.9, z, "FFD54A")
end

local function fenceRow(ctx: Ctx, x0: number, z0: number, x1: number, z1: number, step: number, c: string)
	local len = math.sqrt((x1 - x0) ^ 2 + (z1 - z0) ^ 2)
	local n = math.floor(len / step)
	local yaw = math.deg(math.atan2(-(z1 - z0), x1 - x0))
	for i = 0, n do
		local u = i / math.max(1, n)
		local x, z = x0 + (x1 - x0) * u, z0 + (z1 - z0) * u
		pole(ctx, 1.1, 4.5, x, 0, z, if i % 2 == 0 then c else "FFFFFF", { col = true })
		ball(ctx, 1.4, x, 4.8, z, if i % 2 == 0 then "FFFFFF" else c)
	end
	for _, y in { 1.6, 3.4 } do
		add(ctx, "block", { len, 0.5, 0.5 }, { (x0 + x1) / 2, y, (z0 + z1) / 2 }, "FFF6E6", { r = { 0, yaw, 0 } })
	end
end

local function cloud(ctx: Ctx, x: number, y: number, z: number, s: number, c: string)
	for i = 1, 6 do
		ball(ctx, s * rand(ctx, 0.5, 0.9), x + rand(ctx, -s, s), y + rand(ctx, -s * 0.15, s * 0.2), z + rand(ctx, -s * 0.4, s * 0.4), c, { m = "Sand" })
	end
end

local function hill(ctx: Ctx, x: number, z: number, s: number, c: string, cap: string?)
	ball(ctx, s, x, -s * 0.22, z, c, { col = true })
	if cap then
		ball(ctx, s * 0.55, x, s * 0.2, z, cap)
	end
end

local function sprinkles(ctx: Ctx, x0: number, x1: number, z0: number, z1: number, n: number, cols: { string })
	for _ = 1, n do
		box(ctx, rand(ctx, 1.6, 2.8), 0.12, 0.5, rand(ctx, x0, x1), 0.08, rand(ctx, z0, z1), pick(ctx, cols), { r = { 0, rand(ctx, 0, 180), 0 } })
	end
end

local function flowerPatch(ctx: Ctx, x: number, z: number, cols: { string })
	for _ = 1, 5 do
		local fx, fz = x + rand(ctx, -3, 3), z + rand(ctx, -3, 3)
		pole(ctx, 0.25, 1.4, fx, 0, fz, "3DBE5C")
		ball(ctx, 1.1, fx, 1.6, fz, pick(ctx, cols))
	end
end

-- Chocolat
local function chocoBar(ctx: Ctx, x: number, z: number, s: number, yaw: number)
	box(ctx, s * 1.6, s * 0.35, s, x, s * 0.17, z, "5A3424", { r = { 0, yaw, 0 }, col = true })
	local ry = math.rad(yaw)
	for i = -1, 1 do
		for j = 0, 1 do
			local lx, lz = i * s * 0.5, (j - 0.5) * s * 0.48
			box(ctx, s * 0.42, s * 0.12, s * 0.4, x + math.cos(ry) * lx + math.sin(ry) * lz, s * 0.4, z - math.sin(ry) * lx + math.cos(ry) * lz, "6B4430", { r = { 0, yaw, 0 } })
		end
	end
	-- papier doré déchiré
	box(ctx, s * 0.6, s * 0.4, s * 1.05, x - math.cos(ry) * s * 0.55, s * 0.2, z + math.sin(ry) * s * 0.55, "E8B64A", { r = { 0, yaw, 0 }, m = "Foil" })
end

local function truffleTree(ctx: Ctx, x: number, z: number, h: number)
	pole(ctx, h * 0.1, h * 0.65, x, 0, z, "8A5A3A", { col = true })
	for i = 1, 4 do
		local d = h * rand(ctx, 0.3, 0.42)
		ball(ctx, d, x + rand(ctx, -h * 0.2, h * 0.2), h * 0.7 + rand(ctx, -h * 0.05, h * 0.2), z + rand(ctx, -h * 0.2, h * 0.2), pick(ctx, { "4A2C20", "5A3424", "3A2214" }))
	end
	for _ = 1, 8 do
		box(ctx, 0.9, 0.25, 0.25, x + rand(ctx, -h * 0.3, h * 0.3), h * rand(ctx, 0.75, 1.05), z + rand(ctx, -h * 0.3, h * 0.3), pick(ctx, { "FF5A8A", "FFD54A", "FFFFFF", "7FD6FF" }), { r = { rand(ctx, 0, 90), rand(ctx, 0, 180), 0 } })
	end
end

local function cookie(ctx: Ctx, x: number, z: number, s: number)
	add(ctx, "cyl", { s * 0.25, s, s }, { x, s * 0.5, z }, "D9A066", { r = { 0, rand(ctx, 0, 180), rand(ctx, -15, 15) }, col = true })
	for _ = 1, 6 do
		ball(ctx, s * 0.12, x + rand(ctx, -s * 0.3, s * 0.3), s * rand(ctx, 0.25, 0.75), z - s * 0.14, "4A2C20")
	end
end

local function chocoFountain(ctx: Ctx, x: number, z: number)
	disc(ctx, 22, 1.4, x, 0.7, z, "E8B64A", { col = true })
	disc(ctx, 20, 1.2, x, 1.3, z, "6B4430", { m = "Glass", t = 0.1 })
	for k = 0, 2 do
		pole(ctx, 3 - k * 0.6, 4, x, 1.5 + k * 4, z, "FFF6E6", { col = true })
		disc(ctx, 12 - k * 3.5, 0.8, x, 5.6 + k * 4, z, "E8B64A")
		disc(ctx, 11 - k * 3.5, 0.6, x, 5.9 + k * 4, z, "5A3424")
	end
	ball(ctx, 2.6, x, 18.4, z, "5A3424", { fx = "bubbles" })
end

-- Glace
local function iceCone(ctx: Ctx, x: number, z: number, h: number, cols: { string })
	local n = 6
	for i = 0, n - 1 do
		local d = h * 0.06 + h * 0.3 * (i / n)
		pole(ctx, d, h * 0.6 / n, x, i * h * 0.6 / n, z, if i % 2 == 0 then "E8A85A" else "D9954A", { col = i == 0 })
	end
	for i = 1, 3 do
		ball(ctx, h * (0.36 - i * 0.04), x, h * 0.6 + (i - 1) * h * 0.25, z, pick(ctx, cols))
	end
	ball(ctx, h * 0.1, x, h * 1.22, z, "E8344E")
end

local function popsicle(ctx: Ctx, x: number, z: number, h: number, c: string)
	box(ctx, h * 0.16, h * 0.45, h * 0.06, x, h * 0.22, z, "E8C9A0", { col = true })
	box(ctx, h * 0.5, h * 0.55, h * 0.28, x, h * 0.7, z, c)
	add(ctx, "cyl", { h * 0.28, h * 0.5, h * 0.5 }, { x, h * 0.98, z }, c, { r = { 0, 90, 0 } })
end

local function crystal(ctx: Ctx, x: number, z: number, h: number, c: string, neon: boolean)
	for i = 1, 3 do
		local hh = h * rand(ctx, 0.5, 1)
		box(ctx, h * 0.18, hh, h * 0.18, x + rand(ctx, -h * 0.15, h * 0.15), hh * 0.45, z + rand(ctx, -h * 0.15, h * 0.15), c, { r = { rand(ctx, -18, 18), rand(ctx, 0, 90), rand(ctx, -18, 18) }, m = if neon then "Neon" else "Glass", t = if neon then 0.15 else 0.35, col = i == 1 })
	end
end

-- Galaxie
local function planet(ctx: Ctx, x: number, y: number, z: number, d: number, c: string, ring: string)
	ball(ctx, d, x, y, z, c)
	add(ctx, "cyl", { 0.3, d * 1.8, d * 1.8 }, { x, y, z }, ring, { r = { 0, rand(ctx, 0, 180), 70 }, t = 0.3, m = "Neon" })
end

local function star(ctx: Ctx, x: number, y: number, z: number, s: number, c: string)
	for i = 0, 4 do
		add(ctx, "block", { s * 0.28, s, s * 0.2 }, { x, y, z }, c, { r = { 0, 0, i * 72 }, m = "Neon" })
	end
end

local function ufo(ctx: Ctx, x: number, y: number, z: number)
	disc(ctx, 14, 1.6, x, y, z, "C9C0FF", { m = "Metal" })
	ball(ctx, 6, x, y + 1.6, z, "7FD6FF", { m = "Glass", t = 0.3 })
	for i = 0, 7 do
		local a = i * math.pi / 4
		ball(ctx, 1, x + math.cos(a) * 6.4, y - 0.4, z + math.sin(a) * 6.4, "FFE27A", { m = "Neon" })
	end
end

---------------------------------------------------------------------------
-- Disposition par monde
---------------------------------------------------------------------------
local function inField(x: number, z: number, pad: number): boolean
	return math.abs(x) < FX + pad and z > Z0 - pad and z < Z1 + pad
end
local function inPlaza(x: number, z: number): boolean
	return math.abs(x) < 160 and z < -70 and z > -165
end

-- points libres dans l'île, hors champ et place
local function freeSpot(ctx: Ctx, margin: number): (number, number)
	for _ = 1, 60 do
		local x, z = rand(ctx, -195, 195), rand(ctx, -165, 165)
		if not inField(x, z, margin) and not inPlaza(x, z) then
			return x, z
		end
	end
	return 180, 160
end

-- point de l'anneau extérieur (paysage autour de l'île)
local function ringSpot(ctx: Ctx, r0: number, r1: number): (number, number)
	local a = rand(ctx, 0, 2 * math.pi)
	local r = rand(ctx, r0, r1)
	return math.cos(a) * r * 1.1, math.sin(a) * r
end

function Decor.build(theme: string, palette: { string }, seed: number): { Spec }
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	local ctx: Ctx = {
		out = {},
		rnd = function(): number
			state = (state * 16807) % 2147483647
			return state / 2147483647
		end,
	}
	local P = palette

	-- sol extérieur (évite le vide au bord de l'île) et collines de fond
	local outer = { meadow = "B8F0C8", choco = "8A5A3A", ice = "EAF7FF", galaxy = "1B1638" }
	box(ctx, 700, 2, 700, 0, -3.2, 0, outer[theme] or "B8F0C8", { m = if theme == "ice" then "Snow" else "SmoothPlastic" })

	if theme == "meadow" then
		-- fond : collines arc-en-ciel, sucettes et cannes géantes
		for _ = 1, 16 do
			local x, z = ringSpot(ctx, 250, 320)
			hill(ctx, x, z, rand(ctx, 50, 90), pick(ctx, { "8EDDB4", "A6E8C4", "FFB3CF", "B69CFF" }), "FFFFFF")
		end
		for _ = 1, 10 do
			local x, z = ringSpot(ctx, 225, 300)
			if ctx.rnd() < 0.5 then
				lollipop(ctx, x, z, rand(ctx, 35, 55), pick(ctx, P), pick(ctx, { "FFFFFF", "FFF3B8" }))
			else
				candyCane(ctx, x, z, rand(ctx, 35, 55), rand(ctx, 0, 360), "FF5A6E")
			end
		end
		-- île : maisons cupcake, arbres, buissons, sucettes
		for i = 1, 9 do
			local x, z = freeSpot(ctx, 22)
			cupcakeHouse(ctx, x, z, rand(ctx, 9, 13), pick(ctx, P), pick(ctx, { "FFFFFF", "FFE3EE", "E3F6FF" }), math.deg(math.atan2(-x, -z)))
		end
		for _ = 1, 44 do
			local x, z = freeSpot(ctx, 10)
			local k = ctx.rnd()
			if k < 0.35 then
				gumdropTree(ctx, x, z, rand(ctx, 11, 17), P)
			elseif k < 0.6 then
				cottonTree(ctx, x, z, rand(ctx, 11, 16), pick(ctx, { "FFB3D1", "BDE9FF", "E2D8FF" }))
			elseif k < 0.8 then
				lollipop(ctx, x, z, rand(ctx, 10, 16), pick(ctx, P), "FFFFFF")
			else
				candyCane(ctx, x, z, rand(ctx, 10, 15), rand(ctx, 0, 360), "FF5A6E")
			end
		end
		for _ = 1, 30 do
			local x, z = freeSpot(ctx, 4)
			bush(ctx, x, z, rand(ctx, 3, 5), { "8EDDB4", "A6E8C4", "FFB3CF" })
		end
		for _ = 1, 24 do
			local x, z = freeSpot(ctx, 2)
			flowerPatch(ctx, x, z, { "FF5A8A", "FFD54A", "FFFFFF", "B69CFF" })
		end
		donut(ctx, -175, -40, 9, "E8A85A", "FF8FB8")
		donut(ctx, 176, 60, 8, "E8A85A", "7FD6FF")
		for _ = 1, 10 do
			cloud(ctx, rand(ctx, -300, 300), rand(ctx, 70, 110), rand(ctx, -300, 300), rand(ctx, 10, 18), "FFFFFF")
		end
	elseif theme == "choco" then
		for _ = 1, 16 do
			local x, z = ringSpot(ctx, 250, 320)
			hill(ctx, x, z, rand(ctx, 50, 90), pick(ctx, { "5A3424", "6B4430", "4A2C20" }), pick(ctx, { "F3DCC2", "FFFFFF", "FF8FB8" }))
		end
		for _ = 1, 8 do
			local x, z = ringSpot(ctx, 225, 290)
			truffleTree(ctx, x, z, rand(ctx, 30, 45))
		end
		-- rivière de chocolat derrière le champ
		box(ctx, 380, 0.3, 14, 0, 0.12, 157, "5A3424", { m = "Glass", t = 0.05 })
		for i = -4, 4 do
			box(ctx, 16, 1.2, 4, i * 42, 0.6, 157, "D9A066", { col = true })
		end
		chocoFountain(ctx, -178, 40)
		chocoFountain(ctx, 178, -30)
		for _ = 1, 12 do
			local x, z = freeSpot(ctx, 20)
			chocoBar(ctx, x, z, rand(ctx, 8, 12), rand(ctx, 0, 180))
		end
		for _ = 1, 38 do
			local x, z = freeSpot(ctx, 10)
			if ctx.rnd() < 0.6 then
				truffleTree(ctx, x, z, rand(ctx, 11, 17))
			else
				cookie(ctx, x, z, rand(ctx, 7, 11))
			end
		end
		for _ = 1, 24 do
			local x, z = freeSpot(ctx, 4)
			bush(ctx, x, z, rand(ctx, 3, 5), { "6B4430", "8A5A3A", "F3DCC2" })
		end
		for _ = 1, 10 do
			cloud(ctx, rand(ctx, -300, 300), rand(ctx, 70, 110), rand(ctx, -300, 300), rand(ctx, 10, 18), "F3DCC2")
		end
	elseif theme == "ice" then
		for _ = 1, 16 do
			local x, z = ringSpot(ctx, 250, 320)
			hill(ctx, x, z, rand(ctx, 50, 95), pick(ctx, { "FFFFFF", "E6F7FF", "D6F0FF" }), pick(ctx, P))
		end
		for _ = 1, 10 do
			local x, z = ringSpot(ctx, 225, 290)
			iceCone(ctx, x, z, rand(ctx, 32, 48), P)
		end
		for _ = 1, 44 do
			local x, z = freeSpot(ctx, 10)
			local k = ctx.rnd()
			if k < 0.4 then
				iceCone(ctx, x, z, rand(ctx, 11, 16), P)
			elseif k < 0.7 then
				popsicle(ctx, x, z, rand(ctx, 9, 14), pick(ctx, P))
			else
				crystal(ctx, x, z, rand(ctx, 8, 14), "BDE9FF", false)
			end
		end
		for _ = 1, 30 do
			local x, z = freeSpot(ctx, 4)
			hill(ctx, x, z, rand(ctx, 5, 9), "FFFFFF")
		end
		for _ = 1, 10 do
			cloud(ctx, rand(ctx, -300, 300), rand(ctx, 70, 110), rand(ctx, -300, 300), rand(ctx, 10, 18), "FFFFFF")
		end
		add(ctx, "block", { 1, 1, 1 }, { 0, 60, 0 }, "FFFFFF", { t = 1, fx = "snow" })
	else -- galaxy
		for _ = 1, 12 do
			local x, z = ringSpot(ctx, 250, 330)
			planet(ctx, x, rand(ctx, 40, 110), z, rand(ctx, 22, 50), pick(ctx, P), pick(ctx, { "FFF3B8", "7FD6FF", "FF8FB8" }))
		end
		for _ = 1, 14 do
			local x, z = ringSpot(ctx, 230, 300)
			crystal(ctx, x, z, rand(ctx, 28, 45), pick(ctx, P), true)
		end
		for _ = 1, 40 do
			local x, z = freeSpot(ctx, 10)
			if ctx.rnd() < 0.6 then
				crystal(ctx, x, z, rand(ctx, 8, 15), pick(ctx, P), true)
			else
				hill(ctx, x, z, rand(ctx, 6, 11), pick(ctx, { "3F3670", "2E2752", "4B3E86" }))
			end
		end
		for _ = 1, 26 do
			star(ctx, rand(ctx, -320, 320), rand(ctx, 40, 140), rand(ctx, -320, 320), rand(ctx, 4, 9), pick(ctx, { "FFE27A", "FFF3B8", "7FD6FF" }))
		end
		ufo(ctx, -120, 55, 120)
		ufo(ctx, 140, 70, -60)
		add(ctx, "block", { 1, 1, 1 }, { 0, 30, 0 }, "FFFFFF", { t = 1, fx = "stars" })
	end

	-- commun : clôture autour du champ (ouverte devant et derrière), lampadaires, paillettes au sol
	local fc = P[1]
	local fx, z0, z1 = FX + 6, Z0 - 6, Z1 + 6
	fenceRow(ctx, -fx, z0, -fx, z1, 6, fc)
	fenceRow(ctx, fx, z0, fx, z1, 6, fc)
	fenceRow(ctx, -fx, z1, -24, z1, 6, fc)
	fenceRow(ctx, 24, z1, fx, z1, 6, fc)
	fenceRow(ctx, -fx, z0, -24, z0, 6, fc)
	fenceRow(ctx, 24, z0, fx, z0, 6, fc)
	for _, x in { -150, -90, -60, 60, 90, 150 } do
		lamp(ctx, x, -82, P[(math.abs(x) // 30) % #P + 1])
	end
	for _, z in { -40, 10, 60, 110 } do
		lamp(ctx, -fx - 6, z, P[2])
		lamp(ctx, fx + 6, z, P[3])
	end
	-- arches d'entrée du champ (devant et derrière)
	for _, z in { z0, z1 } do
		for _, x in { -22, 22 } do
			pole(ctx, 2.2, 16, x, 0, z, "FFFFFF", { col = true })
			ball(ctx, 3.4, x, 16.8, z, P[2])
		end
		box(ctx, 46, 3, 2.4, 0, 15, z, P[1])
		for i = -3, 3 do
			ball(ctx, 1.6, i * 6, 17.2, z, P[(i + 4) % #P + 1], { m = "Neon" })
		end
	end
	sprinkles(ctx, -FX + 2, FX - 2, Z0 + 2, Z1 - 2, 220, P)
	-- chemin du point d'apparition jusqu'à la place
	local pathC = { meadow = "FFF6E6", choco = "F3DCC2", ice = "FFFFFF", galaxy = "4B3E86" }
	box(ctx, 14, 0.16, 104, 0, 0.13, -22, pathC[theme] or "FFF6E6")
	for i = 0, 12 do
		for _, sx in { -7.5, 7.5 } do
			ball(ctx, 1.4, sx, 0.3, -72 + i * 8.4, P[i % #P + 1])
		end
	end
	disc(ctx, 26, 0.2, 0, 0.14, 30, pathC[theme] or "FFF6E6")
	disc(ctx, 28, 0.15, 0, 0.12, 30, P[1])
	-- bosquets dans le champ
	for _, g in Decor.GROVES do
		local gx, gz = g[1], g[2]
		disc(ctx, Decor.GROVE_R * 2, 0.25, gx, 0.14, gz, if theme == "galaxy" then "3F3670" elseif theme == "choco" then "6B4430" elseif theme == "ice" then "FFFFFF" else "A6E8C4")
		for k = 1, 3 do
			local a = k * 2.1 + gx
			local x, z = gx + math.cos(a) * 5, gz + math.sin(a) * 5
			if theme == "meadow" then
				if k == 1 then lollipop(ctx, x, z, 13, pick(ctx, P), "FFFFFF") else gumdropTree(ctx, x, z, rand(ctx, 10, 14), P) end
			elseif theme == "choco" then
				if k == 1 then cookie(ctx, x, z, 8) else truffleTree(ctx, x, z, rand(ctx, 10, 14)) end
			elseif theme == "ice" then
				if k == 1 then popsicle(ctx, x, z, 11, pick(ctx, P)) else iceCone(ctx, x, z, rand(ctx, 10, 13), P) end
			else
				crystal(ctx, x, z, rand(ctx, 9, 13), pick(ctx, P), true)
			end
		end
		for k = 0, 7 do
			local a = k / 8 * 2 * math.pi
			bush(ctx, gx + math.cos(a) * 11.5, gz + math.sin(a) * 11.5, 2.4, if theme == "galaxy" then { "4B3E86", "2E2752" } elseif theme == "choco" then { "8A5A3A", "F3DCC2" } elseif theme == "ice" then { "FFFFFF", "D6F0FF" } else { "8EDDB4", "FFB3CF" })
		end
	end
	-- étincelles dans l'air au-dessus du champ
	add(ctx, "block", { 1, 1, 1 }, { 0, 8, 35 }, "FFFFFF", { t = 1, fx = "sparkle" })
	return ctx.out
end

-- Petite scène de vitrine d'un monde (vignettes du menu des mondes), centrée sur l'origine
function Decor.diorama(theme: string, palette: { string }): { Spec }
	local state = 12345
	local ctx: Ctx = {
		out = {},
		rnd = function(): number
			state = (state * 16807) % 2147483647
			return state / 2147483647
		end,
	}
	local P = palette
	local groundC = { meadow = "FFB3CF", choco = "CC9E74", ice = "D6F0FF", galaxy = "3F3670" }
	disc(ctx, 60, 2, 0, -1, 0, groundC[theme] or "FFB3CF")
	disc(ctx, 64, 1.6, 0, -1.4, 0, P[1])
	-- tas de bonbons au premier plan
	for i = 1, 4 do
		local x, z = -14 + i * 6 + rand(ctx, -2, 2), -10 + rand(ctx, -3, 3)
		for _ = 1, 3 do
			ball(ctx, rand(ctx, 2.6, 3.6), x + rand(ctx, -1.2, 1.2), 1.2, z + rand(ctx, -1.2, 1.2), pick(ctx, P))
		end
	end
	if theme == "meadow" then
		cupcakeHouse(ctx, -12, 8, 8, P[2], "FFFFFF", 160)
		lollipop(ctx, 6, 10, 13, P[1], "FFFFFF")
		candyCane(ctx, 16, 2, 12, 200, "FF5A6E")
		gumdropTree(ctx, 0, 14, 11, P)
		cottonTree(ctx, -22, -2, 10, "BDE9FF")
		cloud(ctx, 10, 24, 16, 6, "FFFFFF")
	elseif theme == "choco" then
		chocoFountain(ctx, 0, 10)
		truffleTree(ctx, -14, 6, 12)
		truffleTree(ctx, 15, 8, 11)
		chocoBar(ctx, 18, -4, 6, 30)
		cookie(ctx, -20, -4, 6)
	elseif theme == "ice" then
		iceCone(ctx, -10, 8, 14, P)
		iceCone(ctx, 10, 10, 12, P)
		popsicle(ctx, 0, 14, 11, P[2])
		crystal(ctx, 18, 0, 9, "BDE9FF", false)
		hill(ctx, -20, -2, 8, "FFFFFF")
		cloud(ctx, -6, 24, 16, 6, "FFFFFF")
	else
		planet(ctx, 0, 20, 14, 10, P[3], "FFF3B8")
		crystal(ctx, -12, 6, 12, P[1], true)
		crystal(ctx, 13, 8, 11, P[4], true)
		star(ctx, -16, 20, 8, 4, "FFE27A")
		star(ctx, 18, 22, 6, 3, "7FD6FF")
		ufo(ctx, 16, 14, -2)
	end
	return ctx.out
end

return Decor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">PetModels</string>
          <string name="Source"><![CDATA[--!strict
-- Construit les modèles 3D des pets et des œufs à partir de formes simples.
-- Utilisé par le serveur (boss, socles d'œufs) et par les joueurs (pets, vignettes).

local Config = require(script.Parent.Config)

local PetModels = {}

local DARK = Color3.fromHex("3A3358")

type Shape = "ellipsoid" | "ball" | "block" | "cyl" | "wedge"

local function makePart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Shape): BasePart
	local p: BasePart = if shape == "wedge" then Instance.new("WedgePart") else Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "ellipsoid" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif shape == "ball" then
		(p :: Part).Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		(p :: Part).Shape = Enum.PartType.Cylinder
	end
	p.CFrame = cf
	p.Parent = parent
	return p
end

local PetShapes = require(script.Parent.PetShapes)
local HttpService = game:GetService("HttpService")
-- Plans détaillés générés par tools/web (un module JSON par pet). Sans plan, on retombe sur PetShapes.
local PlanFolder = script.Parent:FindFirstChild("PetPlans")

local GOLD_HEX = "F2C14E"
local plans: { [string]: any } = {}
local rigs: { [string]: any } = {}
local metas: { [string]: { factor: number, y0: number } } = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function toHex(c: Color3?): string?
	return if c then c:ToHex() else nil
end

-- Plan (liste de pièces) d'un pet, mis en cache
function PetModels.plan(defId: string): { any }
	local cached = plans[defId]
	if cached then
		return cached
	end
	local def = Config.Pets[defId] or Config.Pets.gumdrop_bunny
	local mod = PlanFolder and PlanFolder:FindFirstChild(def.id)
	if mod and mod:IsA("ModuleScript") then
		local data = HttpService:JSONDecode((require :: any)(mod))
		local clips = {}
		for state, list in data.anims do
			local out = {}
			for _, t in list do
				table.insert(out, { bone = t.bone, axis = t.axis, amp = t.amp, freq = t.freq, phase = t.phase, base = t.base })
			end
			clips[state] = out
		end
		plans[defId] = data.parts
		rigs[defId] = { bones = data.bones, clips = clips }
		if data.factor and data.y0 then
			metas[defId] = { factor = data.factor, y0 = data.y0 }
		end
		return data.parts
	end
	local colors = {
		body = def.body:ToHex(),
		belly = def.belly:ToHex(),
		dark = toHex(def.dark) or def.body:Lerp(Color3.new(0, 0, 0), 0.3):ToHex(),
		accent = toHex(def.accent) or GOLD_HEX,
		glow = toHex(def.glow),
	}
	local parts, bones = PetShapes.build(def.species, colors)
	plans[defId] = parts
	rigs[defId] = { bones = bones, clips = PetShapes.bindAnims(def.species, bones) }
	return parts
end

-- Os et animations d'un pet (nil si le pet n'est pas animé)
function PetModels.rig(defId: string): any
	PetModels.plan(defId)
	return rigs[defId]
end

local MATERIAL = {
	plastic = Enum.Material.SmoothPlastic,
	neon = Enum.Material.Neon,
	metal = Enum.Material.SmoothPlastic,
	glass = Enum.Material.Glass,
}

-- Les plus grandes pièces d'un plan (vignettes : on garde les maxParts plus grosses)
local thumbs: { [string]: { any } } = {}
local function biggest(defId: string, maxParts: number): { any }
	local key = defId .. ":" .. maxParts
	if thumbs[key] then
		return thumbs[key]
	end
	local list = table.clone(PetModels.plan(defId))
	if #list > maxParts then
		local function vol(sp: any): number
			return sp.size[1] * sp.size[2] * sp.size[3]
		end
		table.sort(list, function(a, b)
			return vol(a) > vol(b)
		end)
		local cut = table.create(maxParts)
		table.move(list, 1, maxParts, 1, cut)
		list = cut
	end
	thumbs[key] = list
	return list
end

-- build(defId, tier, shiny, scale, locked, maxParts, useMesh) -> Model centré sur l'origine, face vers -Z.
-- useMesh : utilise le modèle Blender importé s'il existe (pets dans le monde).
-- tier : 0 normal, 1 doré, 2 arc-en-ciel. locked : silhouette sombre (index).
-- maxParts : limite le nombre de pièces (vignettes de l'interface).
-- Les pièces marquées « Spin » (attribut Spin = "Y" ou "Z") tournent autour du pet ;
-- leur position de départ par rapport au pet est gardée dans l'attribut Offset.
-- étincelles (shiny), lumière et particules des Mythiques et Divins
local function addEffects(model: Model, def: any, anchorPart: BasePart, shiny: boolean, locked: boolean?, s: number)
	if shiny and not locked then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromHex("FFF6C8")
		sp.Parent = anchorPart
	end
	if def.rarity >= Config.MYTHIC and not locked then
		local glow = def.glow or Config.Rarities[def.rarity].color
		local light = Instance.new("PointLight")
		light.Color = glow
		light.Brightness = if def.rarity >= Config.DIVINE then 3 else 1.5
		light.Range = 8 * s
		light.Parent = anchorPart
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(glow, Color3.new(1, 1, 1))
		pe.LightEmission = 1
		pe.Rate = if def.rarity >= Config.DIVINE then 14 else 5
		pe.Lifetime = NumberRange.new(0.8, 1.6)
		pe.Speed = NumberRange.new(0.5, 1.5)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 * s), NumberSequenceKeypoint.new(1, 0) })
		pe.Transparency = NumberSequence.new(0.2, 1)
		pe.Parent = anchorPart
		model:SetAttribute("Aura", def.rarity)
	end
end

-- Modèle Blender importé (ReplicatedStorage › PetMeshes › pet_<id>) : maillages avec os.
-- Les os RefO, RefX, RefY donnent l'échelle et l'orientation de l'import ; on replace le
-- modèle exactement comme la version en pièces. Renvoie nil si le modèle manque.
function PetModels.meshTemplate(defId: string): Model?
	local folder = ReplicatedStorage:FindFirstChild("PetMeshes")
	local tpl = folder and folder:FindFirstChild("pet_" .. defId)
	return if tpl and tpl:IsA("Model") then tpl else nil
end

local function buildMesh(defId: string, tier: number, shiny: boolean, s: number): Model?
	local def = Config.Pets[defId] or Config.Pets.gumdrop_bunny
	PetModels.plan(defId)
	local tpl = PetModels.meshTemplate(defId)
	local meta = metas[defId]
	if not tpl or not meta then
		return nil
	end
	local m = tpl:Clone()
	local bones: { [string]: Bone } = {}
	for _, d in m:GetDescendants() do
		if d:IsA("Bone") then
			bones[d.Name] = d
		end
	end
	local refO, refX, refY = bones.RefO, bones.RefX, bones.RefY
	if not (refO and refX and refY) then
		m:Destroy()
		return nil
	end
	local first: BasePart? = nil
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			local name = string.lower(d.Name)
			local kind, hex = string.match(name, "^(%a+)_(%x%x%x%x%x%x)")
			if kind == "neon" and hex then
				d.Material = Enum.Material.Neon
				d.Color = Color3.fromHex(hex)
			elseif kind == "glass" and hex then
				d.Material = Enum.Material.Glass
				d.Transparency = 0.4
				d.Color = Color3.fromHex(hex)
			elseif string.sub(name, 1, 4) == "gold" then
				d.Reflectance = 0.3
			elseif not first then
				first = d
			end
		end
	end
	local k = (refX.WorldPosition - refO.WorldPosition).Magnitude / 10
	if k < 1e-5 then
		m:Destroy()
		return nil
	end
	m:ScaleTo(m:GetScale() * s * meta.factor / k)
	local o = refO.WorldPosition
	local ex = (refX.WorldPosition - o).Unit
	local ey = (refY.WorldPosition - o).Unit
	local ez = ex:Cross(ey).Unit
	ey = ez:Cross(ex).Unit
	local current = CFrame.fromMatrix(o, ex, ey, ez)
	local target = CFrame.new(0, (-meta.y0 * meta.factor - 1.1) * s, 0)
	m:PivotTo(target * current:Inverse() * m:GetPivot())
	local root = makePart(m, "Root", Vector3.one * 0.2, CFrame.identity, def.body, "block")
	root.Transparency = 1
	m.PrimaryPart = root
	m.Name = def.name
	m:SetAttribute("Def", defId)
	m:SetAttribute("Scale", s)
	m:SetAttribute("Mesh", true)
	if tier == 1 or tier == 2 then
		-- doré / arc-en-ciel : halo de couleur (le maillage garde sa texture)
		local l = Instance.new("PointLight")
		l.Color = if tier == 1 then Color3.fromHex("FFD23F") else Color3.fromHex("FF9AE6")
		l.Brightness = 2
		l.Range = 7 * s
		l.Parent = first or root
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = l.Color
		sp.Parent = first or root
	end
	addEffects(m, def, first or root, shiny, false, s)
	return m
end

function PetModels.build(defId: string, tier: number, shiny: boolean, scale: number, locked: boolean?, maxParts: number?, useMesh: boolean?): Model
	local def = Config.Pets[defId] or Config.Pets.gumdrop_bunny
	local s = scale
	if useMesh and not locked and not maxParts then
		local m = buildMesh(defId, tier, shiny, s)
		if m then
			return m
		end
	end
	local model = Instance.new("Model")
	model.Name = def.name
	local root = makePart(model, "Root", Vector3.one * 0.2, CFrame.identity, def.body, "block")
	root.Transparency = 1
	model.PrimaryPart = root

	local gold = Color3.fromHex("FFD23F")
	local firstBody: BasePart? = nil
	local list: { any } = if maxParts then biggest(defId, maxParts) else PetModels.plan(defId)
	for _, sp in list do
		local color = Color3.fromHex(sp.color)
		local isBody = sp.name == "Body"
		if locked then
			color = DARK
		elseif tier == 1 and isBody then
			color = color:Lerp(gold, 0.65)
		elseif tier == 2 and isBody then
			color = color:Lerp(Color3.fromHex("FF9AE6"), 0.5)
		end
		local r = sp.rot
		local cf = CFrame.new(sp.pos[1] * s, sp.pos[2] * s, sp.pos[3] * s, r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9])
		local shape: Shape = if sp.shape == "cyl" then "cyl" elseif sp.shape == "ball" then "ball" elseif sp.shape == "ellipsoid" then "ellipsoid" elseif sp.shape == "wedge" then "wedge" else "block"
		local size = Vector3.new(sp.size[1], sp.size[2], sp.size[3]) * s
		local p = makePart(model, if isBody then "Body" else "Part", size, cf, color, shape)
		if not locked then
			p.Material = MATERIAL[sp.mat] or Enum.Material.SmoothPlastic
			if sp.mat == "metal" then
				p.Reflectance = 0.2
			end
		end
		p.Transparency = sp.alpha or 0
		if sp.bone and sp.bone > 0 then
			p:SetAttribute("Bone", sp.bone)
		end
		if sp.tag == "SpinY" or sp.tag == "SpinZ" then
			p:SetAttribute("Spin", if sp.tag == "SpinY" then "Y" else "Z")
			if sp.pivot then
				p:SetAttribute("Center", Vector3.new(sp.pivot[1], sp.pivot[2], sp.pivot[3]) * s)
			end
		end
		if tier == 1 and isBody and not locked then
			p.Reflectance = 0.15
		end
		if isBody and not firstBody then
			firstBody = p
		end
	end

	if tier == 2 and not locked then
		model:SetAttribute("Rainbow", true)
	end
	model:SetAttribute("Def", defId)
	model:SetAttribute("Scale", s)
	addEffects(model, def, firstBody or root, shiny, locked, s)
	return model
end

-- Prépare l'animation d'un modèle construit par build() (pose de repos à l'origine).
-- Renvoie nil si le pet n'a ni os ni pièces qui tournent.
local function clipsByBone(rig: any): any
	local byBone = {}
	for state, list in rig.clips or {} do
		local m = {}
		for _, tr in list do
			m[tr.bone] = m[tr.bone] or {}
			table.insert(m[tr.bone], tr)
		end
		byBone[state] = m
	end
	return byBone
end

local function spinOf(b: any): any
	if b.spin then
		return { axis = Vector3.new(b.spin.axis[1], b.spin.axis[2], b.spin.axis[3]).Unit, speed = b.spin.speed * math.pi }
	end
	return nil
end

function PetModels.animator(model: Model): any
	local defId = model:GetAttribute("Def") :: string
	local s = (model:GetAttribute("Scale") :: number?) or 1
	local rig = PetModels.rig(defId)
	if model:GetAttribute("Mesh") then
		-- modèle Blender : on tourne directement les os (Bone.Transform)
		local found: { [string]: Bone } = {}
		for _, d in model:GetDescendants() do
			if d:IsA("Bone") then
				found[d.Name] = d
			end
		end
		local rootCf = (model.PrimaryPart :: BasePart).CFrame
		local list = {}
		for i, b in rig.bones do
			local inst = found[b.name]
			list[i] = { inst = inst, rest = if inst then rootCf:ToObjectSpace(inst.WorldCFrame).Rotation else CFrame.identity, cur = CFrame.identity, spin = spinOf(b) }
		end
		return { mesh = true, model = model, bones = list, clips = clipsByBone(rig) }
	end
	local recs = {}
	local animated = false
	for _, b in rig.bones do
		if b.spin then
			animated = true
		end
	end
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			local bone = (p:GetAttribute("Bone") :: number?) or 0
			local spin = p:GetAttribute("Spin") :: string?
			if bone > 0 or spin then
				animated = true
			end
			table.insert(recs, { part = p, offset = p.CFrame, bone = bone, spin = spin, center = (p:GetAttribute("Center") :: Vector3?) or Vector3.zero })
		end
	end
	if not animated then
		return nil
	end
	local bones = {}
	for i, b in rig.bones do
		local spin = nil
		if b.spin then
			spin = { axis = Vector3.new(b.spin.axis[1], b.spin.axis[2], b.spin.axis[3]).Unit, speed = b.spin.speed * math.pi }
		end
		bones[i] = { parent = b.parent, pivot = Vector3.new(b.pivot[1], b.pivot[2], b.pivot[3]) * s, cur = CFrame.identity, spin = spin }
	end
	local parts = table.create(#recs)
	for i, r in recs do
		parts[i] = r.part
	end
	-- pistes rangées par état puis par os (évite de parcourir toutes les pistes pour chaque os)
	return { recs = recs, parts = parts, cfs = table.create(#recs), bones = bones, clips = clipsByBone(rig), G = {} }
end

-- Pose le modèle à « pivot » pour l'état idle / move / ability à l'instant t.
-- Les os passent en douceur d'un état à l'autre (dt = temps écoulé).
local function boneTarget(tracks: any, i: number, t: number): CFrame
	local target = CFrame.identity
	local mine = tracks and tracks[i]
	if mine then
		for _, tr in mine do
			local ang = math.rad(tr.base + tr.amp * math.sin(2 * math.pi * tr.freq * t + tr.phase))
			target *= CFrame.fromAxisAngle(Vector3.new(tr.axis[1], tr.axis[2], tr.axis[3]), ang)
		end
	end
	return target
end

function PetModels.pose(anim: any, pivot: CFrame, state: string, t: number, dt: number)
	if anim.mesh then
		local tracks = anim.clips and anim.clips[state]
		local k = 1 - math.exp(-10 * dt)
		for i, b in anim.bones do
			if b.spin then
				b.cur = CFrame.fromAxisAngle(b.spin.axis, b.spin.speed * t)
			else
				b.cur = b.cur:Lerp(boneTarget(tracks, i, t), k)
			end
			if b.inst then
				b.inst.Transform = b.rest:Inverse() * b.cur * b.rest
			end
		end
		anim.model:PivotTo(pivot)
		return
	end
	local G = anim.G
	G[0] = CFrame.identity
	local tracks = anim.clips and anim.clips[state]
	local k = 1 - math.exp(-10 * dt)
	for i, b in anim.bones do
		local target = CFrame.identity
		local mine = tracks and tracks[i]
		if mine then
			for _, tr in mine do
				local ang = math.rad(tr.base + tr.amp * math.sin(2 * math.pi * tr.freq * t + tr.phase))
				target *= CFrame.fromAxisAngle(Vector3.new(tr.axis[1], tr.axis[2], tr.axis[3]), ang)
			end
		end
		if b.spin then
			b.cur = CFrame.fromAxisAngle(b.spin.axis, b.spin.speed * t) -- rotation continue (auréoles, engrenages)
		else
			b.cur = b.cur:Lerp(target, k)
		end
		G[i] = G[b.parent] * CFrame.new(b.pivot) * b.cur * CFrame.new(-b.pivot)
	end
	local cfs = anim.cfs
	for i, r in anim.recs do
		local m = pivot * G[r.bone]
		if r.spin == "Y" then
			m = m * CFrame.new(r.center) * CFrame.Angles(0, t * 0.9, 0) * CFrame.new(-r.center)
		elseif r.spin == "Z" then
			m = m * CFrame.new(r.center) * CFrame.Angles(0, 0, t * 0.6) * CFrame.new(-r.center)
		end
		cfs[i] = m * r.offset
	end
	workspace:BulkMoveTo(anim.parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Œuf décoratif (socles et animation d'éclosion)
function PetModels.egg(eggId: string, scale: number): Model
	local e = Config.Eggs[eggId]
	local model = Instance.new("Model")
	model.Name = e.name
	local root = makePart(model, "Root", Vector3.one * 0.2, CFrame.identity, e.shell, "block")
	root.Transparency = 1
	model.PrimaryPart = root
	makePart(model, "Shell", Vector3.new(3, 3.8, 3) * scale, CFrame.identity, e.shell, "ellipsoid")
	local spots = { Vector3.new(-0.9, 0.5, -1.15), Vector3.new(0.8, -0.6, -1.2), Vector3.new(0.3, 1.2, -1.05), Vector3.new(1.3, 0.6, 0.3), Vector3.new(-1.2, -0.4, 0.6) }
	for i, pos in spots do
		local d = (i == 2) and 0.85 or 0.6
		makePart(model, "Spot", Vector3.new(d, d, 0.3) * scale, CFrame.lookAt(pos * scale, pos * scale * 2), e.spot, "ellipsoid")
	end
	return model
end

-- Puissance d'un pet possédé (même formule côté serveur et côté joueur)
function PetModels.power(p: { def: string, tier: number, shiny: boolean?, lvl: number, bonus: number? }): number
	local def = Config.Pets[p.def]
	if not def then
		return 0
	end
	local base = def.power
	if p.bonus and p.bonus > 0 then
		base = p.bonus
	end
	local m = Config.tierMult(p.tier)
	if p.shiny then
		m *= 1.5
	end
	return base * m * (1 + 0.05 * p.lvl)
end

return PetModels
