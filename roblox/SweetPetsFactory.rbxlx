---------------------------------------------------------------------------
-- Formules
---------------------------------------------------------------------------
Config.PILE_HP = { 15, 80, 600 } -- petit, moyen, coffre
Config.BASE_SLOTS = 4
Config.BASE_STORAGE = 60
Config.BOSS_INTERVAL = 600
Config.BOSS_WINDOW = 120
Config.BOSS_FIGHT = 90

function Config.rebirthCost(r: number): number
	return 250e3 * 12 ^ r
end

function Config.rebirthMult(r: number): number
	return 1 + 0.5 * r
end

function Config.tierMult(tier: number): number
	if tier == 1 then
		return 3
	elseif tier == 2 then
		return 10
	end
	return 1
end

Config.TierNames = { [0] = "", [1] = "Doré", [2] = "Arc-en-ciel" }

local suffixes = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234567 -> "1.23M"
function Config.fmt(n: number): string
	if n ~= n then
		return "0"
	end
	if n < 0 then
		return "-" .. Config.fmt(-n)
	end
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local i = 0
	while n >= 1000 and i < #suffixes do
		n /= 1000
		i += 1
	end
	local s
	if n < 10 then
		s = string.format("%.2f", math.floor(n * 100) / 100)
	elseif n < 100 then
		s = string.format("%.1f", math.floor(n * 10) / 10)
	else
		s = string.format("%d", math.floor(n))
	end
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s .. suffixes[i]
end

function Config.fmtTime(sec: number): string
	sec = math.max(0, math.floor(sec))
	if sec >= 3600 then
		return string.format("%dh %02dm", sec // 3600, (sec % 3600) // 60)
	end
	return string.format("%02d:%02d", sec // 60, sec % 60)
end

function Config.fmtChance(c: number): string
	if c >= 10 then
		return string.format("%d %%", math.floor(c + 0.5))
	elseif c >= 1 then
		return string.format("%.1f %%", c)
	elseif c >= 0.1 then
		return string.format("%.2f %%", c)
	end
	return string.format("%.3f %%", c)
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">PetModels</string>
          <string name="Source"><![CDATA[--!strict
-- Construit les modèles 3D des pets et des œufs à partir de formes simples.
-- Utilisé par le serveur (boss, socles d'œufs) et par les joueurs (pets, vignettes).

local Config = require(script.Parent.Config)

local PetModels = {}

local DARK = Color3.fromHex("3A3358")

type Shape = "ellipsoid" | "ball" | "block" | "cyl"

local function makePart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Shape): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "ellipsoid" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.CFrame = cf
	p.Parent = parent
	return p
end

local PetShapes = require(script.Parent.PetShapes)

local GOLD_HEX = "F2C14E"
local plans: { [string]: any } = {}

local function toHex(c: Color3?): string?
	return if c then c:ToHex() else nil
end

-- Plan (liste de pièces) d'un pet, mis en cache
function PetModels.plan(defId: string): { any }
	local cached = plans[defId]
	if cached then
		return cached
	end
	local def = Config.Pets[defId] or Config.Pets.gumdrop_bunny
	local colors = {
		body = def.body:ToHex(),
		belly = def.belly:ToHex(),
		dark = toHex(def.dark) or def.body:Lerp(Color3.new(0, 0, 0), 0.3):ToHex(),
		accent = toHex(def.accent) or GOLD_HEX,
		glow = toHex(def.glow),
	}
	local parts = PetShapes.build(def.species, colors)
	plans[defId] = parts
	return parts
end

local MATERIAL = {
	plastic = Enum.Material.SmoothPlastic,
	neon = Enum.Material.Neon,
	metal = Enum.Material.SmoothPlastic,
	glass = Enum.Material.Glass,
}

-- build(defId, tier, shiny, scale, locked) -> Model centré sur l'origine, face vers -Z.
-- tier : 0 normal, 1 doré, 2 arc-en-ciel. locked : silhouette sombre (index).
-- Les pièces marquées « Spin » (attribut Spin = "Y" ou "Z") tournent autour du pet ;
-- leur position de départ par rapport au pet est gardée dans l'attribut Offset.
function PetModels.build(defId: string, tier: number, shiny: boolean, scale: number, locked: boolean?): Model
	local def = Config.Pets[defId] or Config.Pets.gumdrop_bunny
	local s = scale
	local model = Instance.new("Model")
	model.Name = def.name
	local root = makePart(model, "Root", Vector3.one * 0.2, CFrame.identity, def.body, "block")
	root.Transparency = 1
	model.PrimaryPart = root

	local gold = Color3.fromHex("FFD23F")
	local firstBody: BasePart? = nil
	for _, sp in PetModels.plan(defId) do
		local color = Color3.fromHex(sp.color)
		local isBody = sp.name == "Body"
		if locked then
			color = DARK
		elseif tier == 1 and isBody then
			color = color:Lerp(gold, 0.65)
		elseif tier == 2 and isBody then
			color = color:Lerp(Color3.fromHex("FF9AE6"), 0.5)
		end
		local r = sp.rot
		local cf = CFrame.new(sp.pos[1] * s, sp.pos[2] * s, sp.pos[3] * s, r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9])
		local shape: Shape = if sp.shape == "cyl" then "cyl" elseif sp.shape == "ball" then "ball" elseif sp.shape == "ellipsoid" then "ellipsoid" else "block"
		local size = Vector3.new(sp.size[1], sp.size[2], sp.size[3]) * s
		local p = makePart(model, if isBody then "Body" else "Part", size, cf, color, shape)
		if not locked then
			p.Material = MATERIAL[sp.mat] or Enum.Material.SmoothPlastic
			if sp.mat == "metal" then
				p.Reflectance = 0.2
			end
		end
		p.Transparency = sp.alpha
		if sp.tag == "SpinY" or sp.tag == "SpinZ" then
			p:SetAttribute("Spin", if sp.tag == "SpinY" then "Y" else "Z")
			p:SetAttribute("Offset", cf)
			if sp.pivot then
				p:SetAttribute("Center", Vector3.new(sp.pivot[1], sp.pivot[2], sp.pivot[3]) * s)
			end
		end
		if tier == 1 and isBody and not locked then
			p.Reflectance = 0.15
		end
		if isBody and not firstBody then
			firstBody = p
		end
	end

	if tier == 2 and not locked then
		model:SetAttribute("Rainbow", true)
	end
	local anchorPart = firstBody or root
	if shiny and not locked then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromHex("FFF6C8")
		sp.Parent = anchorPart
	end
	-- aura des créatures mythiques et divines
	if def.rarity >= Config.MYTHIC and not locked then
		local glow = def.glow or Config.Rarities[def.rarity].color
		local light = Instance.new("PointLight")
		light.Color = glow
		light.Brightness = if def.rarity >= Config.DIVINE then 3 else 1.5
		light.Range = 8 * s
		light.Parent = anchorPart
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(glow, Color3.new(1, 1, 1))
		pe.LightEmission = 1
		pe.Rate = if def.rarity >= Config.DIVINE then 14 else 5
		pe.Lifetime = NumberRange.new(0.8, 1.6)
		pe.Speed = NumberRange.new(0.5, 1.5)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 * s), NumberSequenceKeypoint.new(1, 0) })
		pe.Transparency = NumberSequence.new(0.2, 1)
		pe.Parent = anchorPart
		model:SetAttribute("Aura", def.rarity)
	end
	return model
end

-- Fait tourner les pièces « Spin » autour du pet (appelé chaque image côté joueur)
function PetModels.animate(model: Model, pivot: CFrame, t: number)
	for _, p in model:GetChildren() do
		local axis = p:GetAttribute("Spin")
		if axis and p:IsA("BasePart") then
			local off = p:GetAttribute("Offset") :: CFrame
			if axis == "Z" then
				local c = (p:GetAttribute("Center") :: Vector3?) or Vector3.zero
				p.CFrame = pivot * CFrame.new(c) * CFrame.Angles(0, 0, t * 0.6) * CFrame.new(-c) * off
			else
				p.CFrame = pivot * CFrame.Angles(0, t * 0.9, 0) * off
			end
		end
	end
end

-- Œuf décoratif (socles et animation d'éclosion)
function PetModels.egg(eggId: string, scale: number): Model
	local e = Config.Eggs[eggId]
	local model = Instance.new("Model")
	model.Name = e.name
	local root = makePart(model, "Root", Vector3.one * 0.2, CFrame.identity, e.shell, "block")
	root.Transparency = 1
	model.PrimaryPart = root
	makePart(model, "Shell", Vector3.new(3, 3.8, 3) * scale, CFrame.identity, e.shell, "ellipsoid")
	local spots = { Vector3.new(-0.9, 0.5, -1.15), Vector3.new(0.8, -0.6, -1.2), Vector3.new(0.3, 1.2, -1.05), Vector3.new(1.3, 0.6, 0.3), Vector3.new(-1.2, -0.4, 0.6) }
	for i, pos in spots do
		local d = (i == 2) and 0.85 or 0.6
		makePart(model, "Spot", Vector3.new(d, d, 0.3) * scale, CFrame.lookAt(pos * scale, pos * scale * 2), e.spot, "ellipsoid")
	end
	return model
end

-- Puissance d'un pet possédé (même formule côté serveur et côté joueur)
function PetModels.power(p: { def: string, tier: number, shiny: boolean?, lvl: number, bonus: number? }): number
	local def = Config.Pets[p.def]
	if not def then
		return 0
	end
	local base = def.power
	if p.bonus and p.bonus > 0 then
		base = p.bonus
	end
	local m = Config.tierMult(p.tier)
	if p.shiny then
		m *= 1.5
	end
	return base * m * (1 + 0.05 * p.lvl)
end

return PetModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">PetShapes</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Plans 3D des pets, en Luau pur (aucune API Roblox) : chaque espèce est
-- décrite comme une liste de pièces (bloc, boule, ellipsoïde, cylindre) avec
-- position et rotation. PetModels transforme ces plans en vraies pièces Roblox ;
-- le même code sert à exporter les modèles et à générer des aperçus.
--
-- Repère : X à droite, Y en haut, le pet regarde vers -Z. Le sol est à y = -1.1.

local Shapes = {}

---------------------------------------------------------------------------
-- Maths (matrices 3x3 en ligne)
---------------------------------------------------------------------------
local I = { 1, 0, 0, 0, 1, 0, 0, 0, 1 }

local function mul(a, b)
	local r = table.create(9, 0)
	for i = 0, 2 do
		for j = 0, 2 do
			local s = 0
			for k = 0, 2 do
				s += a[i * 3 + k + 1] * b[k * 3 + j + 1]
			end
			r[i * 3 + j + 1] = s
		end
	end
	return r
end

local function mv(m, v)
	return {
		m[1] * v[1] + m[2] * v[2] + m[3] * v[3],
		m[4] * v[1] + m[5] * v[2] + m[6] * v[3],
		m[7] * v[1] + m[8] * v[2] + m[9] * v[3],
	}
end

local function add(a, b)
	return { a[1] + b[1], a[2] + b[2], a[3] + b[3] }
end

local function sub(a, b)
	return { a[1] - b[1], a[2] - b[2], a[3] - b[3] }
end

local function scale(a, s)
	return { a[1] * s, a[2] * s, a[3] * s }
end

local function len(a)
	return math.sqrt(a[1] * a[1] + a[2] * a[2] + a[3] * a[3])
end

local function norm(a)
	local l = len(a)
	if l < 1e-9 then
		return { 0, 1, 0 }
	end
	return { a[1] / l, a[2] / l, a[3] / l }
end

local function cross(a, b)
	return { a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1] }
end

-- Rotation d'Euler en degrés, même convention que CFrame.Angles (Rx * Ry * Rz)
local function euler(x, y, z)
	local cx, sx = math.cos(math.rad(x)), math.sin(math.rad(x))
	local cy, sy = math.cos(math.rad(y)), math.sin(math.rad(y))
	local cz, sz = math.cos(math.rad(z)), math.sin(math.rad(z))
	local rx = { 1, 0, 0, 0, cx, -sx, 0, sx, cx }
	local ry = { cy, 0, sy, 0, 1, 0, -sy, 0, cy }
	local rz = { cz, -sz, 0, sz, cz, 0, 0, 0, 1 }
	return mul(mul(rx, ry), rz)
end

local function toMat(rot)
	if rot == nil then
		return I
	elseif #rot == 9 then
		return rot
	end
	return euler(rot[1], rot[2], rot[3])
end

-- Matrice dont l'axe Y local pointe vers dir (pour poser un segment)
local function alongY(dir)
	local y = norm(dir)
	local ref = if math.abs(y[2]) < 0.95 then { 0, 1, 0 } else { 0, 0, 1 }
	local x = norm(cross(ref, y))
	local z = cross(x, y)
	return { x[1], y[1], z[1], x[2], y[2], z[2], x[3], y[3], z[3] }
end

Shapes.euler = euler
Shapes.mul = mul

---------------------------------------------------------------------------
-- Constructeur
---------------------------------------------------------------------------
local B = {}
B.__index = B

function Shapes.builder()
	return setmetatable({ parts = {}, stack = {}, p = { 0, 0, 0 }, r = I }, B)
end

-- Ouvre un sous-repère (position, rotation) ; pop() pour revenir.
function B:push(pos, rot)
	table.insert(self.stack, { self.p, self.r })
	self.p = add(self.p, mv(self.r, pos))
	self.r = mul(self.r, toMat(rot))
end

function B:pop()
	local f = table.remove(self.stack)
	self.p, self.r = f[1], f[2]
end

-- opt : { mat = "plastic"|"neon"|"metal"|"glass", alpha = 0..1, tag = "SpinY"|"SpinZ"|..., name = string }
function B:add(shape, size, pos, rot, color, opt)
	opt = opt or {}
	table.insert(self.parts, {
		shape = shape,
		size = { size[1], size[2], size[3] },
		pos = add(self.p, mv(self.r, pos)),
		rot = mul(self.r, toMat(rot)),
		color = color,
		mat = opt.mat or "plastic",
		alpha = opt.alpha or 0,
		tag = opt.tag,
		pivot = opt.pivot, -- centre de rotation des pièces SpinZ
		name = opt.name or shape,
	})
end

function B:box(size, pos, color, rot, opt)
	self:add("block", size, pos, rot, color, opt)
end

function B:ell(size, pos, color, rot, opt)
	self:add("ellipsoid", size, pos, rot, color, opt)
end

function B:ball(d, pos, color, opt)
	self:add("ball", { d, d, d }, pos, nil, color, opt)
end

-- Cylindre le long de l'axe Y local (comme un poteau)
function B:pole(length, d, pos, color, rot, opt)
	self:push(pos, rot)
	self:add("cyl", { length, d, d }, { 0, 0, 0 }, { 0, 0, 90 }, color, opt)
	self:pop()
end

-- Disque plat horizontal (anneau plein, bague)
function B:disc(d, thick, pos, color, rot, opt)
	self:pole(thick, d, pos, color, rot, opt)
end

-- Segment (bloc ou cylindre) entre deux points
function B:seg(a, b, d, color, shape, opt)
	local dir = sub(b, a)
	local l = len(dir)
	if l < 1e-4 then
		return
	end
	local mid = scale(add(a, b), 0.5)
	local m = alongY(dir)
	if shape == "cyl" then
		self:add("cyl", { l, d, d }, mid, mul(m, euler(0, 0, 90)), color, opt)
	elseif shape == "ell" then
		self:add("ellipsoid", { d, l * 1.25, d }, mid, m, color, opt)
	else
		self:add("block", { d, l, d }, mid, m, color, opt)
	end
end

-- Chaîne de segments passant par des points, avec un diamètre par point.
-- Renvoie la liste des points et des directions (pour ajouter piques et bagues).
function B:chain(points, diam, color, shape, opt)
	for i = 1, #points - 1 do
		local d = (diam[i] + diam[i + 1]) / 2
		self:seg(points[i], points[i + 1], d, color, shape, opt)
		if shape ~= "ell" and i > 1 then
			-- articulation arrondie pour éviter les trous
			self:ball(diam[i] * 1.02, points[i], color, opt)
		end
	end
end

-- Pique low-poly : deux losanges croisés, pointe vers +Y local
function B:spike(pos, s, color, rot, opt)
	self:push(pos, rot)
	self:box({ s, s, s * 0.45 }, { 0, 0, 0 }, color, { 0, 0, 45 }, opt)
	self:box({ s * 0.45, s, s }, { 0, 0, 0 }, color, { 45, 0, 0 }, opt)
	self:box({ s * 0.5, s * 0.5, s * 0.25 }, { 0, s * 0.62, 0 }, color, { 0, 0, 45 }, opt)
	self:pop()
end

-- Anneau de blocs dans le plan XZ local (le tourner pour un anneau vertical)
function B:ring(center, rot, radius, n, seg, color, opt)
	self:push(center, rot)
	local w = 2 * math.pi * radius / n * 1.08
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		self:box({ seg[1] or w, seg[2], seg[3] }, { math.cos(a) * radius, 0, math.sin(a) * radius }, color, { 0, -math.deg(a) + 90, 0 }, opt)
	end
	self:pop()
end

-- Engrenage plat (dans le plan XZ local)
function B:gear(center, rot, radius, teeth, color, opt)
	self:push(center, rot)
	self:disc(radius * 2, radius * 0.35, { 0, 0, 0 }, color, nil, opt)
	self:disc(radius * 0.8, radius * 0.45, { 0, 0, 0 }, color, nil, opt)
	for i = 0, teeth - 1 do
		local a = i / teeth * math.pi * 2
		self:box({ radius * 0.4, radius * 0.33, radius * 0.4 }, { math.cos(a) * radius * 1.08, 0, math.sin(a) * radius * 1.08 }, color, { 0, -math.deg(a), 0 }, opt)
	end
	self:pop()
end

---------------------------------------------------------------------------
-- Éléments communs
---------------------------------------------------------------------------
local BLACK = "2B1B3A"
local WHITE = "FFFFFF"
local CHEEK = "FF8FB0"
local INNER = "FFB3CF"
local GOLD = "F2C14E"
local GOLD_DARK = "C9932E"

-- Visage mignon : yeux, reflets, joues, bouche. z = surface avant.
local function cuteFace(b, y, z, w, c)
	for _, s in { -1, 1 } do
		if c.glow then
			b:ell({ 0.3, 0.3, 0.12 }, { w * s, y, z }, c.glow, nil, { mat = "neon" })
		else
			b:ell({ 0.26, 0.34, 0.14 }, { w * s, y, z }, BLACK)
			b:ell({ 0.09, 0.11, 0.05 }, { w * s - 0.05, y + 0.08, z - 0.06 }, WHITE)
		end
		b:ell({ 0.3, 0.16, 0.06 }, { (w + 0.27) * s, y - 0.2, z + 0.08 }, CHEEK, nil, { alpha = 0.15 })
	end
	b:ell({ 0.22, 0.07, 0.06 }, { 0, y - 0.22, z - 0.01 }, BLACK)
end

-- Yeux féroces lumineux (créatures mythiques)
local function fierceEyes(b, y, z, w, color, tilt)
	for _, s in { -1, 1 } do
		b:box({ 0.26, 0.11, 0.06 }, { w * s, y, z }, color, { 0, 0, (tilt or 15) * s }, { mat = "neon" })
		b:box({ 0.3, 0.05, 0.07 }, { w * s, y + 0.1, z - 0.01 }, BLACK, { 0, 0, (tilt or 15) * s + 8 * s })
	end
end

-- Tête et corps « chibi » partagés par les pets normaux
local function chibi(b, c, headSize)
	local hs = headSize or { 1.75, 1.5, 1.55 }
	b:ell({ 1.25, 1.0, 1.15 }, { 0, -0.6, 0.15 }, c.body, nil, { name = "Body" })
	b:ell({ 0.8, 0.6, 0.45 }, { 0, -0.62, -0.33 }, c.belly)
	b:ell(hs, { 0, 0.35, 0 }, c.body, nil, { name = "Body" })
	for _, s in { -1, 1 } do
		b:ell({ 0.48, 0.28, 0.72 }, { 0.38 * s, -1.0, -0.22 }, c.body, nil, { name = "Body" })
		b:ell({ 0.3, 0.12, 0.2 }, { 0.38 * s, -1.0, -0.56 }, c.belly)
	end
end

local function pointEars(b, c, x, y, s0)
	for _, s in { -1, 1 } do
		b:push({ x * s, y, 0.02 }, { 0, 0, -14 * s })
		b:box({ s0, s0, 0.3 }, { 0, 0, 0 }, c.body, { 0, 0, 45 }, { name = "Body" })
		b:box({ s0 * 0.55, s0 * 0.55, 0.1 }, { 0, -0.02, -0.15 }, c.inner or INNER, { 0, 0, 45 })
		b:pop()
	end
end

---------------------------------------------------------------------------
-- Espèces normales (low-poly simple)
---------------------------------------------------------------------------
local species = {}

species.bunny = function(b, c)
	chibi(b, c)
	for _, s in { -1, 1 } do
		b:push({ 0.36 * s, 1.0, 0.1 }, { 0, 0, -8 * s })
		b:ell({ 0.42, 1.35, 0.3 }, { 0, 0.6, 0 }, c.body, nil, { name = "Body" })
		b:ell({ 0.2, 0.95, 0.1 }, { 0, 0.6, -0.14 }, c.inner or INNER)
		b:pop()
	end
	b:ball(0.55, { 0, -0.55, 0.75 }, c.belly)
	cuteFace(b, 0.3, -0.72, 0.34, c)
end

species.cat = function(b, c)
	chibi(b, c, { 1.85, 1.45, 1.55 })
	pointEars(b, c, 0.52, 0.95, 0.6)
	b:chain({ { 0, -0.7, 0.6 }, { 0.2, -0.45, 1.0 }, { 0.35, -0.05, 1.1 }, { 0.3, 0.3, 0.98 } }, { 0.3, 0.27, 0.24, 0.2 }, c.body, "cyl", { name = "Body" })
	b:ball(0.26, { 0.3, 0.32, 0.98 }, c.belly)
	for _, s in { -1, 1 } do
		for k = -1, 1, 2 do
			b:box({ 0.45, 0.03, 0.03 }, { 0.62 * s, 0.08 + k * 0.05, -0.68 }, BLACK, { 0, 0, k * 8 * s })
		end
	end
	cuteFace(b, 0.32, -0.72, 0.36, c)
end

species.fox = function(b, c)
	chibi(b, c, { 1.8, 1.45, 1.5 })
	pointEars(b, c, 0.5, 1.0, 0.68)
	b:ell({ 0.62, 0.42, 0.55 }, { 0, 0.02, -0.72 }, c.belly)
	b:ball(0.17, { 0, 0.1, -1.0 }, BLACK)
	b:push({ 0, -0.45, 0.85 }, { 35, 0, 0 })
	b:ell({ 0.7, 1.2, 0.7 }, { 0, 0.45, 0 }, c.body, nil, { name = "Body" })
	b:ell({ 0.45, 0.45, 0.45 }, { 0, 1.0, 0 }, c.belly)
	b:pop()
	cuteFace(b, 0.38, -0.7, 0.4, c)
end

species.pup = function(b, c)
	chibi(b, c)
	for _, s in { -1, 1 } do
		b:ell({ 0.45, 0.95, 0.32 }, { 0.88 * s, 0.25, 0.02 }, c.dark, { 0, 0, 16 * s })
	end
	b:ell({ 0.66, 0.42, 0.42 }, { 0, 0.02, -0.68 }, c.belly)
	b:ell({ 0.22, 0.15, 0.12 }, { 0, 0.14, -0.9 }, BLACK)
	b:ring({ 0, -0.2, 0.05 }, nil, 0.6, 14, { nil, 0.16, 0.12 }, "FF5A6E")
	b:ball(0.2, { 0, -0.32, -0.62 }, GOLD, { mat = "metal" })
	b:chain({ { 0, -0.55, 0.65 }, { 0, -0.25, 0.95 }, { 0, 0.05, 1.0 } }, { 0.22, 0.2, 0.16 }, c.body, "cyl")
	cuteFace(b, 0.38, -0.72, 0.38, c)
end

species.bear = function(b, c)
	chibi(b, c, { 1.85, 1.55, 1.6 })
	for _, s in { -1, 1 } do
		b:ball(0.55, { 0.6 * s, 1.0, 0.05 }, c.body, { name = "Body" })
		b:ball(0.3, { 0.6 * s, 1.0, -0.18 }, c.inner or INNER)
	end
	b:ell({ 0.7, 0.45, 0.4 }, { 0, 0.02, -0.7 }, c.belly)
	b:ell({ 0.24, 0.16, 0.12 }, { 0, 0.14, -0.9 }, BLACK)
	cuteFace(b, 0.42, -0.72, 0.4, c)
end

species.king = function(b, c)
	species.bear(b, c)
	b:ring({ 0, 1.12, 0 }, nil, 0.5, 10, { nil, 0.36, 0.12 }, GOLD, { mat = "metal" })
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2 + math.pi / 2
		b:spike({ math.cos(a) * 0.5, 1.4, math.sin(a) * 0.5 }, 0.22, GOLD, nil, { mat = "metal" })
	end
	b:ball(0.18, { 0, 1.12, -0.52 }, "FF3B6B", { mat = "neon" })
	-- cape
	b:box({ 1.3, 1.1, 0.12 }, { 0, -0.45, 0.62 }, "C8102E", { -12, 0, 0 })
end

species.dragon = function(b, c)
	chibi(b, c)
	b:ell({ 0.75, 0.5, 0.6 }, { 0, 0.05, -0.7 }, c.belly)
	for _, s in { -1, 1 } do
		b:ball(0.1, { 0.15 * s, 0.12, -1.0 }, BLACK)
		b:chain({ { 0.42 * s, 0.85, 0.15 }, { 0.6 * s, 1.3, 0.45 }, { 0.66 * s, 1.55, 0.85 } }, { 0.26, 0.18, 0.08 }, c.accent, "cyl")
		-- ailes : 3 baleines + membrane
		b:push({ 0.62 * s, -0.25, 0.5 }, { 0, 25 * s, -55 * s })
		b:box({ 0.08, 1.2, 0.08 }, { 0, 0.6, 0 }, c.dark)
		b:box({ 0.06, 1.0, 0.7 }, { 0, 0.55, 0.35 }, c.belly, nil, { alpha = 0.05 })
		b:box({ 0.08, 0.9, 0.08 }, { 0, 0.45, 0.7 }, c.dark, { -20, 0, 0 })
		b:pop()
	end
	for i = 0, 3 do
		b:spike({ 0, 1.0 - i * 0.38, 0.55 + i * 0.12 }, 0.24 - i * 0.03, c.accent, { 35 + i * 15, 0, 0 })
	end
	b:chain({ { 0, -0.7, 0.6 }, { 0, -0.75, 1.1 }, { 0.15, -0.5, 1.5 } }, { 0.4, 0.28, 0.16 }, c.body, "cyl")
	b:spike({ 0.15, -0.45, 1.6 }, 0.25, c.accent, { 60, 0, 0 })
	cuteFace(b, 0.4, -0.72, 0.38, c)
end

species.unicorn = function(b, c)
	chibi(b, c, { 1.7, 1.55, 1.6 })
	b:ell({ 0.72, 0.5, 0.55 }, { 0, 0.0, -0.68 }, c.belly)
	pointEars(b, c, 0.45, 1.0, 0.42)
	-- corne torsadée
	local pts, ds = {}, {}
	for i = 0, 5 do
		local t = i / 5
		table.insert(pts, { math.sin(t * 9) * 0.05, 0.95 + t * 0.85, -0.35 - t * 0.3 })
		table.insert(ds, 0.3 * (1 - t) + 0.05)
	end
	b:chain(pts, ds, GOLD, "cyl", { mat = "metal" })
	local mane = { "FF8FB8", "B69CFF", "7FD6FF", "7EE0B8", "FFE27A" }
	for i, col in mane do
		b:ball(0.5 - i * 0.04, { -0.45 + i * 0.05, 1.0 - i * 0.28, 0.45 + i * 0.08 }, col)
	end
	for i, col in mane do
		b:ball(0.35, { 0, -0.6 - i * 0.04, 0.75 + i * 0.15 }, col)
	end
	cuteFace(b, 0.4, -0.75, 0.36, c)
end

species.cloud = function(b, c)
	b:ell({ 1.9, 1.35, 1.5 }, { 0, 0, 0 }, c.body, nil, { name = "Body" })
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		b:ball(0.85 + (i % 2) * 0.2, { math.cos(a) * 0.95, -0.15 + math.sin(a) * 0.45, 0.1 + math.sin(a * 2) * 0.2 }, c.body, { name = "Body" })
	end
	b:ball(1.0, { -0.35, 0.65, 0.1 }, c.belly)
	b:ball(0.85, { 0.4, 0.6, 0.15 }, c.belly)
	cuteFace(b, 0.05, -0.74, 0.32, c)
end

species.phantom = function(b, c)
	b:ell({ 1.6, 1.9, 1.5 }, { 0, 0.15, 0 }, c.body, nil, { alpha = 0.12, name = "Body" })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		b:ball(0.6, { math.cos(a) * 0.55, -0.85, math.sin(a) * 0.5 }, c.body, { alpha = 0.12, name = "Body" })
	end
	for _, s in { -1, 1 } do
		b:ell({ 0.35, 0.6, 0.3 }, { 0.85 * s, -0.05, -0.1 }, c.body, { 0, 0, 30 * s }, { alpha = 0.12 })
	end
	b:ring({ 0, 1.35, 0 }, { 10, 0, 0 }, 0.5, 14, { nil, 0.08, 0.1 }, "FFE27A", { mat = "neon", tag = "SpinY" })
	cuteFace(b, 0.35, -0.7, 0.32, { glow = c.glow or "B9F3FF" })
end

species.golem = function(b, c)
	b:box({ 1.8, 1.4, 1.3 }, { 0, -0.3, 0 }, c.body, nil, { name = "Body" })
	b:box({ 1.25, 0.95, 1.05 }, { 0, 0.75, -0.05 }, c.body, nil, { name = "Body" })
	b:box({ 1.0, 0.7, 0.2 }, { 0, -0.3, -0.62 }, c.belly)
	for _, s in { -1, 1 } do
		b:ball(0.45, { 0.5 * s, 1.25, 0 }, c.body)
		b:box({ 0.5, 1.05, 0.55 }, { 1.15 * s, -0.3, -0.05 }, c.body, { 0, 0, 8 * s })
		b:box({ 0.6, 0.35, 0.65 }, { 1.2 * s, -0.9, -0.1 }, c.dark)
		b:box({ 0.6, 0.45, 0.65 }, { 0.45 * s, -1.0, 0 }, c.dark)
		b:spike({ 0.8 * s, 0.45, 0.1 }, 0.35, c.dark, { 0, 0, -30 * s })
	end
	fierceEyes(b, 0.85, -0.6, 0.27, c.glow or "FFE27A", 12)
	b:box({ 0.5, 0.1, 0.06 }, { 0, 0.5, -0.59 }, BLACK)
	for i = 0, 3 do
		b:spike({ -0.45 + i * 0.3, 0.12, 0.62 }, 0.3, c.dark, { 70, 0, 0 })
	end
end

---------------------------------------------------------------------------
-- Créatures mythologiques (Mythique)
---------------------------------------------------------------------------

-- Pégase barbe-à-papa (Grèce)
species.pegasus = function(b, c)
	b:ell({ 1.15, 1.1, 2.1 }, { 0, 0, 0.2 }, c.body, nil, { name = "Body" })
	for _, x in { -0.38, 0.38 } do
		for _, z in { -0.45, 0.85 } do
			b:box({ 0.28, 1.0, 0.3 }, { x, -0.65, z }, c.body)
			b:box({ 0.34, 0.22, 0.38 }, { x, -1.12, z - 0.02 }, GOLD, nil, { mat = "metal" })
		end
	end
	b:box({ 0.55, 1.0, 0.6 }, { 0, 0.7, -0.75 }, c.body, { -30, 0, 0 })
	b:box({ 0.62, 0.6, 0.85 }, { 0, 1.3, -1.15 }, c.body, { 15, 0, 0 })
	b:box({ 0.48, 0.42, 0.45 }, { 0, 1.12, -1.6 }, c.belly, { 15, 0, 0 })
	for _, s in { -1, 1 } do
		b:spike({ 0.2 * s, 1.7, -1.0 }, 0.22, c.body, { -10, 0, -10 * s })
		b:box({ 0.08, 0.12, 0.05 }, { 0.26 * s, 1.38, -1.58 }, BLACK)
		-- grandes ailes de plumes
		b:push({ 0.5 * s, 0.45, -0.1 }, { 0, 0, -40 * s })
		for k = 0, 5 do
			b:ell({ 0.26, 2.3 - k * 0.25, 0.55 }, { 0, 1.1 - k * 0.08, k * 0.34 }, if k % 2 == 0 then WHITE else c.belly, { -k * 11, 0, 0 })
		end
		b:ell({ 0.2, 1.2, 0.4 }, { 0, 2.0, -0.05 }, c.accent, { 12, 0, 0 }, { mat = "neon", alpha = 0.3 })
		b:pop()
	end
	local mane = { "FF8FB8", "7FD6FF", "FFB3E6", "B9E8FF" }
	for i = 1, 6 do
		b:ball(0.42, { 0, 1.5 - i * 0.2, -0.95 + i * 0.12 }, mane[(i - 1) % 4 + 1])
	end
	for i = 1, 5 do
		b:ball(0.4 - i * 0.03, { 0, 0.2 - i * 0.15, 1.35 + i * 0.15 }, mane[(i - 1) % 4 + 1])
	end
	b:ring({ 0, 2.0, -1.05 }, { 10, 0, 0 }, 0.42, 12, { nil, 0.08, 0.1 }, GOLD, { mat = "neon", tag = "SpinY" })
end

-- Cerbère guimauve, chien à trois têtes (Grèce)
species.cerberus = function(b, c)
	b:ell({ 1.7, 1.3, 2.0 }, { 0, -0.2, 0.3 }, c.body, nil, { name = "Body" })
	for _, x in { -0.5, 0.5 } do
		for _, z in { -0.4, 0.9 } do
			b:box({ 0.38, 0.75, 0.4 }, { x, -0.8, z }, c.body)
			b:box({ 0.44, 0.18, 0.5 }, { x, -1.12, z - 0.05 }, c.dark)
		end
	end
	local heads = { { -0.72, 0.65, -0.75, -20 }, { 0, 0.95, -0.95, 0 }, { 0.72, 0.65, -0.75, 20 } }
	for i, h in heads do
		b:push({ h[1], h[2], h[3] }, { 0, h[4], 0 })
		b:ell({ 0.85, 0.8, 0.8 }, { 0, 0, 0 }, c.body, nil, { name = "Body" })
		b:box({ 0.45, 0.32, 0.45 }, { 0, -0.12, -0.45 }, c.belly)
		b:ball(0.13, { 0, -0.02, -0.68 }, BLACK)
		for _, s in { -1, 1 } do
			b:spike({ 0.28 * s, 0.4, 0.05 }, 0.28, c.dark, { 0, 0, -20 * s })
		end
		fierceEyes(b, 0.12, -0.38, 0.17, c.glow or "FF4FD8", 10)
		b:ring({ 0, -0.42, 0.05 }, { 15, 0, 0 }, 0.36, 10, { nil, 0.14, 0.1 }, "3B2A5A")
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2
			b:spike({ math.cos(a) * 0.38, -0.42, math.sin(a) * 0.38 + 0.05 }, 0.14, GOLD, { 0, -math.deg(a), 90 }, { mat = "metal" })
		end
		b:pop()
	end
	b:chain({ { 0, -0.1, 1.2 }, { 0, 0.3, 1.6 }, { 0, 0.75, 1.75 } }, { 0.3, 0.22, 0.14 }, c.body, "cyl")
	b:ball(0.45, { 0, 0.95, 1.78 }, c.glow or "FF4FD8", { mat = "neon", alpha = 0.2 })
end

-- Sphinx praliné (Égypte)
species.sphinx = function(b, c)
	b:ell({ 1.6, 0.95, 2.4 }, { 0, -0.6, 0.4 }, c.body, nil, { name = "Body" })
	for _, s in { -1, 1 } do
		b:box({ 0.4, 0.32, 1.05 }, { 0.48 * s, -0.95, -0.85 }, c.body)
		b:box({ 0.45, 0.25, 0.25 }, { 0.48 * s, -0.98, -1.4 }, c.belly)
		b:box({ 0.35, 0.6, 0.9 }, { 0.78 * s, -0.75, 0.9 }, c.body)
	end
	b:ell({ 1.05, 1.1, 1.0 }, { 0, 0.45, -0.75 }, c.belly)
	-- némès rayé
	b:box({ 1.45, 1.1, 0.55 }, { 0, 0.62, -0.1 }, GOLD, nil, { mat = "metal" })
	for i = 0, 4 do
		b:box({ 1.47, 0.1, 0.57 }, { 0, 0.25 + i * 0.2, -0.1 }, "2C5DAA")
	end
	b:box({ 1.2, 0.3, 0.75 }, { 0, 1.05, -0.65 }, GOLD, nil, { mat = "metal" })
	b:box({ 1.22, 0.08, 0.77 }, { 0, 1.0, -0.65 }, "2C5DAA")
	for _, s in { -1, 1 } do
		b:box({ 0.3, 1.2, 0.3 }, { 0.68 * s, 0.0, -0.55 }, GOLD, { 0, 0, 6 * s }, { mat = "metal" })
		for i = 0, 4 do
			b:box({ 0.32, 0.08, 0.32 }, { 0.68 * s - 0.03 * s * (i - 2), -0.5 + i * 0.25, -0.55 }, "2C5DAA", { 0, 0, 6 * s })
		end
	end
	b:box({ 0.22, 0.5, 0.2 }, { 0, -0.25, -1.2 }, GOLD, nil, { mat = "metal" })
	b:chain({ { 0, 1.05, -1.2 }, { 0, 1.35, -1.25 }, { 0, 1.45, -1.12 } }, { 0.14, 0.12, 0.16 }, GOLD, "cyl", { mat = "metal" })
	fierceEyes(b, 0.55, -1.22, 0.24, c.glow or "5BE7FF", 5)
	b:chain({ { 0, -0.65, 1.55 }, { 0.3, -0.85, 1.95 }, { 0.6, -0.8, 2.2 } }, { 0.22, 0.17, 0.12 }, c.body, "cyl")
	b:ball(0.3, { 0.65, -0.78, 2.25 }, "2C5DAA")
end

-- Anubis cacao (Égypte)
species.anubis = function(b, c)
	b:ell({ 1.2, 1.5, 1.2 }, { 0, -0.35, 0.15 }, c.body, nil, { name = "Body" })
	b:box({ 0.75, 0.75, 0.85 }, { 0, 0.95, -0.15 }, c.body, nil, { name = "Body" })
	b:box({ 0.36, 0.36, 0.75 }, { 0, 0.82, -0.8 }, c.body)
	b:ball(0.16, { 0, 0.9, -1.18 }, BLACK)
	for _, s in { -1, 1 } do
		b:box({ 0.26, 0.95, 0.12 }, { 0.24 * s, 1.75, -0.05 }, c.body, { 0, 0, -8 * s })
		b:box({ 0.12, 0.7, 0.04 }, { 0.24 * s, 1.72, -0.12 }, GOLD, { 0, 0, -8 * s }, { mat = "metal" })
		b:box({ 0.3, 0.95, 0.35 }, { 0.42 * s, -0.95, -0.1 }, c.body)
		b:ring({ 0.62 * s, -0.25, -0.2 }, { 0, 0, 90 }, 0.2, 8, { nil, 0.12, 0.08 }, GOLD, { mat = "metal" })
	end
	fierceEyes(b, 1.02, -0.58, 0.2, c.glow or "FFD54A", 10)
	-- collier wesekh
	for k = 0, 2 do
		b:ring({ 0, 0.42 - k * 0.14, -0.05 }, { 12, 0, 0 }, 0.5 + k * 0.08, 16, { nil, 0.12, 0.14 }, if k == 1 then "2C5DAA" else GOLD, { mat = if k == 1 then "plastic" else "metal" })
	end
	-- ankh flottante
	b:push({ 1.15, 0.5, -0.3 }, nil)
	b:box({ 0.12, 0.75, 0.12 }, { 0, -0.15, 0 }, GOLD, nil, { mat = "neon", tag = "SpinY" })
	b:box({ 0.5, 0.12, 0.12 }, { 0, 0.15, 0 }, GOLD, nil, { mat = "neon", tag = "SpinY" })
	b:ring({ 0, 0.42, 0 }, { 90, 0, 0 }, 0.16, 8, { nil, 0.1, 0.08 }, GOLD, { mat = "neon", tag = "SpinY" })
	b:pop()
end

-- Fenrir lune de sang (Nordique)
species.fenrir = function(b, c)
	b:box({ 1.3, 1.1, 2.0 }, { 0, -0.1, 0.3 }, c.body, nil, { name = "Body" })
	b:ell({ 1.4, 1.35, 1.0 }, { 0, 0.05, -0.5 }, c.body, nil, { name = "Body" })
	for _, x in { -0.45, 0.45 } do
		for _, z in { -0.6, 1.0 } do
			b:box({ 0.38, 1.0, 0.42 }, { x, -0.65, z }, c.body)
			b:box({ 0.46, 0.2, 0.56 }, { x, -1.1, z - 0.06 }, c.dark)
			for k = -1, 1 do
				b:spike({ x + k * 0.13, -1.12, z - 0.36 }, 0.12, WHITE, { -80, 0, 0 })
			end
		end
	end
	-- chaînes brisées dorées
	for _, x in { -0.45, 0.45 } do
		b:ring({ x, -0.85, -0.6 }, nil, 0.3, 8, { nil, 0.1, 0.1 }, GOLD, { mat = "metal" })
	end
	b:box({ 0.9, 0.8, 0.8 }, { 0, 0.6, -0.85 }, c.body, { -30, 0, 0 })
	b:box({ 1.0, 0.85, 0.95 }, { 0, 1.0, -1.2 }, c.body, nil, { name = "Body" })
	b:box({ 0.6, 0.42, 0.78 }, { 0, 0.82, -1.9 }, c.body)
	b:box({ 0.55, 0.14, 0.65 }, { 0, 0.55, -1.82 }, c.belly)
	b:ball(0.18, { 0, 0.98, -2.3 }, BLACK)
	for k = -2, 2 do
		b:spike({ k * 0.1, 0.6, -2.12 }, 0.1, WHITE, { 180, 0, 0 })
	end
	for _, s in { -1, 1 } do
		b:spike({ 0.32 * s, 1.55, -1.05 }, 0.42, c.dark, { -10, 0, -15 * s })
	end
	fierceEyes(b, 1.1, -1.68, 0.3, c.glow or "FF2A3D", 15)
	for i = 0, 6 do
		b:spike({ 0, 1.45 - i * 0.16, -0.9 + i * 0.36 }, 0.42 - i * 0.03, if i % 2 == 0 then c.glow or "FF2A3D" else c.dark, { 25, 0, 0 }, { mat = if i % 2 == 0 then "neon" else "plastic" })
	end
	for _, s in { -1, 1 } do
		b:spike({ 0.65 * s, 0.65, -0.5 }, 0.35, c.dark, { 0, 0, -50 * s })
	end
	b:chain({ { 0, 0.2, 1.3 }, { 0, 0.75, 2.0 }, { 0, 1.25, 2.3 } }, { 0.45, 0.35, 0.2 }, c.body, "block")
	b:spike({ 0, 1.4, 2.35 }, 0.3, c.glow or "FF2A3D", { 20, 0, 0 }, { mat = "neon" })
	-- lune de sang et cristaux flottants
	b:ball(1.5, { 0, 2.6, 1.6 }, c.glow or "FF2A3D", { mat = "neon", alpha = 0.15 })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:spike({ math.cos(a) * 2.2, 0.6 + (k % 2) * 0.6, math.sin(a) * 2.2 }, 0.3, c.glow or "FF2A3D", { 0, 0, 180 * (k % 2) }, { mat = "neon", tag = "SpinY" })
	end
end

-- Mammouth d'Ymir, aux engrenages dorés (Nordique)
species.mammoth = function(b, c)
	b:ell({ 2.4, 2.0, 2.8 }, { 0, 0.25, 0.25 }, c.body, nil, { name = "Body" })
	for i = 0, 13 do
		local a = i / 14 * math.pi * 2
		b:spike({ math.cos(a) * 1.15, 0.2 + math.sin(a * 3) * 0.4, 0.3 + math.sin(a) * 1.3 }, 0.4, c.dark, { 0, -math.deg(a), -90 + math.sin(a * 2) * 20 })
	end
	b:ell({ 1.6, 1.5, 1.4 }, { 0, 0.8, -1.25 }, c.body, nil, { name = "Body" })
	for _, s in { -1, 1 } do
		b:ell({ 0.3, 1.1, 0.9 }, { 0.88 * s, 0.85, -1.0 }, c.dark, { 0, 20 * s, 10 * s })
		b:chain({ { 0.4 * s, 0.35, -1.75 }, { 0.62 * s, -0.35, -2.25 }, { 0.5 * s, -0.35, -2.85 }, { 0.3 * s, 0.05, -3.0 } }, { 0.3, 0.26, 0.2, 0.1 }, c.belly, "cyl")
		b:ring({ 0.62 * s, -0.35, -2.25 }, { 0, 0, 80 * s }, 0.17, 8, { nil, 0.12, 0.1 }, GOLD, { mat = "metal" })
		b:box({ 0.14, 0.14, 0.05 }, { 0.36 * s, 1.0, -1.93 }, c.glow or "FFE27A", nil, { mat = "neon" })
		for _, z in { -0.6, 1.0 } do
			b:pole(1.1, 0.75, { 0.72 * s, -0.6, z }, c.body)
			b:disc(0.82, 0.18, { 0.72 * s, -1.08, z }, GOLD, nil, { mat = "metal" })
		end
	end
	b:chain({ { 0, 0.55, -1.9 }, { 0, -0.15, -2.2 }, { 0, -0.75, -2.05 }, { 0, -0.95, -1.8 } }, { 0.5, 0.42, 0.34, 0.28 }, c.body, "cyl")
	-- tour d'horloge sur le dos
	b:box({ 0.7, 0.9, 0.7 }, { 0, 1.65, 0.4 }, GOLD_DARK, nil, { mat = "metal" })
	b:ball(0.4, { 0, 1.75, 0.03 }, c.glow or "FFE27A", { mat = "neon" })
	b:spike({ 0, 2.25, 0.4 }, 0.55, GOLD, nil, { mat = "metal" })
	-- auréole d'engrenages
	b:ring({ 0, 1.3, 1.5 }, { 90, 0, 0 }, 2.3, 28, { nil, 0.22, 0.32 }, GOLD, { mat = "metal" })
	b:ring({ 0, 1.3, 1.5 }, { 90, 0, 0 }, 2.0, 28, { nil, 0.1, 0.1 }, GOLD_DARK, { mat = "metal" })
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + 0.4
		b:gear({ math.cos(a) * 2.6, 0.2 + k * 0.4, math.sin(a) * 2.6 }, { 90, math.deg(a), 0 }, 0.35, 8, GOLD, { mat = "metal", tag = "SpinY" })
	end
end

-- Griffon céleste (Cosmique)
species.griffin = function(b, c)
	b:ell({ 1.3, 1.25, 2.1 }, { 0, 0, 0.35 }, c.body, nil, { name = "Body" })
	b:ell({ 1.2, 1.3, 1.0 }, { 0, 0.35, -0.5 }, c.belly)
	b:ell({ 0.95, 0.95, 1.0 }, { 0, 1.15, -0.85 }, c.belly, nil, { name = "Body" })
	b:push({ 0, 1.05, -1.4 }, { 90, 0, 0 })
	b:spike({ 0, 0, 0 }, 0.42, GOLD, nil, { mat = "metal" })
	b:pop()
	fierceEyes(b, 1.3, -1.28, 0.25, c.glow or "7FD6FF", 18)
	for _, s in { -1, 1 } do
		b:spike({ 0.25 * s, 1.65, -0.7 }, 0.3, c.belly, { -30, 0, -15 * s })
		b:box({ 0.3, 0.9, 0.35 }, { 0.42 * s, -0.6, -0.55 }, GOLD, nil, { mat = "metal" })
		for k = -1, 1 do
			b:spike({ 0.42 * s + k * 0.1, -1.1, -0.82 }, 0.12, BLACK, { -80, 0, 0 })
		end
		b:box({ 0.36, 0.95, 0.42 }, { 0.45 * s, -0.6, 1.0 }, c.body)
		b:push({ 0.55 * s, 0.45, 0.1 }, { 0, 0, -55 * s })
		for k = 0, 5 do
			b:ell({ 0.2, 1.9 - k * 0.22, 0.42 }, { 0, 0.9 - k * 0.07, k * 0.28 }, if k % 2 == 0 then c.accent else c.dark, { -k * 9, 0, 0 })
		end
		b:pop()
	end
	b:chain({ { 0, -0.1, 1.35 }, { 0, -0.4, 1.9 }, { 0, -0.1, 2.35 } }, { 0.22, 0.18, 0.14 }, c.body, "cyl")
	b:ball(0.4, { 0, 0.05, 2.45 }, c.accent)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:ball(0.22, { math.cos(a) * 2.0, 1.2 + (k % 2) * 0.4, math.sin(a) * 2.0 }, "FFF3B8", { mat = "neon", tag = "SpinY" })
	end
end

-- Dragon céleste (long dragon de jade)
species.longdragon = function(b, c)
	local pts, ds = {}, {}
	for i = 0, 11 do
		local t = i / 11
		table.insert(pts, { math.sin(t * math.pi * 2.2) * 1.0, 1.5 - t * 1.9 + math.sin(t * math.pi * 2) * 0.45, -0.8 + t * 3.0 })
		table.insert(ds, 0.85 - t * 0.55)
	end
	b:chain(pts, ds, c.body, "cyl", { name = "Body" })
	for i = 2, 11, 2 do
		b:spike(add(pts[i], { 0, ds[i] * 0.5, 0 }), 0.3, c.accent, { 20, 0, 0 })
		b:ball(ds[i] * 0.7, add(pts[i], { 0, -ds[i] * 0.3, -0.05 }), c.belly)
	end
	for _, i in { 3, 8 } do
		for _, s in { -1, 1 } do
			b:chain({ pts[i], add(pts[i], { 0.55 * s, -0.55, -0.1 }), add(pts[i], { 0.65 * s, -0.95, -0.3 }) }, { 0.18, 0.15, 0.12 }, c.body, "cyl")
			b:spike(add(pts[i], { 0.65 * s, -1.05, -0.4 }), 0.14, GOLD, { -90, 0, 0 }, { mat = "metal" })
		end
	end
	local head = add(pts[1], { 0, 0.25, -0.7 })
	b:box({ 1.0, 0.75, 1.1 }, head, c.body, nil, { name = "Body" })
	b:box({ 0.75, 0.4, 0.7 }, add(head, { 0, -0.15, -0.75 }), c.belly)
	b:ball(0.16, add(head, { 0.18, 0.02, -1.12 }), BLACK)
	b:ball(0.16, add(head, { -0.18, 0.02, -1.12 }), BLACK)
	for k = 0, 4 do
		b:spike(add(head, { 0, 0.4 - k * 0.05, 0.4 + k * 0.3 }), 0.3, c.accent, { 40, 0, 0 })
	end
	fierceEyes(b, head[2] + 0.15, head[3] - 0.57, 0.3, c.glow or "FFE27A", 10)
	for _, s in { -1, 1 } do
		b:chain({ add(head, { 0.3 * s, 0.3, 0.2 }), add(head, { 0.5 * s, 0.85, 0.5 }), add(head, { 0.75 * s, 1.05, 0.4 }) }, { 0.14, 0.1, 0.06 }, GOLD, "cyl", { mat = "metal" })
		b:chain({ add(head, { 0.25 * s, -0.15, -0.85 }), add(head, { 0.8 * s, -0.25, -1.0 }), add(head, { 1.2 * s, -0.05, -0.8 }) }, { 0.05, 0.04, 0.03 }, GOLD, "cyl")
	end
	b:ball(0.55, add(head, { 0, -0.4, -1.4 }), "BFF8FF", { mat = "neon", alpha = 0.2, tag = "SpinY" })
end

---------------------------------------------------------------------------
-- Dieux et titans (Divin)
---------------------------------------------------------------------------

-- Hydre d'Olympe à cinq têtes (Grèce)
species.hydra = function(b, c)
	b:ell({ 2.2, 1.6, 2.4 }, { 0, -0.25, 0.35 }, c.body, nil, { name = "Body" })
	b:ell({ 1.5, 1.0, 1.6 }, { 0, -0.55, 0.0 }, c.belly)
	for _, x in { -0.75, 0.75 } do
		for _, z in { -0.4, 1.1 } do
			b:box({ 0.45, 0.6, 0.5 }, { x, -0.85, z }, c.body)
			for k = -1, 1 do
				b:spike({ x + k * 0.14, -1.12, z - 0.3 }, 0.12, GOLD, { -80, 0, 0 }, { mat = "metal" })
			end
		end
	end
	for i, x in { -1, -0.5, 0, 0.5, 1 } do
		local top = { x * 1.5, 2.1 + (1 - math.abs(x)) * 0.5, -0.8 + math.abs(x) * 0.4 }
		local pts = { { x * 0.55, 0.3, -0.45 }, { x * 1.0, 1.15, -0.75 }, top }
		b:chain(pts, { 0.5, 0.4, 0.34 }, c.body, "cyl", { name = "Body" })
		b:spike({ x * 1.0, 1.4, -0.55 }, 0.22, c.accent, { 20, 0, 0 })
		b:push(top, { 0, -x * 25, 0 })
		b:box({ 0.55, 0.48, 0.75 }, { 0, 0.05, -0.2 }, c.body, nil, { name = "Body" })
		b:box({ 0.42, 0.18, 0.5 }, { 0, -0.18, -0.55 }, c.belly)
		fierceEyes(b, 0.14, -0.58, 0.17, c.glow or "C6FF4F", 12)
		for _, s in { -1, 1 } do
			b:spike({ 0.18 * s, 0.4, 0.05 }, 0.22, GOLD, { -25, 0, -15 * s }, { mat = "metal" })
		end
		if i == 3 then
			b:ring({ 0, 0.38, -0.15 }, nil, 0.32, 10, { nil, 0.12, 0.08 }, GOLD, { mat = "neon" })
		end
		b:pop()
	end
	b:chain({ { 0, -0.2, 1.5 }, { 0.3, -0.6, 2.2 }, { 0.8, -0.8, 2.6 } }, { 0.6, 0.4, 0.2 }, c.body, "cyl")
	-- couronne de laurier divine
	b:ring({ 0, 0.1, 0.35 }, nil, 2.7, 24, { 0.35, 0.08, 0.18 }, "7EE0A0", { mat = "neon", tag = "SpinY" })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		b:spike({ math.cos(a) * 2.7, 0.15, 0.35 + math.sin(a) * 2.7 }, 0.3, GOLD, nil, { mat = "neon", tag = "SpinY" })
	end
end

-- Ra, phénix solaire (Égypte)
species.phoenix = function(b, c)
	b:ell({ 1.1, 1.35, 1.1 }, { 0, 0.25, 0.05 }, c.body, nil, { name = "Body" })
	b:ell({ 0.7, 0.85, 0.4 }, { 0, 0.15, -0.42 }, c.belly)
	b:ball(0.9, { 0, 1.2, -0.3 }, c.body, { name = "Body" })
	b:push({ 0, 1.12, -0.82 }, { 90, 0, 0 })
	b:spike({ 0, 0, 0 }, 0.32, GOLD, nil, { mat = "metal" })
	b:pop()
	fierceEyes(b, 1.3, -0.72, 0.2, c.glow or "FFF3B8", 15)
	for k = -2, 2 do
		b:ell({ 0.2, 0.95 - math.abs(k) * 0.15, 0.25 }, { k * 0.14, 1.95 - math.abs(k) * 0.08, -0.15 + math.abs(k) * 0.05 }, if k % 2 == 0 then "FFD23F" else "FF7A1F", { 0, 0, -k * 12 }, { mat = "neon" })
	end
	local flame = { "D8241F", "FF5A1F", "FF8A1F", "FFB020", "FFE27A" }
	for _, s in { -1, 1 } do
		b:push({ 0.45 * s, 0.6, 0.1 }, { 0, 0, -35 * s })
		for k = 1, 5 do
			b:ell({ 0.24, 2.3 - k * 0.2, 0.45 }, { 0, 1.0, (k - 3) * 0.3 }, flame[k], { -(k - 3) * 12, 0, -k * 9 * s }, { mat = if k >= 4 then "neon" else "plastic" })
		end
		b:pop()
		b:box({ 0.12, 0.6, 0.12 }, { 0.25 * s, -0.75, 0 }, GOLD, nil, { mat = "metal" })
		for k = -1, 1 do
			b:spike({ 0.25 * s + k * 0.08, -1.08, -0.1 }, 0.1, GOLD, { -80, 0, 0 }, { mat = "metal" })
		end
	end
	for k = -2, 2 do
		b:ell({ 0.22, 1.6, 0.35 }, { k * 0.22, -0.6, 0.85 }, flame[k + 3], { 55, 0, k * 14 }, { mat = if math.abs(k) <= 1 then "neon" else "plastic" })
	end
	-- disque solaire derrière
	local sun = { 0, 1.1, 0.95 }
	b:ring(sun, { 90, 0, 0 }, 2.0, 30, { nil, 0.18, 0.22 }, "FFC93C", { mat = "neon", tag = "SpinZ", pivot = sun })
	b:disc(3.6, 0.05, { 0, 1.1, 1.05 }, "FFE27A", { 90, 0, 0 }, { mat = "neon", alpha = 0.7 })
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		b:spike({ math.cos(a) * 2.35, 1.1 + math.sin(a) * 2.35, 0.95 }, 0.35, "FFB020", { 0, 0, math.deg(a) - 90 }, { mat = "neon", tag = "SpinZ", pivot = sun })
	end
end

-- Kraken des abysses (Nordique)
species.kraken = function(b, c)
	b:ell({ 2.2, 2.6, 2.2 }, { 0, 1.55, 0.25 }, c.body, nil, { name = "Body" })
	b:ell({ 1.9, 1.1, 1.8 }, { 0, 0.4, 0.05 }, c.body, nil, { name = "Body" })
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		b:spike({ math.cos(a) * 0.75, 2.55 + math.sin(a * 2) * 0.1, 0.25 + math.sin(a) * 0.75 }, 0.36, c.accent, { 0, -math.deg(a), -35 })
	end
	b:spike({ 0, 2.95, 0.25 }, 0.4, c.accent)
	b:ring({ 0, 1.0, 0.1 }, nil, 1.02, 22, { nil, 0.22, 0.12 }, GOLD, { mat = "metal" })
	b:box({ 0.4, 0.4, 0.08 }, { 0, 1.05, -0.93 }, GOLD_DARK, { 0, 0, 45 }, { mat = "metal" })
	for _, s in { -1, 1 } do
		b:ell({ 0.5, 0.3, 0.12 }, { 0.48 * s, 0.6, -0.86 }, c.glow or "FFE27A", { 0, 0, -12 * s }, { mat = "neon" })
		b:box({ 0.06, 0.24, 0.06 }, { 0.48 * s, 0.6, -0.93 }, BLACK)
	end
	-- huit tentacules hérissées
	local rs = { 0.6, 1.4, 2.2, 2.9, 3.4, 3.6 }
	local ys = { 0.35, -0.25, -0.65, -0.75, -0.45, 0.05 }
	local ds = { 0.78, 0.66, 0.56, 0.45, 0.34, 0.22 }
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2 + math.pi / 8
		local pts = {}
		for i = 1, #rs do
			local wob = math.sin(i * 1.3 + k) * 0.25
			table.insert(pts, { math.cos(a + wob * 0.2) * rs[i], ys[i], 0.1 + math.sin(a + wob * 0.2) * rs[i] })
		end
		b:chain(pts, ds, c.body, "cyl", { name = "Body" })
		for i = 2, #rs - 1 do
			b:spike(add(pts[i], { 0, ds[i] * 0.45, 0 }), ds[i] * 0.6, c.accent, { 0, -math.deg(a), -20 })
		end
		for _, i in { 2, 4 } do
			local dir = sub(pts[i + 1], pts[i])
			b:add("cyl", { 0.12, ds[i] * 1.18, ds[i] * 1.18 }, add(pts[i], scale(dir, 0.5)), mul(alongY(dir), euler(0, 0, 90)), GOLD, { mat = "metal" })
		end
	end
	-- runes et bulles divines
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:box({ 0.35, 0.5, 0.08 }, { math.cos(a) * 3.0, 2.2 + (k % 2) * 0.5, math.sin(a) * 3.0 }, GOLD, { 0, -math.deg(a) + 90, 0 }, { mat = "neon", tag = "SpinY" })
		b:ball(0.28, { math.cos(a + 0.5) * 2.4, 3.0 + (k % 3) * 0.3, math.sin(a + 0.5) * 2.4 }, "9FF2EA", { mat = "neon", alpha = 0.35, tag = "SpinY" })
	end
end

-- Léviathan cosmique, serpent enroulé (Cosmique)
species.leviathan = function(b, c)
	local pts, ds = {}, {}
	local n = 22
	for i = 0, n do
		local t = i / n
		local ang = t * math.pi * 3.2
		local r = 1.9 - t * 0.9
		table.insert(pts, { math.cos(ang) * r, -0.7 + t * 1.6, math.sin(ang) * r + 0.3 })
		table.insert(ds, 0.95 - t * 0.25)
	end
	-- le cou se dresse
	local last = pts[#pts]
	local neck = { add(last, { 0, 0.8, -0.2 }), add(last, { -0.1, 1.6, -0.6 }), { 0, 3.1, -0.7 } }
	for i, p in neck do
		table.insert(pts, p)
		table.insert(ds, 0.68 - i * 0.05)
	end
	b:chain(pts, ds, c.body, "cyl", { name = "Body" })
	for i = 2, #pts - 1 do
		local up = { 0, ds[i] * 0.48, 0 }
		b:spike(add(pts[i], up), ds[i] * 0.45, c.accent, { 15, 0, 0 })
		if i % 3 == 0 then
			local dir = sub(pts[i + 1], pts[i])
			b:add("cyl", { 0.16, ds[i] * 1.15, ds[i] * 1.15 }, add(pts[i], scale(dir, 0.5)), mul(alongY(dir), euler(0, 0, 90)), GOLD, { mat = "metal" })
		end
	end
	local head = { 0, 3.35, -1.05 }
	b:box({ 0.95, 0.75, 1.35 }, head, c.body, { 10, 0, 0 }, { name = "Body" })
	b:box({ 0.8, 0.25, 1.0 }, add(head, { 0, -0.5, -0.25 }), c.belly, { 25, 0, 0 })
	for k = -2, 2 do
		b:spike(add(head, { k * 0.15, -0.3, -0.75 }), 0.12, WHITE, { 180, 0, 0 })
	end
	fierceEyes(b, head[2] + 0.15, head[3] - 0.66, 0.3, c.glow or "FFE27A", 15)
	-- crête en éventail
	for k = -3, 3 do
		b:push(add(head, { 0, 0.35, 0.35 }), { -40 + math.abs(k) * 8, 0, k * 22 })
		b:box({ 0.1, 1.2, 0.3 }, { 0, 0.6, 0 }, c.dark)
		b:spike({ 0, 1.25, 0 }, 0.18, GOLD, nil, { mat = "metal" })
		b:pop()
	end
	for _, s in { -1, 1 } do
		b:chain({ add(head, { 0.35 * s, 0.3, 0.2 }), add(head, { 0.6 * s, 0.6, 0.8 }), add(head, { 0.55 * s, 1.0, 1.2 }) }, { 0.16, 0.12, 0.06 }, "E8E0C8", "cyl")
		b:push(add(head, { 0.5 * s, 0, 0.3 }), { 0, 0, -60 * s })
		b:box({ 0.08, 0.9, 0.6 }, { 0, 0.45, 0 }, c.dark, nil, { alpha = 0.1 })
		b:pop()
	end
	-- piliers dorés et bulles qui flottent autour
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = { math.cos(a) * 3.3, -0.2 + (k % 2) * 0.8, math.sin(a) * 3.3 + 0.3 }
		b:box({ 0.35, 1.0, 0.35 }, p, GOLD, nil, { mat = "metal", tag = "SpinY" })
		b:box({ 0.55, 0.18, 0.55 }, add(p, { 0, 0.55, 0 }), GOLD, nil, { mat = "metal", tag = "SpinY" })
		b:ball(0.3, add(p, { 0.6, 1.2, 0 }), "9FF2EA", { mat = "neon", alpha = 0.4, tag = "SpinY" })
	end
end

---------------------------------------------------------------------------
-- API
---------------------------------------------------------------------------
Shapes.species = species

-- Retourne la liste des pièces d'un pet.
-- colors : { body, belly, dark, accent, inner?, glow? } en hexadécimal.
function Shapes.build(speciesName, colors)
	local b = Shapes.builder()
	local f = species[speciesName] or species.bunny
	f(b, colors)
	return b.parts
end

return Shapes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">GameServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Sweet Pets Factory : serveur
-- Gère les données des joueurs, la carte, les bonbons, les pets, les œufs,
-- la boutique, les quêtes et le boss. Les joueurs ne font qu'envoyer des
-- demandes (remotes) que le serveur vérifie.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PetModels = require(Shared:WaitForChild("PetModels"))

local rng = Random.new()

---------------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local Action = Instance.new("RemoteEvent")
Action.Name = "Action"
Action.Parent = remotes
local StateEvent = Instance.new("RemoteEvent")
StateEvent.Name = "State"
StateEvent.Parent = remotes
local Fx = Instance.new("RemoteEvent")
Fx.Name = "Fx"
Fx.Parent = remotes
remotes.Parent = ReplicatedStorage

---------------------------------------------------------------------------
-- Outils de construction
---------------------------------------------------------------------------
local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	local parent = props.Parent
	for k, v in props do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function deco(props: { [string]: any }): Part
	props.CanCollide = if props.CanCollide == nil then false else props.CanCollide
	props.CanQuery = false
	props.CanTouch = false
	return part(props)
end

local function billboard(adornee: BasePart, offset: Vector3, size: UDim2, maxDist: number?): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Adornee = adornee
	bb.Size = size
	bb.StudsOffsetWorldSpace = offset
	bb.MaxDistance = maxDist or 120
	bb.LightInfluence = 0
	bb.Parent = adornee
	return bb
end

local INK = Color3.fromHex("3B2A5A")

local function label(parent: Instance, text: string, size: UDim2, pos: UDim2, textSize: number, color: Color3?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.Font = Enum.Font.FredokaOne
	t.Text = text
	t.TextSize = textSize
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextScaled = false
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = INK
	st.Parent = t
	t.Parent = parent
	return t
end

---------------------------------------------------------------------------
-- Carte : une île par monde + l'arène du boss
---------------------------------------------------------------------------
local map = Instance.new("Folder")
map.Name = "Map"
map.Parent = workspace
local pileFolder = Instance.new("Folder")
pileFolder.Name = "Piles"
pileFolder.Parent = workspace

local FIELD_X = 150
local FIELD_Z0, FIELD_Z1 = -70, 140
local PLAZA_Z = -115

local eggStands: { [string]: Vector3 } = {}
local prompts: { ProximityPrompt } = {}

local function worldSpawn(w: number): CFrame
	local o = Config.Worlds[w].origin
	return CFrame.new(o + Vector3.new(0, 4, 30))
end

local function buildDecor(w, folder: Folder)
	local o = w.origin
	local r = Random.new(w.id * 977)
	local placed = 0
	while placed < 34 do
		local x = r:NextNumber(-185, 185)
		local z = r:NextNumber(-155, 155)
		local inField = math.abs(x) < FIELD_X + 12 and z > FIELD_Z0 - 12 and z < FIELD_Z1 + 12
		local inPlaza = z < PLAZA_Z + 45 and z > PLAZA_Z - 45 and math.abs(x) < 150
		if inField or inPlaza then
			continue
		end
		placed += 1
		local base = o + Vector3.new(x, 0, z)
		local k = r:NextInteger(1, 3)
		local h = r:NextNumber(8, 16)
		if w.theme == "meadow" then
			if k == 1 then
				deco({ Parent = folder, Size = Vector3.new(h, 1.2, 1.2), CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Shape = Enum.PartType.Cylinder, Color = Color3.new(1, 1, 1), CanCollide = true })
				deco({ Parent = folder, Size = Vector3.new(1.5, 8, 8), CFrame = CFrame.new(base + Vector3.new(0, h + 3, 0)) * CFrame.Angles(0, math.rad(r:NextNumber(0, 180)), 0), Shape = Enum.PartType.Cylinder, Color = w.candy[r:NextInteger(1, #w.candy)] })
			elseif k == 2 then
				for i = 1, 3 do
					deco({ Parent = folder, Size = Vector3.one * r:NextNumber(5, 8), Position = base + Vector3.new(r:NextNumber(-4, 4), 3, r:NextNumber(-4, 4)), Shape = Enum.PartType.Ball, Color = Color3.fromHex(i == 2 and "8EDDB4" or "A6E8C4"), CanCollide = true })
				end
			else
				deco({ Parent = folder, Size = Vector3.new(1.6, h, 1.6), Position = base + Vector3.new(0, h / 2, 0), Color = Color3.new(1, 1, 1), CanCollide = true })
				for i = 0, math.floor(h / 2.5) do
					deco({ Parent = folder, Size = Vector3.new(1.7, 0.5, 1.7), CFrame = CFrame.new(base + Vector3.new(0, 1 + i * 2.5, 0)) * CFrame.Angles(0, 0, math.rad(25)), Color = Color3.fromHex("FF5A6E") })
				end
			end
		elseif w.theme == "choco" then
			deco({ Parent = folder, Size = Vector3.new(2.4, h, 2.4), Position = base + Vector3.new(0, h / 2, 0), Color = Color3.fromHex("6B4430"), CanCollide = true })
			for i = 1, 3 do
				deco({ Parent = folder, Size = Vector3.one * r:NextNumber(6, 9), Position = base + Vector3.new(r:NextNumber(-3, 3), h + r:NextNumber(-1, 2), r:NextNumber(-3, 3)), Shape = Enum.PartType.Ball, Color = Color3.fromHex(i == 1 and "5A3424" or "4A2C20") })
			end
		elseif w.theme == "ice" then
			deco({ Parent = folder, Size = Vector3.new(h * 0.8, 3, 3), CFrame = CFrame.new(base + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90)), Shape = Enum.PartType.Cylinder, Color = Color3.fromHex("E8A85A"), CanCollide = true })
			for i = 1, k do
				deco({ Parent = folder, Size = Vector3.one * 5.5, Position = base + Vector3.new(0, h * 0.8 + (i - 1) * 4, 0), Shape = Enum.PartType.Ball, Color = w.candy[r:NextInteger(1, #w.candy)] })
			end
		else
			if k == 1 then
				local planet = deco({ Parent = folder, Size = Vector3.one * r:NextNumber(8, 14), Position = base + Vector3.new(0, h + 4, 0), Shape = Enum.PartType.Ball, Color = w.candy[r:NextInteger(1, #w.candy)] })
				deco({ Parent = folder, Size = Vector3.new(0.4, planet.Size.X * 1.7, planet.Size.X * 1.7), CFrame = planet.CFrame * CFrame.Angles(0, 0, math.rad(70)), Shape = Enum.PartType.Cylinder, Color = Color3.fromHex("FFF3B8"), Transparency = 0.3 })
			else
				deco({ Parent = folder, Size = Vector3.new(3, h, 3), CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, math.rad(45), math.rad(r:NextNumber(-12, 12))), Color = w.candy[r:NextInteger(1, #w.candy)], Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = true })
			end
		end
	end
end

local function addPrompt(parent: BasePart, action: string, object: string, kind: string, value: string): ProximityPrompt
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = action
	pr.ObjectText = object
	pr.KeyboardKeyCode = Enum.KeyCode.E
	pr.HoldDuration = 0
	pr.MaxActivationDistance = 14
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Kind", kind)
	pr:SetAttribute("Value", value)
	pr.Parent = parent
	table.insert(prompts, pr)
	return pr
end

local function buildWorld(w)
	local o = w.origin
	local folder = Instance.new("Folder")
	folder.Name = w.name
	folder.Parent = map

	part({ Parent = folder, Name = "Ground", Size = Vector3.new(400, 4, 340), Position = o + Vector3.new(0, -2, 0), Color = w.ground })
	-- damier de dalles claires
	for gx = -4, 4 do
		for gz = -3, 3 do
			if (gx + gz) % 2 == 0 then
				deco({ Parent = folder, Size = Vector3.new(40, 0.1, 40), Position = o + Vector3.new(gx * 40, 0.05, gz * 40 + 10), Color = w.ground2 })
			end
		end
	end
	-- bordures
	for _, b in { { Vector3.new(0, 10, 172), Vector3.new(404, 24, 4) }, { Vector3.new(0, 10, -172), Vector3.new(404, 24, 4) }, { Vector3.new(202, 10, 0), Vector3.new(4, 24, 340) }, { Vector3.new(-202, 10, 0), Vector3.new(4, 24, 340) } } do
		part({ Parent = folder, Size = b[2], Position = o + b[1], Transparency = 1 })
		deco({ Parent = folder, Size = Vector3.new(b[2].X, 2, b[2].Z), Position = o + Vector3.new(b[1].X, 1, b[1].Z), Color = w.banner, CanCollide = true })
	end
	-- place centrale
	deco({ Parent = folder, Name = "Plaza", Size = Vector3.new(300, 0.3, 70), Position = o + Vector3.new(0, 0.15, PLAZA_Z), Color = w.plaza, CanCollide = true })
	-- panneau du monde
	local sign = deco({ Parent = folder, Size = Vector3.new(36, 9, 1.5), Position = o + Vector3.new(0, 14, PLAZA_Z - 30), Color = w.banner, CanCollide = true })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.CanvasSize = Vector2.new(720, 180)
	sg.LightInfluence = 0
	sg.Parent = sign
	label(sg, w.name, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 90)
	for _, sx in { -17, 17 } do
		deco({ Parent = folder, Size = Vector3.new(1.5, 14, 1.5), Position = o + Vector3.new(sx, 7, PLAZA_Z - 30), Color = Color3.new(1, 1, 1), CanCollide = true })
	end

	-- socles d'œufs
	for i, eggId in w.eggs do
		local egg = Config.Eggs[eggId]
		local pos = o + Vector3.new(-30 + (i - 1) * 60, 0, PLAZA_Z)
		eggStands[eggId] = pos
		local ped = part({ Parent = folder, Name = "Stand_" .. eggId, Size = Vector3.new(3, 12, 12), CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Shape = Enum.PartType.Cylinder, Color = Color3.new(1, 1, 1) })
		ped:SetAttribute("Egg", eggId)
		local model = PetModels.egg(eggId, 2.2)
		model:PivotTo(CFrame.new(pos + Vector3.new(0, 7.8, 0)))
		model.Parent = folder
		local bb = billboard(ped, Vector3.new(0, 15, 0), UDim2.fromOffset(240, 80))
		label(bb, egg.name, UDim2.new(1, 0, 0.55, 0), UDim2.fromScale(0, 0), 32)
		label(bb, Config.fmt(egg.price) .. " pièces", UDim2.new(1, 0, 0.45, 0), UDim2.fromScale(0, 0.55), 26, Color3.fromHex("FFD54A"))
		addPrompt(ped, "Ouvrir", egg.name .. " · " .. Config.fmt(egg.price), "egg", eggId)
	end

	-- portail de rebirth
	local pp = o + Vector3.new(-105, 0, PLAZA_Z)
	for _, sx in { -7, 7 } do
		deco({ Parent = folder, Size = Vector3.new(2.5, 16, 2.5), Position = pp + Vector3.new(sx, 8, 0), Color = Color3.fromHex("6B5BD6"), CanCollide = true })
	end
	deco({ Parent = folder, Size = Vector3.new(17, 2.5, 2.5), Position = pp + Vector3.new(0, 16, 0), Color = Color3.fromHex("6B5BD6"), CanCollide = true })
	local disc = deco({ Parent = folder, Name = "Portal", Size = Vector3.new(0.6, 12, 12), CFrame = CFrame.new(pp + Vector3.new(0, 8, 0)) * CFrame.Angles(0, math.rad(90), 0), Shape = Enum.PartType.Cylinder, Color = Color3.fromHex("B69CFF"), Material = Enum.Material.Neon, Transparency = 0.2 })
	local pbb = billboard(disc, Vector3.new(0, 11, 0), UDim2.fromOffset(220, 50))
	label(pbb, "REBIRTH", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 34, Color3.fromHex("FFD54A"))
	local pbase = part({ Parent = folder, Size = Vector3.new(16, 1, 6), Position = pp + Vector3.new(0, 0.5, 4), Color = Color3.fromHex("8C7BFF") })
	addPrompt(pbase, "Rebirth", "Portail", "panel", "rebirth")

	-- porte des mondes
	local gp = o + Vector3.new(105, 0, PLAZA_Z)
	for _, sx in { -8, 8 } do
		deco({ Parent = folder, Size = Vector3.new(3, 18, 3), Position = gp + Vector3.new(sx, 9, 0), Color = Color3.new(1, 1, 1), CanCollide = true })
	end
	local top = deco({ Parent = folder, Size = Vector3.new(22, 4, 3), Position = gp + Vector3.new(0, 19, 0), Color = Color3.fromHex("7EE0B8"), CanCollide = true })
	local nextW = Config.Worlds[w.id + 1]
	deco({ Parent = folder, Size = Vector3.new(13, 16, 0.4), Position = gp + Vector3.new(0, 8, 0), Color = nextW and nextW.ground or Color3.fromHex("BDE9FF"), Material = Enum.Material.Neon, Transparency = 0.35 })
	local gbb = billboard(top, Vector3.new(0, 5, 0), UDim2.fromOffset(240, 50))
	label(gbb, "MONDES", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 34)
	local gbase = part({ Parent = folder, Size = Vector3.new(18, 1, 6), Position = gp + Vector3.new(0, 0.5, 4), Color = Color3.fromHex("7EE0B8") })
	addPrompt(gbase, "Voyager", "Mondes", "panel", "worlds")

	-- contour du champ de bonbons
	deco({ Parent = folder, Size = Vector3.new(FIELD_X * 2 + 16, 0.12, FIELD_Z1 - FIELD_Z0 + 16), Position = o + Vector3.new(0, 0.1, (FIELD_Z0 + FIELD_Z1) / 2), Color = w.ground:Lerp(Color3.new(1, 1, 1), 0.25), Transparency = 0.3 })

	buildDecor(w, folder)
end

for _, w in Config.Worlds do
	buildWorld(w)
end

-- Arène du boss
local arena = Instance.new("Folder")
arena.Name = "BossArena"
arena.Parent = map
local BO = Config.BOSS_ORIGIN
part({ Parent = arena, Size = Vector3.new(170, 4, 150), Position = BO + Vector3.new(0, -2, 0), Color = Color3.fromHex("3B2F6B") })
for i = 1, 5 do
	deco({ Parent = arena, Size = Vector3.new(0.2, 140 - i * 22, 140 - i * 22), CFrame = CFrame.new(BO + Vector3.new(0, 0.05 + i * 0.02, -15)) * CFrame.Angles(0, 0, math.rad(90)), Shape = Enum.PartType.Cylinder, Color = Color3.fromHex(i % 2 == 0 and "4B3E86" or "5A4BA0") })
end
for _, b in { { Vector3.new(0, 15, 76), Vector3.new(174, 34, 4) }, { Vector3.new(0, 15, -76), Vector3.new(174, 34, 4) }, { Vector3.new(86, 15, 0), Vector3.new(4, 34, 150) }, { Vector3.new(-86, 15, 0), Vector3.new(4, 34, 150) } } do
	part({ Parent = arena, Size = b[2], Position = BO + b[1], Color = Color3.fromHex("6B5BD6"), Transparency = 0.6 })
end
local ARENA_SPAWN = CFrame.new(BO + Vector3.new(0, 4, 45))
local GOLEM_POS = BO + Vector3.new(0, 0, -30)

---------------------------------------------------------------------------
-- Données des joueurs
---------------------------------------------------------------------------
local store: DataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore("SweetPetsFactory_v1")
end)

local function today(): string
	return os.date("!%Y-%m-%d") :: string
end

local function yesterday(): string
	return os.date("!%Y-%m-%d", os.time() - 86400) :: string
end

local function defaultData()
	return {
		v = 1,
		coins = 0,
		gems = 0,
		totalCoins = 0,
		rebirths = 0,
		world = 1,
		maxWorld = 1,
		pets = { { uid = 1, def = "gumdrop_bunny", tier = 0, lvl = 0, xp = 0, eq = true, lock = false, shiny = false, bonus = 0 } },
		nextUid = 2,
		discovered = { gumdrop_bunny = true },
		upgrades = {},
		passes = {},
		potions = {},
		quest = 1,
		questBase = 0,
		dailyDay = "",
		daily = {},
		giftDay = "",
		giftStreak = 0,
		stats = { hatched = 0, piles = 0, taps = 0, bosses = 0, golden = 0, rainbow = 0, upgrades = 0, play = 0, bestHit = 0 },
		indexClaim = 0,
		bossWins = 0,
		autoCollect = true,
		autoDelete = 0,
		lastSeen = 0,
	}
end

local function reconcile(data, template)
	for k, v in template do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and k == "stats" then
			reconcile(data[k], v)
		end
	end
	return data
end

type Profile = {
	data: any,
	canSave: boolean,
	full: boolean,
	money: boolean,
	focus: number?,
	targets: { [number]: number },
	arrive: { [number]: number },
	eq: { any },
	lastTap: number,
	combo: number,
	comboT: number,
	lastHatch: number,
	autoHatch: string?,
	stunUntil: number,
	inBoss: boolean,
	robux: { [string]: boolean },
	cpsAcc: number,
	cpsHist: { number },
	cps: number,
	targetStr: string,
}

local profiles: { [Player]: Profile } = {}

---------------------------------------------------------------------------
-- Économie
---------------------------------------------------------------------------
local function hasPass(prof: Profile, id: string): boolean
	return prof.data.passes[id] == true or prof.robux[id] == true
end

local function up(prof: Profile, id: string): number
	return prof.data.upgrades[id] or 0
end

local function slots(prof: Profile): number
	return Config.BASE_SLOTS + up(prof, "slot") + (hasPass(prof, "vip") and 2 or 0)
end

local function storage(prof: Profile): number
	return Config.BASE_STORAGE + 25 * up(prof, "storage")
end

local function potionOn(prof: Profile, id: string): boolean
	return (prof.data.potions[id] or 0) > 0
end

local function damageMult(prof: Profile): number
	return (1 + 0.1 * up(prof, "power")) * (potionOn(prof, "dmg") and 2 or 1)
end

local function coinMult(prof: Profile): number
	local d = prof.data
	local m = Config.rebirthMult(d.rebirths) * (1 + 0.1 * up(prof, "coins")) * (1 + 0.05 * d.indexClaim)
	if hasPass(prof, "coins2") then
		m *= 2
	end
	if hasPass(prof, "vip") then
		m *= 1.1
	end
	if potionOn(prof, "coins") then
		m *= 2
	end
	return m
end

local function luckMult(prof: Profile): number
	local m = 1 + 0.15 * up(prof, "luck")
	if hasPass(prof, "luck2") then
		m *= 2
	end
	if potionOn(prof, "luck") then
		m *= 2
	end
	return m
end

local function teamDps(prof: Profile): number
	local sum = 0
	for _, p in prof.eq do
		sum += PetModels.power(p)
	end
	return sum * damageMult(prof)
end

local function tapDamage(prof: Profile): number
	return math.max(3, teamDps(prof) * 0.25) * (1 + 0.5 * up(prof, "tap"))
end

local function coinPerHP(w: number): number
	return 3 * Config.Worlds[w].coinMult
end

local function estimatedCps(prof: Profile): number
	return teamDps(prof) * coinPerHP(prof.data.world) * coinMult(prof) * 0.8
end

local function equippedCount(d): number
	local n = 0
	for _, p in d.pets do
		if p.eq then
			n += 1
		end
	end
	return n
end

local function findPet(d, uid: any)
	for _, p in d.pets do
		if p.uid == uid then
			return p
		end
	end
	return nil
end

local function addPet(d, def: string, tier: number, shiny: boolean)
	local p = { uid = d.nextUid, def = def, tier = tier, lvl = 0, xp = 0, eq = false, lock = false, shiny = shiny, bonus = 0 }
	d.nextUid += 1
	table.insert(d.pets, p)
	d.discovered[def] = true
	return p
end

local function removePets(d, uids: { [number]: boolean })
	local keep = {}
	for _, p in d.pets do
		if not uids[p.uid] then
			table.insert(keep, p)
		end
	end
	d.pets = keep
end

local function setWalkSpeed(plr: Player)
	local prof = profiles[plr]
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if prof and hum then
		hum.WalkSpeed = if os.clock() < prof.stunUntil then 0 else 22 * (1 + 0.08 * up(prof, "speed"))
	end
end

-- Recalcule la liste des pets équipés et la publie pour l'affichage chez tous les joueurs.
local function refreshEquipped(plr: Player)
	local prof = profiles[plr]
	if not prof then
		return
	end
	local eq = {}
	for _, p in prof.data.pets do
		if p.eq then
			table.insert(eq, p)
		end
	end
	table.sort(eq, function(a, b)
		return PetModels.power(a) > PetModels.power(b)
	end)
	prof.eq = eq
	local parts = {}
	for _, p in eq do
		table.insert(parts, string.format("%s:%d:%d", p.def, p.tier, p.shiny and 1 or 0))
	end
	plr:SetAttribute("PetsEquipped", table.concat(parts, "|"))
	prof.targets = {}
	prof.arrive = {}
	prof.full = true
end

local function toast(plr: Player, text: string, color: string?)
	Fx:FireClient(plr, "toast", { text = text, color = color })
end

local function addCoins(prof: Profile, v: number, track: boolean)
	prof.data.coins += v
	prof.data.totalCoins += v
	if track then
		prof.cpsAcc += v
	end
	prof.money = true
end

local function spend(plr: Player, prof: Profile, cost: number, gems: boolean): boolean
	local d = prof.data
	if gems then
		if d.gems < cost then
			toast(plr, "Pas assez de gemmes")
			return false
		end
		d.gems -= cost
	else
		if d.coins < cost then
			toast(plr, "Pas assez de pièces")
			return false
		end
		d.coins -= cost
	end
	prof.money = true
	prof.full = true
	return true
end

---------------------------------------------------------------------------
-- Quêtes
---------------------------------------------------------------------------
local function metric(prof: Profile, kind: string): number
	local d = prof.data
	local s = d.stats
	if kind == "piles" then
		return s.piles
	elseif kind == "hatch" then
		return s.hatched
	elseif kind == "equip" then
		return equippedCount(d)
	elseif kind == "coins" then
		return d.totalCoins
	elseif kind == "upgrade" then
		return s.upgrades
	elseif kind == "golden" then
		return s.golden
	elseif kind == "rainbow" then
		return s.rainbow
	elseif kind == "boss" then
		return s.bosses
	elseif kind == "world" then
		return d.maxWorld
	elseif kind == "rebirth" then
		return d.rebirths
	elseif kind == "taps" then
		return s.taps
	end
	return 0
end

local function questProgress(prof: Profile): (any, number)
	local q = Config.StarterQuests[prof.data.quest]
	if not q then
		return nil, 0
	end
	if Config.AbsoluteQuest[q.kind] then
		return q, metric(prof, q.kind)
	end
	return q, metric(prof, q.kind) - prof.data.questBase
end

local function roundNice(v: number): number
	local m = 1
	while v >= 100 do
		v /= 10
		m *= 10
	end
	return math.floor(v) * m
end

local function refreshDaily(prof: Profile)
	local d = prof.data
	local day = today()
	if d.dailyDay == day and #d.daily == 3 then
		return
	end
	d.dailyDay = day
	local seed = 0
	for i = 1, #day do
		seed = (seed * 31 + string.byte(day, i)) % 2147483647
	end
	local r = Random.new(seed)
	local kinds = { "piles", "hatch", "taps", "coins", "boss", "golden" }
	for i = #kinds, 2, -1 do
		local j = r:NextInteger(1, i)
		kinds[i], kinds[j] = kinds[j], kinds[i]
	end
	d.daily = {}
	for i = 1, 3 do
		local k = kinds[i]
		local target = 1
		if k == "piles" then
			target = 80 + r:NextInteger(0, 7) * 20
		elseif k == "hatch" then
			target = 15 + r:NextInteger(0, 4) * 5
		elseif k == "taps" then
			target = 150 + r:NextInteger(0, 5) * 50
		elseif k == "coins" then
			target = roundNice(math.max(5000, estimatedCps(prof) * 900))
		end
		table.insert(d.daily, { kind = k, target = target, base = metric(prof, k), gems = r:NextInteger(8, 15), claimed = false })
	end
	prof.full = true
end

local function indexCount(d): number
	local n = 0
	for _, id in Config.PetOrder do
		if d.discovered[id] then
			n += 1
		end
	end
	return n
end

---------------------------------------------------------------------------
-- Envoi de l'état aux joueurs
---------------------------------------------------------------------------
local function sendMoney(plr: Player)
	local prof = profiles[plr]
	if not prof then
		return
	end
	Fx:FireClient(plr, "money", { coins = prof.data.coins, gems = prof.data.gems, cps = prof.cps })
	prof.money = false
	local ls = plr:FindFirstChild("leaderstats")
	if ls then
		local c = ls:FindFirstChild("Pièces") :: StringValue?
		if c then
			c.Value = Config.fmt(prof.data.coins)
		end
		local r = ls:FindFirstChild("Rebirths") :: IntValue?
		if r then
			r.Value = prof.data.rebirths
		end
	end
end

local function sendState(plr: Player)
	local prof = profiles[plr]
	if not prof then
		return
	end
	local d = prof.data
	local pets = {}
	for _, p in d.pets do
		table.insert(pets, { uid = p.uid, def = p.def, tier = p.tier, shiny = p.shiny, lvl = p.lvl, xp = p.xp, eq = p.eq, lock = p.lock, bonus = p.bonus, power = PetModels.power(p) })
	end
	local q, qp = questProgress(prof)
	local daily = {}
	for _, dq in d.daily do
		table.insert(daily, { kind = dq.kind, target = dq.target, progress = metric(prof, dq.kind) - dq.base, gems = dq.gems, claimed = dq.claimed })
	end
	local passes = {}
	for _, ps in Config.Passes do
		passes[ps.id] = hasPass(prof, ps.id)
	end
	local giftNext = if d.giftDay == yesterday() then d.giftStreak % 7 + 1 else 1
	StateEvent:FireClient(plr, {
		coins = d.coins,
		gems = d.gems,
		totalCoins = d.totalCoins,
		rebirths = d.rebirths,
		world = d.world,
		maxWorld = d.maxWorld,
		pets = pets,
		discovered = d.discovered,
		upgrades = d.upgrades,
		passes = passes,
		potions = d.potions,
		quest = d.quest,
		questProgress = qp,
		questDone = q == nil,
		daily = daily,
		giftReady = d.giftDay ~= today(),
		giftNext = giftNext,
		giftStreak = d.giftStreak,
		giftCoins = roundNice(math.max(500, estimatedCps(prof) * 180)),
		indexClaim = d.indexClaim,
		indexCount = indexCount(d),
		stats = d.stats,
		autoCollect = d.autoCollect,
		autoDelete = d.autoDelete,
		slots = slots(prof),
		storage = storage(prof),
		dps = teamDps(prof),
		cps = prof.cps,
		coinMult = coinMult(prof),
		luck = luckMult(prof),
		tap = tapDamage(prof),
		rebirthCost = Config.rebirthCost(d.rebirths),
		autoHatch = prof.autoHatch,
		inBoss = prof.inBoss,
		canSave = prof.canSave,
	})
	prof.full = false
	sendMoney(plr)
end

---------------------------------------------------------------------------
-- Tas de bonbons
---------------------------------------------------------------------------
type Pile = {
	id: number,
	world: number,
	kind: number,
	hp: number,
	maxHp: number,
	pos: Vector3,
	model: Model,
	bar: Frame,
	bb: BillboardGui,
	contrib: { [Player]: number },
	dead: boolean,
	golden: boolean,
}

local piles: { [number]: Pile } = {}
local pileCount = { 0, 0, 0, 0 }
local nextPileId = 1
local PILE_SIZE = { 5, 8, 8 }
local CHEST_COLOR = { meadow = "FF8FB8", choco = "8A5A3C", ice = "7FD6FF", galaxy = "6B5BD6" }

local tapPile: (Player, Pile) -> ()

local function buildPileModel(w, kind: number, golden: boolean): (Model, BasePart)
	local model = Instance.new("Model")
	local s = PILE_SIZE[kind]
	local hit = part({ Parent = model, Name = "Hitbox", Size = Vector3.new(s + 1, s * 0.9, s + 1), Position = Vector3.new(0, s * 0.45, 0), Transparency = 1, CanCollide = false })
	model.PrimaryPart = hit
	local function col(): Color3
		local c = w.candy[rng:NextInteger(1, #w.candy)]
		if golden then
			c = c:Lerp(Color3.fromHex("FFD23F"), 0.75)
		end
		return c
	end
	if kind == 3 then
		local body = Color3.fromHex((CHEST_COLOR :: any)[w.theme])
		if golden then
			body = Color3.fromHex("FFD23F")
		end
		deco({ Parent = model, Size = Vector3.new(7, 4, 5), Position = Vector3.new(0, 2, 0), Color = body })
		deco({ Parent = model, Size = Vector3.new(7.4, 1.6, 5.4), Position = Vector3.new(0, 4.6, 0), Color = body:Lerp(Color3.new(1, 1, 1), 0.2) })
		deco({ Parent = model, Size = Vector3.new(1.2, 5.6, 5.6), Position = Vector3.new(0, 2.8, 0), Color = Color3.fromHex("FFD54A") })
		deco({ Parent = model, Size = Vector3.new(1.6, 1.6, 0.6), Position = Vector3.new(0, 3.2, -2.8), Color = Color3.fromHex("FFD54A") })
	else
		local layout = if kind == 1
			then { Vector3.new(-1.1, 0, 0.5), Vector3.new(1.1, 0, 0.5), Vector3.new(0, 1.4, -0.3) }
			else { Vector3.new(-2, 0, 0.8), Vector3.new(0, 0, 1.2), Vector3.new(2, 0, 0.8), Vector3.new(-1, 1.7, 0), Vector3.new(1, 1.7, 0), Vector3.new(0, 3.2, -0.2) }
		local r = kind == 1 and 1.5 or 1.8
		for _, p in layout do
			if w.theme == "choco" then
				deco({ Parent = model, Size = Vector3.new(r * 1.8, r * 0.9, r * 1.3), CFrame = CFrame.new(p + Vector3.new(0, r * 0.45, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = col() })
			elseif w.theme == "galaxy" then
				deco({ Parent = model, Size = Vector3.one * r * 1.8, Position = p + Vector3.new(0, r * 0.9, 0), Shape = Enum.PartType.Ball, Color = col(), Material = Enum.Material.Neon, Transparency = 0.15 })
			else
				deco({ Parent = model, Size = Vector3.one * r * 2, Position = p + Vector3.new(0, r * 0.8, 0), Shape = Enum.PartType.Ball, Color = col() })
			end
		end
	end
	if golden then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromHex("FFF6C8")
		sp.Parent = hit
	end
	return model, hit
end

local function spawnPile(wi: number)
	local w = Config.Worlds[wi]
	local o = w.origin
	for _ = 1, 15 do
		local pos = o + Vector3.new(rng:NextNumber(-FIELD_X, FIELD_X), 0, rng:NextNumber(FIELD_Z0, FIELD_Z1))
		if (pos - (o + Vector3.new(0, 0, 30))).Magnitude < 12 then
			continue
		end
		local ok = true
		for _, p in piles do
			if p.world == wi and (p.pos - pos).Magnitude < 11 then
				ok = false
				break
			end
		end
		if not ok then
			continue
		end
		local roll = rng:NextNumber()
		local kind = if roll < 0.06 then 3 elseif roll < 0.36 then 2 else 1
		local golden = rng:NextNumber() < 0.01
		local hp = Config.PILE_HP[kind] * w.scale * rng:NextNumber(0.85, 1.15) * (golden and 3 or 1)
		local model, hit = buildPileModel(w, kind, golden)
		local id = nextPileId
		nextPileId += 1
		model.Name = tostring(id)
		model:SetAttribute("World", wi)
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))

		local bb = billboard(hit, Vector3.new(0, PILE_SIZE[kind] + 1, 0), UDim2.fromOffset(90, 14), 80)
		bb.Enabled = false
		local back = Instance.new("Frame")
		back.Size = UDim2.fromScale(1, 1)
		back.BackgroundColor3 = Color3.new(1, 1, 1)
		back.BorderSizePixel = 0
		local c1 = Instance.new("UICorner")
		c1.CornerRadius = UDim.new(1, 0)
		c1.Parent = back
		local st = Instance.new("UIStroke")
		st.Thickness = 2
		st.Color = INK
		st.Parent = back
		back.Parent = bb
		local bar = Instance.new("Frame")
		bar.Size = UDim2.fromScale(1, 1)
		bar.BackgroundColor3 = Color3.fromHex("3DD68C")
		bar.BorderSizePixel = 0
		local c2 = Instance.new("UICorner")
		c2.CornerRadius = UDim.new(1, 0)
		c2.Parent = bar
		bar.Parent = back

		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 70
		cd.Parent = hit

		local pile: Pile = { id = id, world = wi, kind = kind, hp = hp, maxHp = hp, pos = pos, model = model, bar = bar, bb = bb, contrib = {}, dead = false, golden = golden }
		piles[id] = pile
		pileCount[wi] += 1
		model.Parent = pileFolder
		cd.MouseClick:Connect(function(plr: Player)
			tapPile(plr, pile)
		end)
		return
	end
end

local function breakPile(pile: Pile)
	pile.dead = true
	pileCount[pile.world] -= 1
	piles[pile.id] = nil
	local total = 0
	for _, v in pile.contrib do
		total += v
	end
	for plr, dmg in pile.contrib do
		local prof = profiles[plr]
		if not prof or not plr.Parent then
			continue
		end
		local share = dmg / math.max(total, 1)
		local value = pile.maxHp * coinPerHP(pile.world) * coinMult(prof) * share
		if pile.golden then
			value *= 5
		end
		if rng:NextNumber() < 0.01 * up(prof, "golden") then
			value *= 5
		end
		addCoins(prof, value, true)
		local gems = 0
		if pile.kind == 3 and share > 0.3 and rng:NextNumber() < 0.25 then
			gems = rng:NextInteger(1, 3)
			prof.data.gems += gems
		end
		if share >= 0.15 then
			prof.data.stats.piles += 1
		end
		Fx:FireClient(plr, "coins", { pos = pile.pos, amount = value, gems = gems })
	end
	Fx:FireAllClients("break", { pos = pile.pos, world = pile.world })
	pile.model:Destroy()
end

local function damagePile(pile: Pile, plr: Player, amount: number)
	if pile.dead then
		return
	end
	pile.hp -= amount
	pile.contrib[plr] = (pile.contrib[plr] or 0) + amount
	if pile.hp <= 0 then
		breakPile(pile)
	else
		pile.bb.Enabled = true
		pile.bar.Size = UDim2.fromScale(math.clamp(pile.hp / pile.maxHp, 0.02, 1), 1)
	end
end

local function nextCombo(prof: Profile, now: number)
	if now < prof.comboT then
		prof.combo = math.min(prof.combo + 1, 50)
	else
		prof.combo = 1
	end
	prof.comboT = now + 0.9
end

tapPile = function(plr: Player, pile: Pile)
	local prof = profiles[plr]
	if not prof or pile.dead or prof.inBoss then
		return
	end
	local now = os.clock()
	if now - prof.lastTap < 0.08 or pile.world ~= prof.data.world then
		return
	end
	prof.lastTap = now
	nextCombo(prof, now)
	local dmg = tapDamage(prof) * (1 + 0.04 * (prof.combo - 1))
	local crit = rng:NextNumber() < 0.08 + 0.02 * up(prof, "crit")
	if crit then
		dmg *= 3
	end
	prof.data.stats.taps += 1
	prof.data.stats.bestHit = math.max(prof.data.stats.bestHit, dmg)
	prof.focus = pile.id
	Fx:FireClient(plr, "tap", { pos = pile.pos + Vector3.new(0, PILE_SIZE[pile.kind], 0), dmg = dmg, crit = crit, combo = prof.combo })
	damagePile(pile, plr, dmg)
end

for wi = 1, #Config.Worlds do
	for _ = 1, 24 do
		spawnPile(wi)
	end
end

---------------------------------------------------------------------------
-- Œufs
---------------------------------------------------------------------------
local function hrpOf(plr: Player): BasePart?
	local char = plr.Character
	return if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end

local function eggWeights(prof: Profile, egg): ({ number }, number)
	local luck = luckMult(prof)
	local total = 0
	local weights = {}
	for i, e in egg.pets do
		local wgt = e.chance
		if Config.Pets[e.pet].rarity >= Config.RARE then
			wgt *= luck
		end
		weights[i] = wgt
		total += wgt
	end
	return weights, total
end

local function realChance(prof: Profile, egg, petId: string): number
	local weights, total = eggWeights(prof, egg)
	for i, e in egg.pets do
		if e.pet == petId then
			return weights[i] / total * 100
		end
	end
	return 0
end

local function rollPet(prof: Profile, egg): string
	local weights, total = eggWeights(prof, egg)
	local r = rng:NextNumber() * total
	for i, e in egg.pets do
		r -= weights[i]
		if r <= 0 then
			return e.pet
		end
	end
	return egg.pets[1].pet
end

local function hatch(plr: Player, eggId: string, auto: boolean): boolean
	local prof = profiles[plr]
	local egg = Config.Eggs[eggId]
	if not prof or not egg then
		return false
	end
	local d = prof.data
	local now = os.clock()
	if now - prof.lastHatch < (auto and 2.4 or 1.0) then
		return false
	end
	local hrp = hrpOf(plr)
	local stand = eggStands[eggId]
	if not hrp or not stand or (hrp.Position - stand).Magnitude > 24 then
		return false
	end
	local n = 1
	if hasPass(prof, "triple") and d.coins >= egg.price * 3 then
		n = 3
	end
	local free = storage(prof) - #d.pets
	if free <= 0 then
		toast(plr, "Inventaire plein ! Supprime ou fusionne des pets.", "FF5A6E")
		prof.autoHatch = nil
		prof.full = true
		return false
	end
	n = math.min(n, free)
	if d.coins < egg.price * n then
		toast(plr, "Il te faut " .. Config.fmt(egg.price) .. " pièces")
		prof.autoHatch = nil
		prof.full = true
		return false
	end
	prof.lastHatch = now
	d.coins -= egg.price * n
	local results = {}
	for _ = 1, n do
		local petId = rollPet(prof, egg)
		local def = Config.Pets[petId]
		local isNew = not d.discovered[petId]
		local shiny = rng:NextNumber() < 1 / 200
		d.stats.hatched += 1
		local entry = { def = petId, shiny = shiny, new = isNew, deleted = false, power = def.power * (shiny and 1.5 or 1), chance = realChance(prof, egg, petId) }
		if def.rarity <= d.autoDelete and not shiny and not isNew then
			entry.deleted = true
		else
			local p = addPet(d, petId, 0, shiny)
			if equippedCount(d) < slots(prof) then
				p.eq = true
			end
		end
		table.insert(results, entry)
		if def.rarity >= Config.DIVINE then
			Fx:FireAllClients("toast", { text = "✨ " .. plr.DisplayName .. " a obtenu le pet DIVIN " .. def.name .. " ! ✨", color = "FFC93C" })
		elseif def.rarity >= Config.LEGENDARY then
			Fx:FireAllClients("toast", { text = plr.DisplayName .. " a obtenu " .. def.name .. " (" .. Config.Rarities[def.rarity].name .. ") !", color = if def.rarity >= Config.MYTHIC then "FF4F8B" else "FFB020" })
		end
	end
	refreshEquipped(plr)
	Fx:FireClient(plr, "hatch", { egg = eggId, results = results, auto = auto })
	return true
end

---------------------------------------------------------------------------
-- Boss Gummy Golem
---------------------------------------------------------------------------
local boss = {
	state = "idle",
	timer = 300,
	hp = 0,
	maxHp = 0,
	ends = 0,
	model = nil :: Model?,
	weak = nil :: BasePart?,
	weakT = 0,
	slamT = 0,
	warn = nil :: BasePart?,
	warnT = 0,
	dmg = {} :: { [Player]: number },
}

local function bossTap(plr: Player, weak: boolean)
	local prof = profiles[plr]
	if not prof or not prof.inBoss or boss.state ~= "open" then
		return
	end
	local now = os.clock()
	if now < prof.stunUntil or now - prof.lastTap < 0.08 then
		return
	end
	prof.lastTap = now
	nextCombo(prof, now)
	local dmg = tapDamage(prof) * (1 + 0.04 * (prof.combo - 1))
	local crit = rng:NextNumber() < 0.08 + 0.02 * up(prof, "crit")
	if weak then
		dmg *= 3
	end
	if crit then
		dmg *= 3
	end
	prof.data.stats.taps += 1
	boss.hp -= dmg
	boss.dmg[plr] = (boss.dmg[plr] or 0) + dmg
	local pos = if weak and boss.weak then boss.weak.Position else GOLEM_POS + Vector3.new(0, 16, 0)
	Fx:FireClient(plr, "tap", { pos = pos, dmg = dmg, crit = crit, weak = weak, combo = prof.combo })
end

local function spawnBoss()
	boss.state = "open"
	boss.ends = os.clock() + Config.BOSS_WINDOW + Config.BOSS_FIGHT
	boss.dmg = {}
	boss.maxHp = 3000
	boss.hp = boss.maxHp
	local model = PetModels.build("gummy_golem", 0, false, 9)
	model.Name = "GummyGolem"
	model:PivotTo(CFrame.new(GOLEM_POS + Vector3.new(0, 8.6, 0)))
	local hit = part({ Parent = model, Name = "Hitbox", Size = Vector3.new(19, 18, 17), Position = GOLEM_POS + Vector3.new(0, 8.6, 0), Transparency = 1 })
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 120
	cd.Parent = hit
	cd.MouseClick:Connect(function(plr)
		bossTap(plr, false)
	end)
	local weak = part({ Parent = model, Name = "Weak", Size = Vector3.one * 3.4, Shape = Enum.PartType.Ball, Position = GOLEM_POS + Vector3.new(4, 12, -9), Color = Color3.fromHex("FFD54A"), Material = Enum.Material.Neon, CanCollide = false })
	local wcd = Instance.new("ClickDetector")
	wcd.MaxActivationDistance = 120
	wcd.Parent = weak
	wcd.MouseClick:Connect(function(plr)
		bossTap(plr, true)
	end)
	boss.weak = weak
	boss.weakT = 4
	boss.slamT = 6
	model.Parent = arena
	boss.model = model
	workspace:SetAttribute("BossState", "open")
	Fx:FireAllClients("toast", { text = "Le Gummy Golem est apparu ! Va le combattre !", color = "FF5A6E" })
end

local function leaveBoss(plr: Player)
	local prof = profiles[plr]
	if not prof or not prof.inBoss then
		return
	end
	prof.inBoss = false
	plr:SetAttribute("InBoss", false)
	refreshEquipped(plr)
	local char = plr.Character
	if char then
		char:PivotTo(worldSpawn(prof.data.world))
	end
end

local function endBoss(win: boolean)
	local total = 0
	for _, v in boss.dmg do
		total += v
	end
	for plr, prof in profiles do
		if not prof.inBoss then
			continue
		end
		local d = prof.data
		local share = (boss.dmg[plr] or 0) / math.max(total, 1)
		local coins, gems = 0, 0
		local text
		if win then
			d.stats.bosses += 1
			d.bossWins += 1
			coins = math.max(1000, estimatedCps(prof) * 90)
			gems = 15 + 5 * d.rebirths
			text = "Tu gagnes " .. Config.fmt(coins) .. " pièces et " .. gems .. " gemmes."
			if share > 0 and (d.bossWins == 1 or rng:NextNumber() < 0.2) and #d.pets < storage(prof) then
				local best = 0
				for _, p in d.pets do
					best = math.max(best, PetModels.power(p))
				end
				local g = addPet(d, "gummy_golem", 0, rng:NextNumber() < 0.1)
				g.bonus = math.max(50, best * 2.5)
				if equippedCount(d) < slots(prof) then
					g.eq = true
				end
				text ..= " Le Gummy Golem rejoint ton équipe (puissance " .. Config.fmt(PetModels.power(g)) .. ") !"
			end
		else
			coins = math.floor(math.max(200, estimatedCps(prof) * 30) * (1 - boss.hp / boss.maxHp))
			text = "Le golem s'est enfui… Tu récupères " .. Config.fmt(coins) .. " pièces. Améliore tes pets et reviens !"
		end
		addCoins(prof, coins, false)
		d.gems += gems
		prof.full = true
		Fx:FireClient(plr, "popup", { title = if win then "VICTOIRE !" else "Temps écoulé", body = text })
		task.delay(3, function()
			if plr.Parent then
				leaveBoss(plr)
			end
		end)
	end
	if boss.model then
		boss.model:Destroy()
	end
	if boss.warn then
		boss.warn:Destroy()
	end
	boss.model, boss.weak, boss.warn = nil, nil, nil
	boss.state = "idle"
	boss.timer = Config.BOSS_INTERVAL
	workspace:SetAttribute("BossState", "idle")
end

local function joinBoss(plr: Player)
	local prof = profiles[plr]
	if not prof or boss.state ~= "open" or prof.inBoss then
		return
	end
	local char = plr.Character
	if not char then
		return
	end
	prof.inBoss = true
	prof.autoHatch = nil
	plr:SetAttribute("InBoss", true)
	-- les PV du golem s'adaptent à chaque combattant qui arrive
	local extra = teamDps(prof) * 40 + tapDamage(prof) * 40
	boss.maxHp += extra
	boss.hp += extra
	char:PivotTo(ARENA_SPAWN)
	prof.full = true
end

local function updateBoss(dt: number)
	if boss.state == "idle" then
		boss.timer -= dt
		workspace:SetAttribute("BossTime", boss.timer)
		if boss.timer <= 0 then
			spawnBoss()
		end
		return
	end
	local now = os.clock()
	workspace:SetAttribute("BossTime", boss.ends - now)
	workspace:SetAttribute("BossHP", math.max(0, boss.hp))
	workspace:SetAttribute("BossMax", boss.maxHp)
	local fighters = {}
	for plr, prof in profiles do
		if prof.inBoss then
			table.insert(fighters, plr)
		end
	end
	-- point faible qui bouge
	boss.weakT -= dt
	if boss.weakT <= 0 and boss.weak then
		boss.weakT = 4
		local a = rng:NextNumber(0, math.pi * 2)
		boss.weak.Position = GOLEM_POS + Vector3.new(math.cos(a) * 6, 10 + math.sin(a) * 4, -9)
	end
	-- attaque « écrasement » sur un joueur au hasard
	if #fighters > 0 then
		boss.slamT -= dt
		if boss.slamT <= 0 and not boss.warn then
			local target = fighters[rng:NextInteger(1, #fighters)]
			local hrp = hrpOf(target)
			if hrp then
				local pos = Vector3.new(hrp.Position.X, BO.Y + 0.2, hrp.Position.Z)
				boss.warn = deco({ Parent = arena, Size = Vector3.new(0.3, 28, 28), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Shape = Enum.PartType.Cylinder, Color = Color3.fromHex("FF3355"), Material = Enum.Material.Neon, Transparency = 0.5 })
				boss.warnT = 1.5
			end
			boss.slamT = rng:NextNumber(5, 7)
		end
		local warnPart = boss.warn
		if warnPart then
			boss.warnT -= dt
			if boss.warnT <= 0 then
				local center = warnPart.Position
				warnPart:Destroy()
				boss.warn = nil
				Fx:FireAllClients("slam", { pos = center })
				for _, plr in fighters do
					local hrp = hrpOf(plr)
					local prof = profiles[plr]
					if hrp and prof and (Vector3.new(hrp.Position.X, center.Y, hrp.Position.Z) - center).Magnitude < 14 then
						prof.stunUntil = os.clock() + 2
						prof.combo = 0
						setWalkSpeed(plr)
						Fx:FireClient(plr, "stun", {})
					end
				end
			end
		end
	end
	if boss.hp <= 0 then
		endBoss(true)
	elseif now >= boss.ends then
		endBoss(false)
	end
end

---------------------------------------------------------------------------
-- Boucle des pets (dégâts, cibles, expérience)
---------------------------------------------------------------------------
local PET_TICK = 0.2

local function petTick()
	local assigned: { [number]: number } = {}
	for _, prof in profiles do
		for _, id in prof.targets do
			assigned[id] = (assigned[id] or 0) + 1
		end
	end
	local now = os.clock()
	for plr, prof in profiles do
		local hrp = hrpOf(plr)
		if not hrp then
			continue
		end
		local d = prof.data
		local mult = damageMult(prof)
		local function gainXp(p)
			if p.lvl < 25 then
				p.xp += PET_TICK
				local need = 25 + 15 * p.lvl
				if p.xp >= need then
					p.xp -= need
					p.lvl += 1
					prof.full = true
					Fx:FireClient(plr, "levelup", { name = Config.Pets[p.def].name, lvl = p.lvl })
				end
			end
		end
		if prof.inBoss then
			if boss.state == "open" then
				for _, p in prof.eq do
					local dmg = PetModels.power(p) * mult * PET_TICK
					boss.hp -= dmg
					boss.dmg[plr] = (boss.dmg[plr] or 0) + dmg
					gainXp(p)
				end
			end
			continue
		end
		local focus = if prof.focus then piles[prof.focus] else nil
		if focus and (focus.dead or focus.world ~= d.world or (focus.pos - hrp.Position).Magnitude > 120) then
			focus = nil
			prof.focus = nil
		end
		local strs = {}
		for slot, p in prof.eq do
			local tid = prof.targets[slot]
			local t = if tid then piles[tid] else nil
			if t and (t.dead or t.world ~= d.world or (t.pos - hrp.Position).Magnitude > 120) then
				t = nil
			end
			if focus then
				t = focus
			elseif not t and d.autoCollect then
				local best, bd = nil, 50
				for _, pile in piles do
					if pile.world == d.world and (assigned[pile.id] or 0) < 2 then
						local dist = (pile.pos - hrp.Position).Magnitude
						if dist < bd then
							best, bd = pile, dist
						end
					end
				end
				t = best
				if t then
					assigned[t.id] = (assigned[t.id] or 0) + 1
				end
			end
			local newId = if t then t.id else nil
			if newId ~= prof.targets[slot] then
				prof.targets[slot] = newId :: any
				prof.arrive[slot] = now + (if t then (t.pos - hrp.Position).Magnitude / 45 else 0)
			end
			table.insert(strs, tostring(newId or 0))
			if t and now >= (prof.arrive[slot] or 0) then
				damagePile(t, plr, PetModels.power(p) * mult * PET_TICK)
				gainXp(p)
			end
		end
		local s = table.concat(strs, ",")
		if s ~= prof.targetStr then
			prof.targetStr = s
			plr:SetAttribute("PetTargets", s)
		end
	end
end

---------------------------------------------------------------------------
-- Actions des joueurs
---------------------------------------------------------------------------
local handlers: { [string]: (Player, Profile, any) -> () } = {}

handlers.equip = function(plr, prof, uid)
	local p = findPet(prof.data, uid)
	if not p then
		return
	end
	if p.eq then
		p.eq = false
	elseif equippedCount(prof.data) < slots(prof) then
		p.eq = true
	else
		toast(plr, "Tous tes emplacements sont pleins")
		return
	end
	refreshEquipped(plr)
end

handlers.equipBest = function(plr, prof)
	local list = table.clone(prof.data.pets)
	table.sort(list, function(a, b)
		return PetModels.power(a) > PetModels.power(b)
	end)
	for i, p in list do
		p.eq = i <= slots(prof)
	end
	refreshEquipped(plr)
end

handlers.lock = function(plr, prof, uid)
	local p = findPet(prof.data, uid)
	if p then
		p.lock = not p.lock
		prof.full = true
	end
end

handlers.delete = function(plr, prof, uid)
	local p = findPet(prof.data, uid)
	if p and not p.lock then
		removePets(prof.data, { [p.uid] = true })
		refreshEquipped(plr)
	end
end

local function junk(prof: Profile): { [number]: boolean }
	local limit = math.max(Config.UNCOMMON, prof.data.autoDelete)
	local out = {}
	for _, p in prof.data.pets do
		if not p.eq and not p.lock and p.tier == 0 and not p.shiny and (p.bonus or 0) == 0 and Config.Pets[p.def].rarity <= limit then
			out[p.uid] = true
		end
	end
	return out
end

handlers.deleteJunk = function(plr, prof)
	removePets(prof.data, junk(prof))
	refreshEquipped(plr)
end

handlers.autoDelete = function(plr, prof, n)
	if type(n) == "number" and n >= 0 and n <= Config.RARE then
		prof.data.autoDelete = math.floor(n)
		prof.full = true
	end
end

handlers.autoCollect = function(plr, prof, on)
	prof.data.autoCollect = on == true
	prof.full = true
end

handlers.fuse = function(plr, prof, uid)
	local d = prof.data
	local p = findPet(d, uid)
	if not p or p.tier >= 2 or (p.bonus or 0) > 0 then
		return
	end
	local others = {}
	for _, o in d.pets do
		if o.uid ~= p.uid and o.def == p.def and o.tier == p.tier and not o.lock and (o.bonus or 0) == 0 then
			table.insert(others, o)
		end
	end
	if #others < 4 then
		toast(plr, "Il faut 5 pets identiques")
		return
	end
	-- on garde en priorité les pets équipés hors de la fusion
	table.sort(others, function(a, b)
		return (not a.eq) and b.eq
	end)
	local group = { p, others[1], others[2], others[3], others[4] }
	local rm, wasEq, shiny = {}, false, false
	for _, g in group do
		rm[g.uid] = true
		wasEq = wasEq or g.eq
		shiny = shiny or g.shiny
	end
	removePets(d, rm)
	local np = addPet(d, p.def, p.tier + 1, shiny)
	np.eq = wasEq
	if np.tier == 1 then
		d.stats.golden += 1
		toast(plr, Config.Pets[p.def].name .. " doré obtenu !", "FFD54A")
	else
		d.stats.rainbow += 1
		toast(plr, Config.Pets[p.def].name .. " arc-en-ciel obtenu !", "FF8FB8")
	end
	refreshEquipped(plr)
	Fx:FireClient(plr, "fused", { uid = np.uid })
end

handlers.hatch = function(plr, prof, eggId)
	if type(eggId) == "string" then
		hatch(plr, eggId, false)
	end
end

handlers.autoHatch = function(plr, prof, eggId)
	if type(eggId) == "string" and Config.Eggs[eggId] and hasPass(prof, "auto") then
		prof.autoHatch = eggId
	else
		prof.autoHatch = nil
	end
	prof.full = true
end

handlers.upgrade = function(plr, prof, id)
	for _, u in Config.Upgrades do
		if u.id == id then
			local lvl = up(prof, id)
			if lvl >= u.max then
				return
			end
			if spend(plr, prof, Config.upgradeCost(u, lvl), u.gem) then
				prof.data.upgrades[id] = lvl + 1
				prof.data.stats.upgrades += 1
				setWalkSpeed(plr)
				Fx:FireClient(plr, "bought", {})
				if id == "slot" then
					refreshEquipped(plr)
				end
			end
			return
		end
	end
end

handlers.potion = function(plr, prof, id)
	for _, p in Config.Potions do
		if p.id == id and spend(plr, prof, p.gems, true) then
			prof.data.potions[id] = (prof.data.potions[id] or 0) + Config.POTION_TIME
			Fx:FireClient(plr, "bought", {})
		end
	end
end

handlers.pass = function(plr, prof, id)
	for _, p in Config.Passes do
		if p.id == id and not hasPass(prof, id) and (Config.GamePassIds :: any)[id] == 0 then
			if spend(plr, prof, p.gems, true) then
				prof.data.passes[id] = true
				toast(plr, "Pass " .. p.name .. " activé !", "3DD68C")
				refreshEquipped(plr)
				Fx:FireClient(plr, "bought", {})
			end
		end
	end
end

local function teleport(plr: Player, prof: Profile, w: number)
	prof.data.world = w
	prof.focus = nil
	prof.autoHatch = nil
	local char = plr.Character
	if char then
		char:PivotTo(worldSpawn(w))
	end
	refreshEquipped(plr)
end

handlers.unlock = function(plr, prof)
	local d = prof.data
	local nextW = Config.Worlds[d.maxWorld + 1]
	if not nextW then
		return
	end
	if spend(plr, prof, nextW.unlock, false) then
		d.maxWorld += 1
		toast(plr, nextW.name .. " débloqué !", "FFD54A")
		teleport(plr, prof, d.maxWorld)
	end
end

handlers.teleport = function(plr, prof, w)
	if type(w) == "number" and w >= 1 and w <= prof.data.maxWorld and not prof.inBoss then
		teleport(plr, prof, math.floor(w))
	end
end

handlers.rebirth = function(plr, prof)
	local d = prof.data
	local cost = Config.rebirthCost(d.rebirths)
	if d.coins < cost or prof.inBoss then
		return
	end
	d.rebirths += 1
	d.coins = 0
	d.maxWorld = 1
	d.gems += 10 * d.rebirths
	teleport(plr, prof, 1)
	prof.money = true
	Fx:FireClient(plr, "rebirth", { n = d.rebirths, mult = Config.rebirthMult(d.rebirths) })
end

handlers.quest = function(plr, prof)
	local q, prog = questProgress(prof)
	if not q or prog < q.goal then
		return
	end
	local d = prof.data
	addCoins(prof, q.coins, false)
	d.gems += q.gems
	d.quest += 1
	local nq = Config.StarterQuests[d.quest]
	if nq then
		d.questBase = metric(prof, nq.kind)
	end
	prof.full = true
	Fx:FireClient(plr, "claimed", {})
end

handlers.daily = function(plr, prof, i)
	local dq = if type(i) == "number" then prof.data.daily[i] else nil
	if dq and not dq.claimed and metric(prof, dq.kind) - dq.base >= dq.target then
		dq.claimed = true
		prof.data.gems += dq.gems
		prof.full = true
		Fx:FireClient(plr, "claimed", {})
	end
end

handlers.gift = function(plr, prof)
	local d = prof.data
	if d.giftDay == today() then
		return
	end
	local day = if d.giftDay == yesterday() then d.giftStreak % 7 + 1 else 1
	if day == 1 then
		addCoins(prof, roundNice(math.max(500, estimatedCps(prof) * 180)), false)
	elseif day == 2 then
		d.gems += 10
	elseif day == 3 then
		d.potions.coins = (d.potions.coins or 0) + Config.POTION_TIME
	elseif day == 4 then
		d.gems += 15
	elseif day == 5 then
		d.potions.luck = (d.potions.luck or 0) + Config.POTION_TIME
	elseif day == 6 then
		d.gems += 25
	else
		d.gems += 50
		d.potions.dmg = (d.potions.dmg or 0) + Config.POTION_TIME
	end
	d.giftDay = today()
	d.giftStreak = day
	prof.full = true
	Fx:FireClient(plr, "claimed", {})
end

handlers.index = function(plr, prof)
	local d = prof.data
	local m = Config.IndexMilestones[d.indexClaim + 1]
	if m and indexCount(d) >= math.min(m.need, #Config.PetOrder) then
		d.indexClaim += 1
		d.gems += m.gems
		prof.full = true
		Fx:FireClient(plr, "claimed", {})
	end
end

handlers.joinBoss = function(plr, prof)
	joinBoss(plr)
end

handlers.leaveBoss = function(plr, prof)
	leaveBoss(plr)
end

Action.OnServerEvent:Connect(function(plr: Player, name: any, arg: any)
	local prof = profiles[plr]
	if not prof or type(name) ~= "string" then
		return
	end
	local h = handlers[name]
	if h then
		local ok, err = pcall(h, plr, prof, arg)
		if not ok then
			warn("[SweetPets] action", name, err)
		end
	end
end)

-- Invites de proximité : œufs et panneaux
for _, pr in prompts do
	pr.Triggered:Connect(function(plr)
		local kind = pr:GetAttribute("Kind")
		local value = pr:GetAttribute("Value") :: string
		if kind == "egg" then
			hatch(plr, value, false)
		else
			Fx:FireClient(plr, "panel", { name = value })
		end
	end)
end

---------------------------------------------------------------------------
-- Robux (si configurés dans Config)
---------------------------------------------------------------------------
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, passId, bought)
	if not bought then
		return
	end
	local prof = profiles[plr]
	if not prof then
		return
	end
	for id, gid in Config.GamePassIds :: any do
		if gid ~= 0 and gid == passId then
			prof.robux[id] = true
			toast(plr, "Merci ! Pass activé.", "3DD68C")
			refreshEquipped(plr)
		end
	end
end)

MarketplaceService.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	local prof = if plr then profiles[plr] else nil
	if not plr or not prof then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	for _, prod in Config.GemProducts do
		if prod.id ~= 0 and prod.id == info.ProductId then
			prof.data.gems += prod.gems
			prof.full = true
			toast(plr, "+" .. prod.gems .. " gemmes, merci !", "7FD6FF")
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

---------------------------------------------------------------------------
-- Connexion / déconnexion / sauvegarde
---------------------------------------------------------------------------
local function save(plr: Player)
	local prof = profiles[plr]
	local ds = store
	if not prof or not prof.canSave or not ds then
		return
	end
	prof.data.lastSeen = os.time()
	local ok, err = pcall(function()
		ds:SetAsync("p_" .. plr.UserId, prof.data)
	end)
	if not ok then
		warn("[SweetPets] sauvegarde impossible :", err)
	end
end

local function onCharacter(plr: Player, char: Model)
	local prof = profiles[plr]
	if not prof then
		return
	end
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hrp or not hum then
		return
	end
	prof.inBoss = false
	prof.stunUntil = 0
	plr:SetAttribute("InBoss", false)
	task.wait(0.1)
	char:PivotTo(worldSpawn(prof.data.world))
	setWalkSpeed(plr)
	refreshEquipped(plr)
end

local function onPlayer(plr: Player)
	local data = nil
	local canSave = true
	local ds = store
	if ds then
		local ok, result = false, nil
		for _ = 1, 3 do
			ok, result = pcall(function()
				return ds:GetAsync("p_" .. plr.UserId)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
		if ok then
			data = result
		else
			-- on ne sauvegarde pas pour ne pas écraser une partie qu'on n'a pas pu lire
			canSave = false
			warn("[SweetPets] chargement impossible, partie temporaire :", result)
		end
	else
		canSave = false
	end
	if type(data) ~= "table" then
		data = defaultData()
	else
		reconcile(data, defaultData())
	end
	if not plr.Parent then
		return
	end
	local prof: Profile = {
		data = data,
		canSave = canSave,
		full = true,
		money = true,
		focus = nil,
		targets = {},
		arrive = {},
		eq = {},
		lastTap = 0,
		combo = 0,
		comboT = 0,
		lastHatch = 0,
		autoHatch = nil,
		stunUntil = 0,
		inBoss = false,
		robux = {},
		cpsAcc = 0,
		cpsHist = {},
		cps = 0,
		targetStr = "",
	}
	profiles[plr] = prof
	if data.world > data.maxWorld then
		data.world = data.maxWorld
	end
	for id, gid in Config.GamePassIds :: any do
		if gid ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(plr.UserId, gid)
			end)
			if ok and owns then
				prof.robux[id] = true
			end
		end
	end

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local c = Instance.new("StringValue")
	c.Name = "Pièces"
	c.Parent = ls
	local r = Instance.new("IntValue")
	r.Name = "Rebirths"
	r.Parent = ls
	ls.Parent = plr

	refreshDaily(prof)
	refreshEquipped(plr)

	-- gains hors ligne
	if data.lastSeen > 0 then
		local away = os.time() - data.lastSeen
		if away > 120 then
			local capped = math.min(away, 8 * 3600)
			local earn = math.floor(estimatedCps(prof) * capped * 0.25)
			if earn > 0 then
				addCoins(prof, earn, false)
				task.delay(4, function()
					Fx:FireClient(plr, "popup", { title = "Bon retour !", body = "Pendant ton absence (" .. Config.fmtTime(capped) .. "), tes pets ont récolté " .. Config.fmt(earn) .. " pièces." })
				end)
			end
		end
	end

	plr.CharacterAdded:Connect(function(char)
		onCharacter(plr, char)
	end)
	if plr.Character then
		task.spawn(onCharacter, plr, plr.Character)
	end
	sendState(plr)
end

Players.PlayerAdded:Connect(onPlayer)
for _, plr in Players:GetPlayers() do
	task.spawn(onPlayer, plr)
end

Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	profiles[plr] = nil
end)

game:BindToClose(function()
	for plr in profiles do
		task.spawn(save, plr)
	end
	task.wait(if RunService:IsStudio() then 1 else 3)
end)

---------------------------------------------------------------------------
-- Boucles
---------------------------------------------------------------------------
local acc, secAcc, spawnAcc, saveAcc = 0, 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	secAcc += dt
	spawnAcc += dt
	saveAcc += dt
	if acc >= PET_TICK then
		acc -= PET_TICK
		petTick()
		updateBoss(PET_TICK)
		for plr, prof in profiles do
			-- auto-éclosion
			local auto = prof.autoHatch
			if auto then
				local stand = eggStands[auto]
				local hrp = hrpOf(plr)
				if not stand or not hrp or (hrp.Position - stand).Magnitude > 24 or prof.inBoss then
					prof.autoHatch = nil
					prof.full = true
				else
					hatch(plr, auto, true)
				end
			end
			if prof.full then
				sendState(plr)
			elseif prof.money then
				sendMoney(plr)
			end
		end
	end
	if spawnAcc >= 0.5 then
		spawnAcc = 0
		for wi = 1, #Config.Worlds do
			if pileCount[wi] < 26 then
				spawnPile(wi)
			end
		end
	end
	if secAcc >= 1 then
		secAcc -= 1
		for plr, prof in profiles do
			local d = prof.data
			d.stats.play += 1
			for id, left in d.potions do
				if left > 0 then
					d.potions[id] = left - 1
					if d.potions[id] <= 0 then
						d.potions[id] = nil
						toast(plr, "Une potion vient de se terminer")
						prof.full = true
					end
				end
			end
			table.insert(prof.cpsHist, prof.cpsAcc)
			prof.cpsAcc = 0
			if #prof.cpsHist > 10 then
				table.remove(prof.cpsHist, 1)
			end
			local sum = 0
			for _, v in prof.cpsHist do
				sum += v
			end
			prof.cps = sum / #prof.cpsHist
			if d.dailyDay ~= today() then
				refreshDaily(prof)
			end
			-- les quêtes dépendent de compteurs : on rafraîchit l'état toutes les 2 s
			if d.stats.play % 2 == 0 then
				prof.full = true
			end
			if prof.stunUntil > 0 and os.clock() >= prof.stunUntil then
				prof.stunUntil = 0
				setWalkSpeed(plr)
			end
		end
	end
	if saveAcc >= 90 then
		saveAcc = 0
		for plr in profiles do
			task.spawn(save, plr)
		end
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="8">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">90</float>
      <float name="CharacterWalkSpeed">22</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="9">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="10">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Sweet Pets Factory : côté joueur
-- Interface, animation d'éclosion, affichage des pets de tous les joueurs,
-- effets (dégâts, pièces, confettis) et sons. Le joueur n'envoie que des
-- demandes au serveur, qui reste seul juge.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PetModels = require(Shared:WaitForChild("PetModels"))
local UI = require(script:WaitForChild("UI"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Action = Remotes:WaitForChild("Action") :: RemoteEvent
local StateEvent = Remotes:WaitForChild("State") :: RemoteEvent
local Fx = Remotes:WaitForChild("Fx") :: RemoteEvent

local S: any = nil -- dernier état reçu du serveur
local muted = false
local fmt = Config.fmt

local function send(name: string, arg: any?)
	Action:FireServer(name, arg)
end

---------------------------------------------------------------------------
-- Sons (sons intégrés à Roblox ; remplace-les par tes propres rbxassetid://)
---------------------------------------------------------------------------
local SOUNDS = {
	click = { "rbxasset://sounds/electronicpingshort.wav", 1.5, 0.3 },
	coin = { "rbxasset://sounds/electronicpingshort.wav", 2.2, 0.18 },
	pop = { "rbxasset://sounds/swoosh.wav", 1.4, 0.4 },
	tap = { "rbxasset://sounds/clickfast.wav", 1.0, 0.45 },
	error = { "rbxasset://sounds/clickfast.wav", 0.5, 0.5 },
	buy = { "rbxasset://sounds/electronicpingshort.wav", 1.1, 0.45 },
	hatch = { "rbxasset://sounds/swoosh.wav", 0.8, 0.6 },
	reveal = { "rbxasset://sounds/electronicpingshort.wav", 0.9, 0.55 },
	legend = { "rbxasset://sounds/electronicpingshort.wav", 0.6, 0.8 },
}
local soundObjs: { [string]: Sound } = {}
for name, s in SOUNDS do
	soundObjs[name] = UI.new("Sound", { SoundId = s[1], PlaybackSpeed = s[2], Volume = s[3], Parent = SoundService })
end
local lastSound: { [string]: number } = {}
local function play(name: string)
	if muted then
		return
	end
	local now = os.clock()
	if now - (lastSound[name] or 0) < 0.06 then
		return
	end
	lastSound[name] = now
	local snd = soundObjs[name]
	if snd then
		SoundService:PlayLocalSound(snd)
	end
end
UI.onClick = function()
	play("click")
end
UI.onError = function()
	play("error")
end

---------------------------------------------------------------------------
-- Racine de l'interface
---------------------------------------------------------------------------
local gui = UI.new("ScreenGui", {
	Name = "SweetPets",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
	Parent = player:WaitForChild("PlayerGui"),
})
local uiScale = UI.new("UIScale", { Parent = gui })
local function rescale()
	local cam = workspace.CurrentCamera
	if cam then
		local vs = cam.ViewportSize
		uiScale.Scale = math.clamp(math.min(vs.X / 1280, vs.Y / 720), 0.55, 1.4)
	end
end
rescale()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(rescale)
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
end

