		UI.button(box, { Text = "TIRER x10", Color = UI.ORANGE, Size = UDim2.fromOffset(190, 54), Position = UDim2.new(1, -204, 0, 78), TextSize = 22, Enabled = S.coins >= S.hammerPrice * 9 }, function()
