        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Sweet Pets Factory : serveur
-- Gère les données des joueurs, la carte, les bonbons, les pets, les œufs,
-- la boutique, les quêtes et le boss. Les joueurs ne font qu'envoyer des
-- demandes (remotes) que le serveur vérifie.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PetModels = require(Shared:WaitForChild("PetModels"))
local MapDecor = require(Shared:WaitForChild("MapDecor"))
local HammerModels = require(Shared:WaitForChild("HammerModels"))

local rng = Random.new()

-- Modèles Blender importés (pet_<id>) : où qu'ils soient dans Workspace, on les range
-- dans ReplicatedStorage › PetMeshes pour que les joueurs puissent les copier.
do
	local folder = ReplicatedStorage:FindFirstChild("PetMeshes") or Instance.new("Folder")
	folder.Name = "PetMeshes"
	folder.Parent = ReplicatedStorage
	for _, d in workspace:GetDescendants() do
		-- l'import peut emboîter deux modèles du même nom : on ne déplace que le plus haut
		if d:IsA("Model") and string.sub(d.Name, 1, 4) == "pet_" and Config.Pets[string.sub(d.Name, 5)] and not (d.Parent and d.Parent:FindFirstAncestor(d.Name)) and not (d.Parent and d.Parent.Name == d.Name) then
			d.Parent = folder
		end
	end
	if #folder:GetChildren() > 0 then
		print(string.format("[SweetPets] %d modèles Blender trouvés", #folder:GetChildren()))
	end
end

---------------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local Action = Instance.new("RemoteEvent")
Action.Name = "Action"
Action.Parent = remotes
local StateEvent = Instance.new("RemoteEvent")
StateEvent.Name = "State"
StateEvent.Parent = remotes
local Fx = Instance.new("RemoteEvent")
Fx.Name = "Fx"
Fx.Parent = remotes
remotes.Parent = ReplicatedStorage

---------------------------------------------------------------------------
-- Outils de construction
---------------------------------------------------------------------------
local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	local parent = props.Parent
	for k, v in props do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function deco(props: { [string]: any }): Part
	props.CanCollide = if props.CanCollide == nil then false else props.CanCollide
	props.CanQuery = false
	props.CanTouch = false
	return part(props)
end

local function billboard(adornee: BasePart, offset: Vector3, size: UDim2, maxDist: number?): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Adornee = adornee
	bb.Size = size
	bb.StudsOffsetWorldSpace = offset
	bb.MaxDistance = maxDist or 120
	bb.LightInfluence = 0
	bb.Parent = adornee
	return bb
end

local INK = Color3.fromHex("3B2A5A")

local function label(parent: Instance, text: string, size: UDim2, pos: UDim2, textSize: number, color: Color3?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.Font = Enum.Font.FredokaOne
	t.Text = text
	t.TextSize = textSize
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextScaled = false
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = INK
	st.Parent = t
	t.Parent = parent
	return t
end

---------------------------------------------------------------------------
-- Carte : une île par monde + l'arène du boss
---------------------------------------------------------------------------
local map = Instance.new("Folder")
map.Name = "Map"
map.Parent = workspace
local pileFolder = Instance.new("Folder")
pileFolder.Name = "Piles"
pileFolder.Parent = workspace

local FIELD_X = MapDecor.FX
local FIELD_Z0, FIELD_Z1 = MapDecor.Z0, MapDecor.Z1
local PLAZA_Z = -115

local eggStands: { [string]: Vector3 } = {}
local prompts: { ProximityPrompt } = {}

local function worldSpawn(w: number): CFrame
	local o = Config.Worlds[w].origin
	return CFrame.new(o + Vector3.new(0, 4, 30))
end

-- Décor (calculé par MapDecor) : une pièce par entrée, effets d'ambiance compris
local MATERIALS: { [string]: Enum.Material } = {
	Neon = Enum.Material.Neon,
	Glass = Enum.Material.Glass,
	Foil = Enum.Material.Foil,
	Metal = Enum.Material.Metal,
	Sand = Enum.Material.Sand,
	Snow = Enum.Material.Snow,
	SmoothPlastic = Enum.Material.SmoothPlastic,
}
local FX_TEXTURE = {
	sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	stars = "rbxasset://textures/particles/sparkles_main.dds",
	bubbles = "rbxasset://textures/particles/smoke_main.dds",
	snow = "rbxasset://textures/particles/sparkles_main.dds",
}

local function ambientFx(host: BasePart, kind: string)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = FX_TEXTURE[kind] or FX_TEXTURE.sparkle
	pe.LightEmission = 1
	pe.Lifetime = NumberRange.new(4, 7)
	pe.Rate = 12
	pe.Speed = NumberRange.new(0.5, 2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.8), NumberSequenceKeypoint.new(1, 0) })
	if kind == "snow" then
		pe.Color = ColorSequence.new(Color3.new(1, 1, 1))
		pe.Rate = 60
		pe.Speed = NumberRange.new(2, 4)
		pe.Acceleration = Vector3.new(0, -2, 0)
		pe.Size = NumberSequence.new(0.5)
		pe.LightEmission = 0.3
	elseif kind == "bubbles" then
		pe.Color = ColorSequence.new(Color3.fromHex("6B4430"))
		pe.Rate = 8
		pe.Speed = NumberRange.new(3, 6)
		pe.LightEmission = 0
	elseif kind == "stars" then
		pe.Color = ColorSequence.new(Color3.fromHex("FFF3B8"), Color3.fromHex("7FD6FF"))
		pe.Rate = 30
	else
		pe.Color = ColorSequence.new(Color3.fromHex("FFF6C8"), Color3.fromHex("FF8FB8"))
	end
	pe.Parent = host
	-- zone d'émission : grande boîte invisible
	if kind == "snow" or kind == "stars" or kind == "sparkle" then
		host.Size = if kind == "sparkle" then Vector3.new(FIELD_X * 2, 10, FIELD_Z1 - FIELD_Z0) else Vector3.new(420, 4, 360)
		pe.Shape = Enum.ParticleEmitterShape.Box
		pe.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
		pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	end
end

local function buildDecor(w, folder: Folder)
	local o = w.origin
	local palette = {}
	for _, c in w.candy do
		table.insert(palette, c:ToHex())
	end
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = folder
	for _, sp in MapDecor.build(w.theme, palette, w.id * 977) do
		local size = Vector3.new(sp.size[1], sp.size[2], sp.size[3])
		local r = sp.r
		local cf = CFrame.new(o + Vector3.new(sp.p[1], sp.p[2], sp.p[3]))
		if r then
			cf *= CFrame.Angles(math.rad(r[1]), math.rad(r[2]), math.rad(r[3]))
		end
		local p = deco({
			Parent = decor,
			Size = size,
			CFrame = cf,
			Color = Color3.fromHex(sp.c),
			Material = MATERIALS[sp.m or "SmoothPlastic"] or Enum.Material.SmoothPlastic,
			Transparency = sp.t or 0,
			CanCollide = sp.col == true,
			CastShadow = math.max(size.X, size.Y, size.Z) > 6 and (sp.t or 0) < 0.5,
		})
		if sp.s == "ball" then
			p.Shape = Enum.PartType.Ball
		elseif sp.s == "cyl" then
			p.Shape = Enum.PartType.Cylinder
		end
		if sp.light then
			local l = Instance.new("PointLight")
			l.Range = sp.light
			l.Brightness = 1.2
			l.Color = p.Color
			l.Parent = p
		end
		if sp.fx then
			ambientFx(p, sp.fx)
		end
	end
end

local function addPrompt(parent: BasePart, action: string, object: string, kind: string, value: string): ProximityPrompt
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = action
	pr.ObjectText = object
	pr.KeyboardKeyCode = Enum.KeyCode.E
	pr.HoldDuration = 0
	pr.MaxActivationDistance = 14
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Kind", kind)
	pr:SetAttribute("Value", value)
	pr.Parent = parent
	table.insert(prompts, pr)
	return pr
end

local function buildWorld(w)
	local o = w.origin
	local folder = Instance.new("Folder")
	folder.Name = w.name
	folder.Parent = map

	part({ Parent = folder, Name = "Ground", Size = Vector3.new(400, 4, 340), Position = o + Vector3.new(0, -2, 0), Color = w.ground })
	-- damier de dalles claires
	for gx = -4, 4 do
		for gz = -3, 3 do
			if (gx + gz) % 2 == 0 then
				deco({ Parent = folder, Size = Vector3.new(40, 0.1, 40), Position = o + Vector3.new(gx * 40, 0.05, gz * 40 + 10), Color = w.ground2 })
			end
		end
	end
	-- bordures
	for _, b in { { Vector3.new(0, 10, 172), Vector3.new(404, 24, 4) }, { Vector3.new(0, 10, -172), Vector3.new(404, 24, 4) }, { Vector3.new(202, 10, 0), Vector3.new(4, 24, 340) }, { Vector3.new(-202, 10, 0), Vector3.new(4, 24, 340) } } do
		part({ Parent = folder, Size = b[2], Position = o + b[1], Transparency = 1 })
		deco({ Parent = folder, Size = Vector3.new(b[2].X, 2, b[2].Z), Position = o + Vector3.new(b[1].X, 1, b[1].Z), Color = w.banner, CanCollide = true })
	end
	-- place centrale
	deco({ Parent = folder, Name = "Plaza", Size = Vector3.new(300, 0.3, 70), Position = o + Vector3.new(0, 0.15, PLAZA_Z), Color = w.plaza, CanCollide = true })
	-- panneau du monde
	local sign = deco({ Parent = folder, Size = Vector3.new(36, 9, 1.5), Position = o + Vector3.new(0, 14, PLAZA_Z - 30), Color = w.banner, CanCollide = true })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.CanvasSize = Vector2.new(720, 180)
	sg.LightInfluence = 0
	sg.Parent = sign
	label(sg, w.name, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 90)
	for _, sx in { -17, 17 } do
		deco({ Parent = folder, Size = Vector3.new(1.5, 14, 1.5), Position = o + Vector3.new(sx, 7, PLAZA_Z - 30), Color = Color3.new(1, 1, 1), CanCollide = true })
	end

	-- socles d'œufs
	for i, eggId in w.eggs do
		local egg = Config.Eggs[eggId]
		local pos = o + Vector3.new(-30 + (i - 1) * 60, 0, PLAZA_Z)
		eggStands[eggId] = pos
		local ped = part({ Parent = folder, Name = "Stand_" .. eggId, Size = Vector3.new(3, 12, 12), CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Shape = Enum.PartType.Cylinder, Color = Color3.new(1, 1, 1) })
		ped:SetAttribute("Egg", eggId)
		local model = PetModels.egg(eggId, 2.2)
		model:PivotTo(CFrame.new(pos + Vector3.new(0, 7.8, 0)))
		model.Parent = folder
		local bb = billboard(ped, Vector3.new(0, 15, 0), UDim2.fromOffset(240, 80))
		label(bb, egg.name, UDim2.new(1, 0, 0.55, 0), UDim2.fromScale(0, 0), 32)
		label(bb, Config.fmt(egg.price) .. " pièces", UDim2.new(1, 0, 0.45, 0), UDim2.fromScale(0, 0.55), 26, Color3.fromHex("FFD54A"))
		addPrompt(ped, "Ouvrir", egg.name .. " · " .. Config.fmt(egg.price), "egg", eggId)
	end

	-- portail de rebirth
	local pp = o + Vector3.new(-105, 0, PLAZA_Z)
	for _, sx in { -7, 7 } do
		deco({ Parent = folder, Size = Vector3.new(2.5, 16, 2.5), Position = pp + Vector3.new(sx, 8, 0), Color = Color3.fromHex("6B5BD6"), CanCollide = true })
	end
	deco({ Parent = folder, Size = Vector3.new(17, 2.5, 2.5), Position = pp + Vector3.new(0, 16, 0), Color = Color3.fromHex("6B5BD6"), CanCollide = true })
	local disc = deco({ Parent = folder, Name = "Portal", Size = Vector3.new(0.6, 12, 12), CFrame = CFrame.new(pp + Vector3.new(0, 8, 0)) * CFrame.Angles(0, math.rad(90), 0), Shape = Enum.PartType.Cylinder, Color = Color3.fromHex("B69CFF"), Material = Enum.Material.Neon, Transparency = 0.2 })
	local pbb = billboard(disc, Vector3.new(0, 11, 0), UDim2.fromOffset(220, 50))
	label(pbb, "REBIRTH", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 34, Color3.fromHex("FFD54A"))
	local pbase = part({ Parent = folder, Size = Vector3.new(16, 1, 6), Position = pp + Vector3.new(0, 0.5, 4), Color = Color3.fromHex("8C7BFF") })
	addPrompt(pbase, "Rebirth", "Portail", "panel", "rebirth")

	-- porte des mondes
	local gp = o + Vector3.new(105, 0, PLAZA_Z)
	for _, sx in { -8, 8 } do
		deco({ Parent = folder, Size = Vector3.new(3, 18, 3), Position = gp + Vector3.new(sx, 9, 0), Color = Color3.new(1, 1, 1), CanCollide = true })
	end
	local top = deco({ Parent = folder, Size = Vector3.new(22, 4, 3), Position = gp + Vector3.new(0, 19, 0), Color = Color3.fromHex("7EE0B8"), CanCollide = true })
	local nextW = Config.Worlds[w.id + 1]
	deco({ Parent = folder, Size = Vector3.new(13, 16, 0.4), Position = gp + Vector3.new(0, 8, 0), Color = nextW and nextW.ground or Color3.fromHex("BDE9FF"), Material = Enum.Material.Neon, Transparency = 0.35 })
	local gbb = billboard(top, Vector3.new(0, 5, 0), UDim2.fromOffset(240, 50))
	label(gbb, "MONDES", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 34)
	local gbase = part({ Parent = folder, Size = Vector3.new(18, 1, 6), Position = gp + Vector3.new(0, 0.5, 4), Color = Color3.fromHex("7EE0B8") })
	addPrompt(gbase, "Voyager", "Mondes", "panel", "worlds")

	-- contour du champ de bonbons
	deco({ Parent = folder, Size = Vector3.new(FIELD_X * 2 + 16, 0.12, FIELD_Z1 - FIELD_Z0 + 16), Position = o + Vector3.new(0, 0.1, (FIELD_Z0 + FIELD_Z1) / 2), Color = w.ground:Lerp(Color3.new(1, 1, 1), 0.25), Transparency = 0.3 })

	buildDecor(w, folder)
end

for _, w in Config.Worlds do
	buildWorld(w)
end

-- Arène du boss
local arena = Instance.new("Folder")
arena.Name = "BossArena"
arena.Parent = map
local BO = Config.BOSS_ORIGIN
part({ Parent = arena, Size = Vector3.new(170, 4, 150), Position = BO + Vector3.new(0, -2, 0), Color = Color3.fromHex("3B2F6B") })
for i = 1, 5 do
	deco({ Parent = arena, Size = Vector3.new(0.2, 140 - i * 22, 140 - i * 22), CFrame = CFrame.new(BO + Vector3.new(0, 0.05 + i * 0.02, -15)) * CFrame.Angles(0, 0, math.rad(90)), Shape = Enum.PartType.Cylinder, Color = Color3.fromHex(i % 2 == 0 and "4B3E86" or "5A4BA0") })
end
for _, b in { { Vector3.new(0, 15, 76), Vector3.new(174, 34, 4) }, { Vector3.new(0, 15, -76), Vector3.new(174, 34, 4) }, { Vector3.new(86, 15, 0), Vector3.new(4, 34, 150) }, { Vector3.new(-86, 15, 0), Vector3.new(4, 34, 150) } } do
	part({ Parent = arena, Size = b[2], Position = BO + b[1], Color = Color3.fromHex("6B5BD6"), Transparency = 0.6 })
end
local GOLEM_POS = BO + Vector3.new(0, 0, -30)

-- Colisée du boss : gradins de spectateurs en gomme, piliers et torches, bannières, douves de sucre
do
	local deep, mid, light = Color3.fromHex("3B2F6B"), Color3.fromHex("5A4BA0"), Color3.fromHex("B69CFF")
	local gummies = { "FF5A8A", "FFD54A", "7EE0B8", "7FD6FF", "FF9A3C", "B69CFF" }
	local ar = Random.new(4242)
	-- sol extérieur
	part({ Parent = arena, Size = Vector3.new(420, 2, 400), Position = BO + Vector3.new(0, -3.2, 0), Color = Color3.fromHex("221A40") })
	-- douves lumineuses tout autour du sol de combat
	for _, b in { { Vector3.new(0, 0, 82), Vector3.new(190, 0.4, 8) }, { Vector3.new(0, 0, -82), Vector3.new(190, 0.4, 8) }, { Vector3.new(94, 0, 0), Vector3.new(8, 0.4, 172) }, { Vector3.new(-94, 0, 0), Vector3.new(8, 0.4, 172) } } do
		deco({ Parent = arena, Size = b[2], Position = BO + b[1] + Vector3.new(0, -0.4, 0), Color = Color3.fromHex("FF4FD8"), Material = Enum.Material.Neon })
	end
	-- gradins (3 marches) et spectateurs, sauf devant l'entrée (z > 0 au centre)
	for tier = 1, 3 do
		local off = 100 + tier * 10
		local h = tier * 5
		for _, side in { { Vector3.new(0, 0, -1), 230 }, { Vector3.new(1, 0, 0), 200 }, { Vector3.new(-1, 0, 0), 200 } } do
			local n, len = side[1], side[2]
			local center = BO + n * off + Vector3.new(0, h / 2 - 0.5, 0)
			local size = if n.Z ~= 0 then Vector3.new(len, h, 10) else Vector3.new(10, h, len)
			part({ Parent = arena, Size = size, Position = center, Color = if tier % 2 == 0 then mid else deep })
			-- spectateurs : petits oursons en gomme
			for k = 1, 26 do
				local u = (k - 0.5) / 26 - 0.5
				local pos = if n.Z ~= 0 then BO + n * off + Vector3.new(u * len * 0.92, h, 0) else BO + n * off + Vector3.new(0, h, u * len * 0.92)
				if ar:NextNumber() < 0.8 then
					local c = Color3.fromHex(gummies[ar:NextInteger(1, #gummies)])
					deco({ Parent = arena, Size = Vector3.new(2.6, 3, 2.2), Position = pos + Vector3.new(0, 1.5, 0), Color = c, Material = Enum.Material.Glass, Transparency = 0.15 })
					deco({ Parent = arena, Size = Vector3.one * 2.2, Position = pos + Vector3.new(0, 3.9, 0), Shape = Enum.PartType.Ball, Color = c, Material = Enum.Material.Glass, Transparency = 0.15 })
				end
			end
		end
	end
	-- piliers avec torches
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local pos = BO + Vector3.new(math.cos(a) * 92, 0, math.sin(a) * 78)
		if pos.Z - BO.Z > 60 and math.abs(pos.X - BO.X) < 30 then
			continue -- dégage l'entrée
		end
		deco({ Parent = arena, Size = Vector3.new(4.5, 26, 4.5), Position = pos + Vector3.new(0, 13, 0), Color = light, CanCollide = true })
		deco({ Parent = arena, Size = Vector3.new(6.5, 2, 6.5), Position = pos + Vector3.new(0, 1, 0), Color = mid })
		deco({ Parent = arena, Size = Vector3.new(6.5, 2, 6.5), Position = pos + Vector3.new(0, 26.5, 0), Color = mid })
		local flame = deco({ Parent = arena, Size = Vector3.new(2.6, 3.4, 2.6), Position = pos + Vector3.new(0, 29.4, 0), Shape = Enum.PartType.Ball, Color = Color3.fromHex("FF9A3C"), Material = Enum.Material.Neon })
		local fire = Instance.new("Fire")
		fire.Color = Color3.fromHex("FF6A3D")
		fire.SecondaryColor = Color3.fromHex("FFD54A")
		fire.Size = 5
		fire.Heat = 9
		fire.Parent = flame
		local l = Instance.new("PointLight")
		l.Color = Color3.fromHex("FFB060")
		l.Range = 30
		l.Brightness = 2
		l.Parent = flame
		-- bannière
		deco({ Parent = arena, Size = Vector3.new(0.4, 10, 5), CFrame = CFrame.lookAt(pos + Vector3.new(0, 18, 0), BO + Vector3.new(0, 18, 0)) * CFrame.new(0, 0, -2.6) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromHex(gummies[i % #gummies + 1]) })
	end
	-- portail d'entrée
	local gate = BO + Vector3.new(0, 0, 72)
	for _, sx in { -12, 12 } do
		deco({ Parent = arena, Size = Vector3.new(5, 28, 5), Position = gate + Vector3.new(sx, 14, 0), Color = light, CanCollide = true })
	end
	local top = deco({ Parent = arena, Size = Vector3.new(30, 5, 6), Position = gate + Vector3.new(0, 30, 0), Color = mid, CanCollide = true })
	local bb = billboard(top, Vector3.new(0, 6, 0), UDim2.fromOffset(320, 60), 200)
	label(bb, "ARÈNE DU GOLEM", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 40, Color3.fromHex("FFD54A"))
	-- runes au sol autour de la zone du golem
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		deco({ Parent = arena, Size = Vector3.new(6, 0.2, 2), CFrame = CFrame.new(GOLEM_POS + Vector3.new(math.cos(a) * 34, 0.2, math.sin(a) * 34)) * CFrame.Angles(0, -a, 0), Color = Color3.fromHex("FF4FD8"), Material = Enum.Material.Neon })
	end
end

local ARENA_SPAWN = CFrame.new(BO + Vector3.new(0, 4, 45))

---------------------------------------------------------------------------
-- Données des joueurs
---------------------------------------------------------------------------
local store: DataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore("SweetPetsFactory_v1")
end)

local function today(): string
	return os.date("!%Y-%m-%d") :: string
end

local function yesterday(): string
	return os.date("!%Y-%m-%d", os.time() - 86400) :: string
end

local function defaultData()
	return {
		v = 1,
		coins = 0,
		gems = 0,
		totalCoins = 0,
		rebirths = 0,
		world = 1,
		maxWorld = 1,
		pets = { { uid = 1, def = "gumdrop_bunny", tier = 0, lvl = 0, xp = 0, eq = true, lock = false, shiny = false, bonus = 0 } },
		nextUid = 2,
		discovered = { gumdrop_bunny = true },
		upgrades = {},
		passes = {},
		potions = {},
		quest = 1,
		questBase = 0,
		dailyDay = "",
		daily = {},
		giftDay = "",
		giftStreak = 0,
		stats = { hatched = 0, piles = 0, taps = 0, bosses = 0, golden = 0, rainbow = 0, upgrades = 0, play = 0, bestHit = 0 },
		indexClaim = 0,
		bossWins = 0,
		autoCollect = true,
		autoDelete = 0,
		lastSeen = 0,
		receipts = {},
		hammers = { wood = true },
		hammer = "wood",
	}
end

local function reconcile(data, template)
	for k, v in template do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and k == "stats" then
			reconcile(data[k], v)
		end
	end
	return data
end

type Profile = {
	data: any,
	canSave: boolean,
	full: boolean,
	money: boolean,
	focus: number?,
	targets: { [number]: number },
	arrive: { [number]: number },
	eq: { any },
	lastTap: number,
	combo: number,
	comboT: number,
	lastHatch: number,
	autoHatch: string?,
	stunUntil: number,
	inBoss: boolean,
	robux: { [string]: boolean },
	cpsAcc: number,
	cpsHist: { number },
	cps: number,
	targetStr: string,
}

local profiles: { [Player]: Profile } = {}
-- multiplicateurs des événements « admin abusé » (modifiés par Admin.luau)
local adminEvents = { coins = 1, luck = 1, dmg = 1, speed = 1 }
-- chance x2 pour tout le serveur (produit Robux), fin en os.time()
local serverLuckEnds = 0

---------------------------------------------------------------------------
-- Économie
---------------------------------------------------------------------------
local function hasPass(prof: Profile, id: string): boolean
	return prof.data.passes[id] == true or prof.robux[id] == true
end

local function up(prof: Profile, id: string): number
	return prof.data.upgrades[id] or 0
end

local function slots(prof: Profile): number
	return Config.BASE_SLOTS + up(prof, "slot") + (hasPass(prof, "vip") and 2 or 0) + (hasPass(prof, "slots") and 3 or 0)
end

local function storage(prof: Profile): number
	return Config.BASE_STORAGE + 25 * up(prof, "storage") + (hasPass(prof, "storage") and 150 or 0)
end

local function potionOn(prof: Profile, id: string): boolean
	return (prof.data.potions[id] or 0) > 0
end

local function damageMult(prof: Profile): number
	return (1 + 0.1 * up(prof, "power")) * (potionOn(prof, "dmg") and 2 or 1) * (hasPass(prof, "dmg2") and 2 or 1) * adminEvents.dmg
end

local function coinMult(prof: Profile): number
	local d = prof.data
	local m = Config.rebirthMult(d.rebirths) * (1 + 0.1 * up(prof, "coins")) * (1 + 0.05 * d.indexClaim)
	if hasPass(prof, "coins2") then
		m *= 2
	end
	if hasPass(prof, "vip") then
		m *= 1.1
	end
	if potionOn(prof, "coins") then
		m *= 2
	end
	return m * adminEvents.coins
end

local function luckMult(prof: Profile): number
	local m = 1 + 0.15 * up(prof, "luck")
	if hasPass(prof, "luck2") then
		m *= 2
	end
	if potionOn(prof, "luck") then
		m *= 2
	end
	if os.time() < serverLuckEnds then
		m *= 2
	end
	return m * adminEvents.luck
end

local function teamDps(prof: Profile): number
	local sum = 0
	for _, p in prof.eq do
		sum += PetModels.power(p)
	end
	return sum * damageMult(prof)
end

local function tapDamage(prof: Profile): number
	return math.max(3, teamDps(prof) * 0.25) * (1 + 0.5 * up(prof, "tap")) * HammerModels.def(prof.data.hammer).bonus
end

local function coinPerHP(w: number): number
	return 3 * Config.Worlds[w].coinMult
end

local function estimatedCps(prof: Profile): number
	return teamDps(prof) * coinPerHP(prof.data.world) * coinMult(prof) * 0.8
end

local function equippedCount(d): number
	local n = 0
	for _, p in d.pets do
		if p.eq then
			n += 1
		end
	end
	return n
end

local function findPet(d, uid: any)
	for _, p in d.pets do
		if p.uid == uid then
			return p
		end
	end
	return nil
end

local function addPet(d, def: string, tier: number, shiny: boolean)
	local p = { uid = d.nextUid, def = def, tier = tier, lvl = 0, xp = 0, eq = false, lock = false, shiny = shiny, bonus = 0 }
	d.nextUid += 1
	table.insert(d.pets, p)
	d.discovered[def] = true
	return p
end

local function removePets(d, uids: { [number]: boolean })
	local keep = {}
	for _, p in d.pets do
		if not uids[p.uid] then
			table.insert(keep, p)
		end
	end
	d.pets = keep
end

local function setWalkSpeed(plr: Player)
	local prof = profiles[plr]
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if prof and hum then
		hum.WalkSpeed = if os.clock() < prof.stunUntil then 0 else 22 * (1 + 0.08 * up(prof, "speed")) * (if hasPass(prof, "speed") then 1.4 else 1) * adminEvents.speed
	end
end

-- Recalcule la liste des pets équipés et la publie pour l'affichage chez tous les joueurs.
local function refreshEquipped(plr: Player)
	local prof = profiles[plr]
	if not prof then
		return
	end
	local eq = {}
	for _, p in prof.data.pets do
		if p.eq then
			table.insert(eq, p)
		end
	end
	table.sort(eq, function(a, b)
		return PetModels.power(a) > PetModels.power(b)
	end)
	prof.eq = eq
	local parts = {}
	for _, p in eq do
		table.insert(parts, string.format("%s:%d:%d", p.def, p.tier, p.shiny and 1 or 0))
	end
	plr:SetAttribute("PetsEquipped", table.concat(parts, "|"))
	prof.targets = {}
	prof.arrive = {}
	prof.full = true
end

local function toast(plr: Player, text: string, color: string?)
	Fx:FireClient(plr, "toast", { text = text, color = color })
end

local function addCoins(prof: Profile, v: number, track: boolean)
	prof.data.coins += v
	prof.data.totalCoins += v
	if track then
		prof.cpsAcc += v
	end
	prof.money = true
end

local function spend(plr: Player, prof: Profile, cost: number, gems: boolean): boolean
	local d = prof.data
	if gems then
		if d.gems < cost then
			toast(plr, "Pas assez de gemmes")
			return false
		end
		d.gems -= cost
	else
		if d.coins < cost then
			toast(plr, "Pas assez de pièces")
			return false
		end
		d.coins -= cost
	end
	prof.money = true
	prof.full = true
	return true
end

---------------------------------------------------------------------------
-- Quêtes
---------------------------------------------------------------------------
local function metric(prof: Profile, kind: string): number
	local d = prof.data
	local s = d.stats
	if kind == "piles" then
		return s.piles
	elseif kind == "hatch" then
		return s.hatched
	elseif kind == "equip" then
		return equippedCount(d)
	elseif kind == "coins" then
		return d.totalCoins
	elseif kind == "upgrade" then
		return s.upgrades
	elseif kind == "golden" then
		return s.golden
	elseif kind == "rainbow" then
		return s.rainbow
	elseif kind == "boss" then
		return s.bosses
	elseif kind == "world" then
		return d.maxWorld
	elseif kind == "rebirth" then
		return d.rebirths
	elseif kind == "taps" then
		return s.taps
	end
	return 0
end

local function questProgress(prof: Profile): (any, number)
	local q = Config.StarterQuests[prof.data.quest]
	if not q then
		return nil, 0
	end
	if Config.AbsoluteQuest[q.kind] then
		return q, metric(prof, q.kind)
	end
	return q, metric(prof, q.kind) - prof.data.questBase
end

local function roundNice(v: number): number
	local m = 1
	while v >= 100 do
		v /= 10
		m *= 10
	end
	return math.floor(v) * m
end

local function refreshDaily(prof: Profile)
	local d = prof.data
	local day = today()
	if d.dailyDay == day and #d.daily == 3 then
		return
	end
	d.dailyDay = day
	local seed = 0
	for i = 1, #day do
		seed = (seed * 31 + string.byte(day, i)) % 2147483647
	end
	local r = Random.new(seed)
	local kinds = { "piles", "hatch", "taps", "coins", "boss", "golden" }
	for i = #kinds, 2, -1 do
		local j = r:NextInteger(1, i)
		kinds[i], kinds[j] = kinds[j], kinds[i]
	end
	d.daily = {}
	for i = 1, 3 do
		local k = kinds[i]
		local target = 1
		if k == "piles" then
			target = 80 + r:NextInteger(0, 7) * 20
		elseif k == "hatch" then
			target = 15 + r:NextInteger(0, 4) * 5
		elseif k == "taps" then
			target = 150 + r:NextInteger(0, 5) * 50
		elseif k == "coins" then
			target = roundNice(math.max(5000, estimatedCps(prof) * 900))
		end
		table.insert(d.daily, { kind = k, target = target, base = metric(prof, k), gems = r:NextInteger(8, 15), claimed = false })
	end
	prof.full = true
end

local function indexCount(d): number
	local n = 0
	for _, id in Config.PetOrder do
		if d.discovered[id] then
			n += 1
		end
	end
	return n
end

---------------------------------------------------------------------------
-- Envoi de l'état aux joueurs
---------------------------------------------------------------------------
local function sendMoney(plr: Player)
	local prof = profiles[plr]
	if not prof then
		return
	end
	Fx:FireClient(plr, "money", { coins = prof.data.coins, gems = prof.data.gems, cps = prof.cps })
	prof.money = false
	local ls = plr:FindFirstChild("leaderstats")
	if ls then
		local c = ls:FindFirstChild("Pièces") :: StringValue?
		if c then
			c.Value = Config.fmt(prof.data.coins)
		end
		local r = ls:FindFirstChild("Rebirths") :: IntValue?
		if r then
			r.Value = prof.data.rebirths
		end
	end
end

local function sendState(plr: Player)
	local prof = profiles[plr]
	if not prof then
		return
	end
	local d = prof.data
	local pets = {}
	for _, p in d.pets do
		table.insert(pets, { uid = p.uid, def = p.def, tier = p.tier, shiny = p.shiny, lvl = p.lvl, xp = p.xp, eq = p.eq, lock = p.lock, bonus = p.bonus, power = PetModels.power(p) })
	end
	local q, qp = questProgress(prof)
	local daily = {}
	for _, dq in d.daily do
		table.insert(daily, { kind = dq.kind, target = dq.target, progress = metric(prof, dq.kind) - dq.base, gems = dq.gems, claimed = dq.claimed })
	end
	local passes = {}
	for _, ps in Config.Passes do
		passes[ps.id] = hasPass(prof, ps.id)
	end
	local giftNext = if d.giftDay == yesterday() then d.giftStreak % 7 + 1 else 1
	StateEvent:FireClient(plr, {
		coins = d.coins,
		gems = d.gems,
		totalCoins = d.totalCoins,
		rebirths = d.rebirths,
		world = d.world,
		maxWorld = d.maxWorld,
		pets = pets,
		discovered = d.discovered,
		upgrades = d.upgrades,
		passes = passes,
		potions = d.potions,
		quest = d.quest,
		questProgress = qp,
		questDone = q == nil,
		daily = daily,
		giftReady = d.giftDay ~= today(),
		giftNext = giftNext,
		giftStreak = d.giftStreak,
		giftCoins = roundNice(math.max(500, estimatedCps(prof) * 180)),
		indexClaim = d.indexClaim,
		hammers = d.hammers,
		hammer = d.hammer,
		hammerPrice = math.floor(math.max(300, estimatedCps(prof) * Config.HAMMER_ROLL_SECONDS)),
		indexCount = indexCount(d),
		stats = d.stats,
		autoCollect = d.autoCollect,
		autoDelete = d.autoDelete,
		slots = slots(prof),
		storage = storage(prof),
		dps = teamDps(prof),
		cps = prof.cps,
		coinMult = coinMult(prof),
		luck = luckMult(prof),
		tap = tapDamage(prof),
		rebirthCost = Config.rebirthCost(d.rebirths),
		autoHatch = prof.autoHatch,
		inBoss = prof.inBoss,
		canSave = prof.canSave,
	})
	prof.full = false
	sendMoney(plr)
end

---------------------------------------------------------------------------
-- Tas de bonbons
---------------------------------------------------------------------------
type Pile = {
	id: number,
	world: number,
	kind: number,
	hp: number,
	maxHp: number,
	pos: Vector3,
	model: Model,
	bar: Frame,
	bb: BillboardGui,
	contrib: { [Player]: number },
	dead: boolean,
	golden: boolean,
}

local piles: { [number]: Pile } = {}
local pileCount = { 0, 0, 0, 0 }
local nextPileId = 1
local PILE_SIZE = { 5, 8, 8 }
local CHEST_COLOR = { meadow = "FF8FB8", choco = "8A5A3C", ice = "7FD6FF", galaxy = "6B5BD6" }

local tapPile: (Player, Pile) -> ()

local function buildPileModel(w, kind: number, golden: boolean): (Model, BasePart)
	local model = Instance.new("Model")
	local s = PILE_SIZE[kind]
	local hit = part({ Parent = model, Name = "Hitbox", Size = Vector3.new(s + 1, s * 0.9, s + 1), Position = Vector3.new(0, s * 0.45, 0), Transparency = 1, CanCollide = false })
	model.PrimaryPart = hit
	local function col(): Color3
		local c = w.candy[rng:NextInteger(1, #w.candy)]
		if golden then
			c = c:Lerp(Color3.fromHex("FFD23F"), 0.75)
		end
		return c
	end
	if kind == 3 then
		local body = Color3.fromHex((CHEST_COLOR :: any)[w.theme])
		if golden then
			body = Color3.fromHex("FFD23F")
		end
		deco({ Parent = model, Size = Vector3.new(7, 4, 5), Position = Vector3.new(0, 2, 0), Color = body })
		deco({ Parent = model, Size = Vector3.new(7.4, 1.6, 5.4), Position = Vector3.new(0, 4.6, 0), Color = body:Lerp(Color3.new(1, 1, 1), 0.2) })
		deco({ Parent = model, Size = Vector3.new(1.2, 5.6, 5.6), Position = Vector3.new(0, 2.8, 0), Color = Color3.fromHex("FFD54A") })
		deco({ Parent = model, Size = Vector3.new(1.6, 1.6, 0.6), Position = Vector3.new(0, 3.2, -2.8), Color = Color3.fromHex("FFD54A") })
	else
		local layout = if kind == 1
			then { Vector3.new(-1.1, 0, 0.5), Vector3.new(1.1, 0, 0.5), Vector3.new(0, 1.4, -0.3) }
			else { Vector3.new(-2, 0, 0.8), Vector3.new(0, 0, 1.2), Vector3.new(2, 0, 0.8), Vector3.new(-1, 1.7, 0), Vector3.new(1, 1.7, 0), Vector3.new(0, 3.2, -0.2) }
		local r = kind == 1 and 1.5 or 1.8
		for _, p in layout do
			if w.theme == "choco" then
				deco({ Parent = model, Size = Vector3.new(r * 1.8, r * 0.9, r * 1.3), CFrame = CFrame.new(p + Vector3.new(0, r * 0.45, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = col() })
			elseif w.theme == "galaxy" then
				deco({ Parent = model, Size = Vector3.one * r * 1.8, Position = p + Vector3.new(0, r * 0.9, 0), Shape = Enum.PartType.Ball, Color = col(), Material = Enum.Material.Neon, Transparency = 0.15 })
			else
				deco({ Parent = model, Size = Vector3.one * r * 2, Position = p + Vector3.new(0, r * 0.8, 0), Shape = Enum.PartType.Ball, Color = col() })
			end
		end
	end
	if golden then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromHex("FFF6C8")
		sp.Parent = hit
	end
	return model, hit
end

local function spawnPile(wi: number)
	local w = Config.Worlds[wi]
	local o = w.origin
	for _ = 1, 25 do
		local pos = o + Vector3.new(rng:NextNumber(-FIELD_X, FIELD_X), 0, rng:NextNumber(FIELD_Z0, FIELD_Z1))
		if (pos - (o + Vector3.new(0, 0, 30))).Magnitude < 14 or math.abs(pos.X - o.X) < 9 then
			continue -- point d'apparition et chemin
		end
		local ok = true
		for _, g in MapDecor.GROVES do
			if (Vector3.new(pos.X - o.X, 0, pos.Z - o.Z) - Vector3.new(g[1], 0, g[2])).Magnitude < MapDecor.GROVE_R + 5 then
				ok = false
				break
			end
		end
		for _, p in piles do
			if p.world == wi and (p.pos - pos).Magnitude < 11 then
				ok = false
				break
			end
		end
		if not ok then
			continue
		end
		local roll = rng:NextNumber()
		local kind = if roll < 0.06 then 3 elseif roll < 0.36 then 2 else 1
		local golden = rng:NextNumber() < 0.01
		local hp = Config.PILE_HP[kind] * w.scale * rng:NextNumber(0.85, 1.15) * (golden and 3 or 1)
		local model, hit = buildPileModel(w, kind, golden)
		local id = nextPileId
		nextPileId += 1
		model.Name = tostring(id)
		model:SetAttribute("World", wi)
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))

		local bb = billboard(hit, Vector3.new(0, PILE_SIZE[kind] + 1, 0), UDim2.fromOffset(90, 14), 80)
		bb.Enabled = false
		local back = Instance.new("Frame")
		back.Size = UDim2.fromScale(1, 1)
		back.BackgroundColor3 = Color3.new(1, 1, 1)
		back.BorderSizePixel = 0
		local c1 = Instance.new("UICorner")
		c1.CornerRadius = UDim.new(1, 0)
		c1.Parent = back
		local st = Instance.new("UIStroke")
		st.Thickness = 2
		st.Color = INK
		st.Parent = back
		back.Parent = bb
		local bar = Instance.new("Frame")
		bar.Size = UDim2.fromScale(1, 1)
		bar.BackgroundColor3 = Color3.fromHex("3DD68C")
		bar.BorderSizePixel = 0
		local c2 = Instance.new("UICorner")
		c2.CornerRadius = UDim.new(1, 0)
		c2.Parent = bar
		bar.Parent = back

		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 70
		cd.Parent = hit

		local pile: Pile = { id = id, world = wi, kind = kind, hp = hp, maxHp = hp, pos = pos, model = model, bar = bar, bb = bb, contrib = {}, dead = false, golden = golden }
		piles[id] = pile
		pileCount[wi] += 1
		model.Parent = pileFolder
		cd.MouseClick:Connect(function(plr: Player)
			tapPile(plr, pile)
		end)
		return
	end
end

local function breakPile(pile: Pile)
	pile.dead = true
	pileCount[pile.world] -= 1
	piles[pile.id] = nil
	local total = 0
	for _, v in pile.contrib do
		total += v
	end
	for plr, dmg in pile.contrib do
		local prof = profiles[plr]
		if not prof or not plr.Parent then
			continue
		end
		local share = dmg / math.max(total, 1)
		local value = pile.maxHp * coinPerHP(pile.world) * coinMult(prof) * share
		if pile.golden then
			value *= 5
		end
		if rng:NextNumber() < 0.01 * up(prof, "golden") then
			value *= 5
		end
		addCoins(prof, value, true)
		local gems = 0
		if pile.kind == 3 and share > 0.3 and rng:NextNumber() < 0.25 then
			gems = rng:NextInteger(1, 3)
			prof.data.gems += gems
		end
		if share >= 0.15 then
			prof.data.stats.piles += 1
		end
		Fx:FireClient(plr, "coins", { pos = pile.pos, amount = value, gems = gems })
	end
	Fx:FireAllClients("break", { pos = pile.pos, world = pile.world })
	pile.model:Destroy()
end

local function damagePile(pile: Pile, plr: Player, amount: number)
	if pile.dead then
		return
	end
	pile.hp -= amount
	pile.contrib[plr] = (pile.contrib[plr] or 0) + amount
	if pile.hp <= 0 then
		breakPile(pile)
	else
		pile.bb.Enabled = true
		pile.bar.Size = UDim2.fromScale(math.clamp(pile.hp / pile.maxHp, 0.02, 1), 1)
	end
end

local function nextCombo(prof: Profile, now: number)
	if now < prof.comboT then
		prof.combo = math.min(prof.combo + 1, 50)
	else
		prof.combo = 1
	end
	prof.comboT = now + 0.9
end

tapPile = function(plr: Player, pile: Pile)
	local prof = profiles[plr]
	if not prof or pile.dead or prof.inBoss then
		return
	end
	local now = os.clock()
	if now - prof.lastTap < 0.08 or pile.world ~= prof.data.world then
		return
	end
	prof.lastTap = now
	nextCombo(prof, now)
	local dmg = tapDamage(prof) * (1 + 0.04 * (prof.combo - 1))
	local crit = rng:NextNumber() < 0.08 + 0.02 * up(prof, "crit")
	if crit then
		dmg *= 3
	end
	prof.data.stats.taps += 1
	prof.data.stats.bestHit = math.max(prof.data.stats.bestHit, dmg)
	prof.focus = pile.id
	Fx:FireClient(plr, "tap", { pos = pile.pos + Vector3.new(0, PILE_SIZE[pile.kind], 0), dmg = dmg, crit = crit, combo = prof.combo })
	damagePile(pile, plr, dmg)
end

for wi = 1, #Config.Worlds do
	for _ = 1, 24 do
		spawnPile(wi)
	end
end

---------------------------------------------------------------------------
-- Œufs
---------------------------------------------------------------------------
local function hrpOf(plr: Player): BasePart?
	local char = plr.Character
	return if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end

local function eggWeights(prof: Profile, egg): ({ number }, number)
	local luck = luckMult(prof)
	local total = 0
	local weights = {}
	for i, e in egg.pets do
		local wgt = e.chance
		if Config.Pets[e.pet].rarity >= Config.RARE then
			wgt *= luck
		end
		weights[i] = wgt
		total += wgt
	end
	return weights, total
end

local function realChance(prof: Profile, egg, petId: string): number
	local weights, total = eggWeights(prof, egg)
	for i, e in egg.pets do
		if e.pet == petId then
			return weights[i] / total * 100
		end
	end
	return 0
end

local function rollPet(prof: Profile, egg): string
	local weights, total = eggWeights(prof, egg)
	local r = rng:NextNumber() * total
	for i, e in egg.pets do
		r -= weights[i]
		if r <= 0 then
			return e.pet
		end
	end
	return egg.pets[1].pet
end

local function hatch(plr: Player, eggId: string, auto: boolean): boolean
	local prof = profiles[plr]
	local egg = Config.Eggs[eggId]
	if not prof or not egg then
		return false
	end
	local d = prof.data
	local now = os.clock()
	local fast = hasPass(prof, "fast")
	if now - prof.lastHatch < (if auto then (if fast then 1.3 else 2.4) else (if fast then 0.55 else 1.0)) then
		return false
	end
	local hrp = hrpOf(plr)
	local stand = eggStands[eggId]
	if not hrp or not stand or (hrp.Position - stand).Magnitude > 24 then
		return false
	end
	local n = 1
	if hasPass(prof, "triple") and d.coins >= egg.price * 3 then
		n = 3
	end
	local free = storage(prof) - #d.pets
	if free <= 0 then
		toast(plr, "Inventaire plein ! Supprime ou fusionne des pets.", "FF5A6E")
		prof.autoHatch = nil
		prof.full = true
		return false
	end
	n = math.min(n, free)
	if d.coins < egg.price * n then
		toast(plr, "Il te faut " .. Config.fmt(egg.price) .. " pièces")
		prof.autoHatch = nil
		prof.full = true
		return false
	end
	prof.lastHatch = now
	d.coins -= egg.price * n
	local results = {}
	for _ = 1, n do
		local petId = rollPet(prof, egg)
		local def = Config.Pets[petId]
		local isNew = not d.discovered[petId]
		local shiny = rng:NextNumber() < (if hasPass(prof, "shiny") then 3 else 1) / 200
		d.stats.hatched += 1
		local entry = { def = petId, shiny = shiny, new = isNew, deleted = false, power = def.power * (shiny and 1.5 or 1), chance = realChance(prof, egg, petId) }
		if def.rarity <= d.autoDelete and not shiny and not isNew then
			entry.deleted = true
		else
			local p = addPet(d, petId, 0, shiny)
			if equippedCount(d) < slots(prof) then
				p.eq = true
			end
		end
		table.insert(results, entry)
		if def.rarity >= Config.DIVINE then
			Fx:FireAllClients("toast", { text = "✨ " .. plr.DisplayName .. " a obtenu le pet DIVIN " .. def.name .. " ! ✨", color = "FFC93C" })
		elseif def.rarity >= Config.LEGENDARY then
			Fx:FireAllClients("toast", { text = plr.DisplayName .. " a obtenu " .. def.name .. " (" .. Config.Rarities[def.rarity].name .. ") !", color = if def.rarity >= Config.MYTHIC then "FF4F8B" else "FFB020" })
		end
	end
	refreshEquipped(plr)
	Fx:FireClient(plr, "hatch", { egg = eggId, results = results, auto = auto, fast = fast })
	return true
end

---------------------------------------------------------------------------
-- Boss Gummy Golem
---------------------------------------------------------------------------
local boss = {
	state = "idle",
	timer = 300,
	hp = 0,
	maxHp = 0,
	ends = 0,
	model = nil :: Model?,
	weak = nil :: BasePart?,
	weakT = 0,
	slamT = 0,
	warn = nil :: BasePart?,
	warnT = 0,
	dmg = {} :: { [Player]: number },
}

local function bossTap(plr: Player, weak: boolean)
	local prof = profiles[plr]
	if not prof or not prof.inBoss or boss.state ~= "open" then
		return
	end
	local now = os.clock()
	if now < prof.stunUntil or now - prof.lastTap < 0.08 then
		return
	end
	prof.lastTap = now
	nextCombo(prof, now)
	local dmg = tapDamage(prof) * (1 + 0.04 * (prof.combo - 1))
	local crit = rng:NextNumber() < 0.08 + 0.02 * up(prof, "crit")
	if weak then
		dmg *= 3
	end
	if crit then
		dmg *= 3
	end
	prof.data.stats.taps += 1
	boss.hp -= dmg
	boss.dmg[plr] = (boss.dmg[plr] or 0) + dmg
	local pos = if weak and boss.weak then boss.weak.Position else GOLEM_POS + Vector3.new(0, 16, 0)
	Fx:FireClient(plr, "tap", { pos = pos, dmg = dmg, crit = crit, weak = weak, combo = prof.combo })
end

local function spawnBoss()
	boss.state = "open"
	boss.ends = os.clock() + Config.BOSS_WINDOW + Config.BOSS_FIGHT
	boss.dmg = {}
	boss.maxHp = 3000
	boss.hp = boss.maxHp
	local model = PetModels.build("gummy_golem", 0, false, 9, false, nil, true)
	model.Name = "GummyGolem"
	model:PivotTo(CFrame.new(GOLEM_POS + Vector3.new(0, 8.6, 0)))
	local hit = part({ Parent = model, Name = "Hitbox", Size = Vector3.new(19, 18, 17), Position = GOLEM_POS + Vector3.new(0, 8.6, 0), Transparency = 1 })
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 120
	cd.Parent = hit
	cd.MouseClick:Connect(function(plr)
		bossTap(plr, false)
	end)
	local weak = part({ Parent = model, Name = "Weak", Size = Vector3.one * 3.4, Shape = Enum.PartType.Ball, Position = GOLEM_POS + Vector3.new(4, 12, -9), Color = Color3.fromHex("FFD54A"), Material = Enum.Material.Neon, CanCollide = false })
	local wcd = Instance.new("ClickDetector")
	wcd.MaxActivationDistance = 120
	wcd.Parent = weak
	wcd.MouseClick:Connect(function(plr)
		bossTap(plr, true)
	end)
	boss.weak = weak
	boss.weakT = 4
	boss.slamT = 6
	model.Parent = arena
	boss.model = model
	workspace:SetAttribute("BossState", "open")
	Fx:FireAllClients("toast", { text = "Le Gummy Golem est apparu ! Va le combattre !", color = "FF5A6E" })
end

local function leaveBoss(plr: Player)
	local prof = profiles[plr]
	if not prof or not prof.inBoss then
		return
	end
	prof.inBoss = false
	plr:SetAttribute("InBoss", false)
	refreshEquipped(plr)
	local char = plr.Character
	if char then
		char:PivotTo(worldSpawn(prof.data.world))
	end
end

local function endBoss(win: boolean)
	local total = 0
	for _, v in boss.dmg do
		total += v
	end
	for plr, prof in profiles do
		if not prof.inBoss then
			continue
		end
		local d = prof.data
		local share = (boss.dmg[plr] or 0) / math.max(total, 1)
		local coins, gems = 0, 0
		local text
		if win then
			d.stats.bosses += 1
			d.bossWins += 1
			coins = math.max(1000, estimatedCps(prof) * 90)
			gems = 15 + 5 * d.rebirths
			text = "Tu gagnes " .. Config.fmt(coins) .. " pièces et " .. gems .. " gemmes."
			if share > 0 and (d.bossWins == 1 or rng:NextNumber() < 0.2) and #d.pets < storage(prof) then
				local best = 0
				for _, p in d.pets do
					best = math.max(best, PetModels.power(p))
				end
				local g = addPet(d, "gummy_golem", 0, rng:NextNumber() < 0.1)
				g.bonus = math.max(50, best * 2.5)
				if equippedCount(d) < slots(prof) then
					g.eq = true
				end
				text ..= " Le Gummy Golem rejoint ton équipe (puissance " .. Config.fmt(PetModels.power(g)) .. ") !"
			end
		else
			coins = math.floor(math.max(200, estimatedCps(prof) * 30) * (1 - boss.hp / boss.maxHp))
			text = "Le golem s'est enfui… Tu récupères " .. Config.fmt(coins) .. " pièces. Améliore tes pets et reviens !"
		end
		addCoins(prof, coins, false)
		d.gems += gems
		prof.full = true
		Fx:FireClient(plr, "popup", { title = if win then "VICTOIRE !" else "Temps écoulé", body = text })
		task.delay(3, function()
			if plr.Parent then
				leaveBoss(plr)
			end
		end)
	end
	if boss.model then
		boss.model:Destroy()
	end
	if boss.warn then
		boss.warn:Destroy()
	end
	boss.model, boss.weak, boss.warn = nil, nil, nil
	boss.state = "idle"
	boss.timer = Config.BOSS_INTERVAL
	workspace:SetAttribute("BossState", "idle")
end

local function joinBoss(plr: Player)
	local prof = profiles[plr]
	if not prof or boss.state ~= "open" or prof.inBoss then
		return
	end
	local char = plr.Character
	if not char then
		return
	end
	prof.inBoss = true
	prof.autoHatch = nil
	plr:SetAttribute("InBoss", true)
	-- les PV du golem s'adaptent à chaque combattant qui arrive
	local extra = teamDps(prof) * 40 + tapDamage(prof) * 40
	boss.maxHp += extra
	boss.hp += extra
	char:PivotTo(ARENA_SPAWN)
	prof.full = true
end

local function updateBoss(dt: number)
	if boss.state == "idle" then
		boss.timer -= dt
		workspace:SetAttribute("BossTime", boss.timer)
		if boss.timer <= 0 then
			spawnBoss()
		end
		return
	end
	local now = os.clock()
	workspace:SetAttribute("BossTime", boss.ends - now)
	workspace:SetAttribute("BossHP", math.max(0, boss.hp))
	workspace:SetAttribute("BossMax", boss.maxHp)
	local fighters = {}
	for plr, prof in profiles do
		if prof.inBoss then
			table.insert(fighters, plr)
		end
	end
	-- point faible qui bouge
	boss.weakT -= dt
	if boss.weakT <= 0 and boss.weak then
		boss.weakT = 4
		local a = rng:NextNumber(0, math.pi * 2)
		boss.weak.Position = GOLEM_POS + Vector3.new(math.cos(a) * 6, 10 + math.sin(a) * 4, -9)
	end
	-- attaque « écrasement » sur un joueur au hasard
	if #fighters > 0 then
		boss.slamT -= dt
		if boss.slamT <= 0 and not boss.warn then
			local target = fighters[rng:NextInteger(1, #fighters)]
			local hrp = hrpOf(target)
			if hrp then
				local pos = Vector3.new(hrp.Position.X, BO.Y + 0.2, hrp.Position.Z)
				boss.warn = deco({ Parent = arena, Size = Vector3.new(0.3, 28, 28), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Shape = Enum.PartType.Cylinder, Color = Color3.fromHex("FF3355"), Material = Enum.Material.Neon, Transparency = 0.5 })
				boss.warnT = 1.5
			end
			boss.slamT = rng:NextNumber(5, 7)
		end
		local warnPart = boss.warn
		if warnPart then
			boss.warnT -= dt
			if boss.warnT <= 0 then
				local center = warnPart.Position
				warnPart:Destroy()
				boss.warn = nil
				Fx:FireAllClients("slam", { pos = center })
				for _, plr in fighters do
					local hrp = hrpOf(plr)
					local prof = profiles[plr]
					if hrp and prof and (Vector3.new(hrp.Position.X, center.Y, hrp.Position.Z) - center).Magnitude < 14 then
						prof.stunUntil = os.clock() + 2
						prof.combo = 0
						setWalkSpeed(plr)
						Fx:FireClient(plr, "stun", {})
					end
				end
			end
		end
	end
	if boss.hp <= 0 then
		endBoss(true)
	elseif now >= boss.ends then
		endBoss(false)
	end
end

---------------------------------------------------------------------------
-- Boucle des pets (dégâts, cibles, expérience)
---------------------------------------------------------------------------
local PET_TICK = 0.2

local function petTick()
	local assigned: { [number]: number } = {}
	for _, prof in profiles do
		for _, id in prof.targets do
			assigned[id] = (assigned[id] or 0) + 1
		end
	end
	local now = os.clock()
	for plr, prof in profiles do
		local hrp = hrpOf(plr)
		if not hrp then
			continue
		end
		local d = prof.data
		local mult = damageMult(prof)
		local function gainXp(p)
			if p.lvl < 25 then
				p.xp += PET_TICK
				local need = 25 + 15 * p.lvl
				if p.xp >= need then
					p.xp -= need
					p.lvl += 1
					prof.full = true
					Fx:FireClient(plr, "levelup", { name = Config.Pets[p.def].name, lvl = p.lvl })
				end
			end
		end
		if prof.inBoss then
			if boss.state == "open" then
				for _, p in prof.eq do
					local dmg = PetModels.power(p) * mult * PET_TICK
					boss.hp -= dmg
					boss.dmg[plr] = (boss.dmg[plr] or 0) + dmg
					gainXp(p)
				end
			end
			continue
		end
		local focus = if prof.focus then piles[prof.focus] else nil
		if focus and (focus.dead or focus.world ~= d.world or (focus.pos - hrp.Position).Magnitude > 120) then
			focus = nil
			prof.focus = nil
		end
		local strs = {}
		for slot, p in prof.eq do
			local tid = prof.targets[slot]
			local t = if tid then piles[tid] else nil
			if t and (t.dead or t.world ~= d.world or (t.pos - hrp.Position).Magnitude > 120) then
				t = nil
			end
			if focus then
				t = focus
			elseif not t and d.autoCollect then
				local best, bd = nil, 50
				for _, pile in piles do
					if pile.world == d.world and (assigned[pile.id] or 0) < 2 then
						local dist = (pile.pos - hrp.Position).Magnitude
						if dist < bd then
							best, bd = pile, dist
						end
					end
				end
				t = best
				if t then
					assigned[t.id] = (assigned[t.id] or 0) + 1
				end
			end
			local newId = if t then t.id else nil
			if newId ~= prof.targets[slot] then
				prof.targets[slot] = newId :: any
				prof.arrive[slot] = now + (if t then (t.pos - hrp.Position).Magnitude / 45 else 0)
			end
			table.insert(strs, tostring(newId or 0))
			if t and now >= (prof.arrive[slot] or 0) then
				damagePile(t, plr, PetModels.power(p) * mult * PET_TICK)
				gainXp(p)
			end
		end
		local s = table.concat(strs, ",")
		if s ~= prof.targetStr then
			prof.targetStr = s
			plr:SetAttribute("PetTargets", s)
		end
	end
end

---------------------------------------------------------------------------
-- Actions des joueurs
---------------------------------------------------------------------------
local handlers: { [string]: (Player, Profile, any) -> () } = {}

handlers.equip = function(plr, prof, uid)
	local p = findPet(prof.data, uid)
	if not p then
		return
	end
	if p.eq then
		p.eq = false
	elseif equippedCount(prof.data) < slots(prof) then
		p.eq = true
	else
		toast(plr, "Tous tes emplacements sont pleins")
		return
	end
	refreshEquipped(plr)
end

handlers.equipBest = function(plr, prof)
	local list = table.clone(prof.data.pets)
	table.sort(list, function(a, b)
		return PetModels.power(a) > PetModels.power(b)
	end)
	for i, p in list do
		p.eq = i <= slots(prof)
	end
	refreshEquipped(plr)
end

handlers.lock = function(plr, prof, uid)
	local p = findPet(prof.data, uid)
	if p then
		p.lock = not p.lock
		prof.full = true
	end
end

handlers.delete = function(plr, prof, uid)
	local p = findPet(prof.data, uid)
	if p and not p.lock then
		removePets(prof.data, { [p.uid] = true })
		refreshEquipped(plr)
	end
end

local function junk(prof: Profile): { [number]: boolean }
	local limit = math.max(Config.UNCOMMON, prof.data.autoDelete)
	local out = {}
	for _, p in prof.data.pets do
		if not p.eq and not p.lock and p.tier == 0 and not p.shiny and (p.bonus or 0) == 0 and Config.Pets[p.def].rarity <= limit then
			out[p.uid] = true
		end
	end
	return out
end

handlers.deleteJunk = function(plr, prof)
	removePets(prof.data, junk(prof))
	refreshEquipped(plr)
end

handlers.autoDelete = function(plr, prof, n)
	if type(n) == "number" and n >= 0 and n <= Config.RARE then
		prof.data.autoDelete = math.floor(n)
		prof.full = true
	end
end

handlers.autoCollect = function(plr, prof, on)
	prof.data.autoCollect = on == true
	prof.full = true
end

handlers.fuse = function(plr, prof, uid)
	local d = prof.data
	local p = findPet(d, uid)
	if not p or p.tier >= 2 or (p.bonus or 0) > 0 then
		return
	end
	local others = {}
	for _, o in d.pets do
		if o.uid ~= p.uid and o.def == p.def and o.tier == p.tier and not o.lock and (o.bonus or 0) == 0 then
			table.insert(others, o)
		end
	end
	if #others < 4 then
		toast(plr, "Il faut 5 pets identiques")
		return
	end
	-- on garde en priorité les pets équipés hors de la fusion
	table.sort(others, function(a, b)
		return (not a.eq) and b.eq
	end)
	local group = { p, others[1], others[2], others[3], others[4] }
	local rm, wasEq, shiny = {}, false, false
	for _, g in group do
		rm[g.uid] = true
		wasEq = wasEq or g.eq
		shiny = shiny or g.shiny
	end
	removePets(d, rm)
	local np = addPet(d, p.def, p.tier + 1, shiny)
	np.eq = wasEq
	if np.tier == 1 then
		d.stats.golden += 1
		toast(plr, Config.Pets[p.def].name .. " doré obtenu !", "FFD54A")
	else
		d.stats.rainbow += 1
		toast(plr, Config.Pets[p.def].name .. " arc-en-ciel obtenu !", "FF8FB8")
	end
	refreshEquipped(plr)
	Fx:FireClient(plr, "fused", { uid = np.uid })
end

handlers.hatch = function(plr, prof, eggId)
	if type(eggId) == "string" then
		hatch(plr, eggId, false)
	end
end

handlers.autoHatch = function(plr, prof, eggId)
	if type(eggId) == "string" and Config.Eggs[eggId] and hasPass(prof, "auto") then
		prof.autoHatch = eggId
	else
		prof.autoHatch = nil
	end
	prof.full = true
end

handlers.upgrade = function(plr, prof, id)
	for _, u in Config.Upgrades do
		if u.id == id then
			local lvl = up(prof, id)
			if lvl >= u.max then
				return
			end
			if spend(plr, prof, Config.upgradeCost(u, lvl), u.gem) then
				prof.data.upgrades[id] = lvl + 1
				prof.data.stats.upgrades += 1
				setWalkSpeed(plr)
				Fx:FireClient(plr, "bought", {})
				if id == "slot" then
					refreshEquipped(plr)
				end
			end
			return
		end
	end
end

handlers.potion = function(plr, prof, id)
	for _, p in Config.Potions do
		if p.id == id and spend(plr, prof, p.gems, true) then
			prof.data.potions[id] = (prof.data.potions[id] or 0) + Config.POTION_TIME
			Fx:FireClient(plr, "bought", {})
		end
	end
end

handlers.pass = function(plr, prof, id)
	for _, p in Config.Passes do
		if p.id == id and not hasPass(prof, id) and (Config.GamePassIds :: any)[id] == 0 then
			if spend(plr, prof, p.gems, true) then
				prof.data.passes[id] = true
				toast(plr, "Pass " .. p.name .. " activé !", "3DD68C")
				refreshEquipped(plr)
				Fx:FireClient(plr, "bought", {})
			end
		end
	end
end

local function teleport(plr: Player, prof: Profile, w: number)
	prof.data.world = w
	prof.focus = nil
	prof.autoHatch = nil
	local char = plr.Character
	if char then
		char:PivotTo(worldSpawn(w))
	end
	refreshEquipped(plr)
end

handlers.unlock = function(plr, prof)
	local d = prof.data
	local nextW = Config.Worlds[d.maxWorld + 1]
	if not nextW then
		return
	end
	if spend(plr, prof, nextW.unlock, false) then
		d.maxWorld += 1
		toast(plr, nextW.name .. " débloqué !", "FFD54A")
		teleport(plr, prof, d.maxWorld)
	end
end

handlers.teleport = function(plr, prof, w)
	if type(w) == "number" and w >= 1 and w <= prof.data.maxWorld and not prof.inBoss then
		teleport(plr, prof, math.floor(w))
	end
end

handlers.rebirth = function(plr, prof)
	local d = prof.data
	local cost = Config.rebirthCost(d.rebirths)
	if d.coins < cost or prof.inBoss then
		return
	end
	d.rebirths += 1
	d.coins = 0
	d.maxWorld = 1
	d.gems += 10 * d.rebirths
	teleport(plr, prof, 1)
	prof.money = true
	Fx:FireClient(plr, "rebirth", { n = d.rebirths, mult = Config.rebirthMult(d.rebirths) })
end

handlers.quest = function(plr, prof)
	local q, prog = questProgress(prof)
	if not q or prog < q.goal then
		return
	end
	local d = prof.data
	addCoins(prof, q.coins, false)
	d.gems += q.gems
	d.quest += 1
	local nq = Config.StarterQuests[d.quest]
	if nq then
		d.questBase = metric(prof, nq.kind)
	end
	prof.full = true
	Fx:FireClient(plr, "claimed", {})
end

handlers.daily = function(plr, prof, i)
	local dq = if type(i) == "number" then prof.data.daily[i] else nil
	if dq and not dq.claimed and metric(prof, dq.kind) - dq.base >= dq.target then
		dq.claimed = true
		prof.data.gems += dq.gems
		prof.full = true
		Fx:FireClient(plr, "claimed", {})
	end
end

handlers.gift = function(plr, prof)
	local d = prof.data
	if d.giftDay == today() then
		return
	end
	local day = if d.giftDay == yesterday() then d.giftStreak % 7 + 1 else 1
	if day == 1 then
		addCoins(prof, roundNice(math.max(500, estimatedCps(prof) * 180)), false)
	elseif day == 2 then
		d.gems += 10
	elseif day == 3 then
		d.potions.coins = (d.potions.coins or 0) + Config.POTION_TIME
	elseif day == 4 then
		d.gems += 15
	elseif day == 5 then
		d.potions.luck = (d.potions.luck or 0) + Config.POTION_TIME
	elseif day == 6 then
		d.gems += 25
	else
		d.gems += 50
		d.potions.dmg = (d.potions.dmg or 0) + Config.POTION_TIME
	end
	d.giftDay = today()
	d.giftStreak = day
	prof.full = true
	Fx:FireClient(plr, "claimed", {})
end

handlers.index = function(plr, prof)
	local d = prof.data
	local m = Config.IndexMilestones[d.indexClaim + 1]
	if m and indexCount(d) >= math.min(m.need, #Config.PetOrder) then
		d.indexClaim += 1
		d.gems += m.gems
		prof.full = true
		Fx:FireClient(plr, "claimed", {})
	end
end

handlers.joinBoss = function(plr, prof)
	joinBoss(plr)
end

handlers.leaveBoss = function(plr, prof)
	leaveBoss(plr)
end

---------------------------------------------------------------------------
-- Marteaux à bonbons : tirages, équipement, marteau dans la main
---------------------------------------------------------------------------
local hammersByRarity: { [number]: { string } } = {}
for _, h in Config.Hammers do
	hammersByRarity[h.rarity] = hammersByRarity[h.rarity] or {}
	table.insert(hammersByRarity[h.rarity], h.id)
end

local function rollHammer(): string
	local x = rng:NextNumber() * 100
	for r = 6, 2, -1 do
		local odds = Config.HAMMER_ODDS[r] or 0
		if x < odds and hammersByRarity[r] then
			local list = hammersByRarity[r]
			return list[rng:NextInteger(1, #list)]
		end
		x -= odds
	end
	local list = hammersByRarity[1]
	return list[rng:NextInteger(1, #list)]
end

local function attachHammer(plr: Player)
	local prof = profiles[plr]
	local char = plr.Character
	if not prof or not char then
		return
	end
	local old = char:FindFirstChild("HeldHammer")
	if old then
		old:Destroy()
	end
	local hand = (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or char:WaitForChild("RightHand", 5)) :: BasePart?
	if not hand then
		return
	end
	local model = HammerModels.build(prof.data.hammer, 0.8, false)
	model.Name = "HeldHammer"
	local grip = hand.CFrame * CFrame.new(0, -0.2, -0.1) * CFrame.Angles(math.rad(-90), 0, 0)
	local handle = model.PrimaryPart :: BasePart
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			part.CFrame = grip * part.CFrame
		end
	end
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part ~= handle then
			local wc = Instance.new("WeldConstraint")
			wc.Part0 = handle
			wc.Part1 = part
			wc.Parent = part
		end
	end
	local weld = Instance.new("Weld")
	weld.Name = "Grip"
	weld.Part0 = hand
	weld.Part1 = handle
	weld.C0 = hand.CFrame:ToObjectSpace(handle.CFrame)
	weld.Parent = handle
	model.Parent = char
end

handlers.hammerRoll = function(plr, prof, n)
	local d = prof.data
	local count = if n == 10 then 10 else 1
	local price = math.floor(math.max(300, estimatedCps(prof) * Config.HAMMER_ROLL_SECONDS))
	local cost = if count == 10 then price * 9 else price
	if not spend(plr, prof, cost, false) then
		return
	end
	local results = {}
	local refund = 0
	for _ = 1, count do
		local id = rollHammer()
		local isNew = not d.hammers[id]
		if isNew then
			d.hammers[id] = true
		else
			refund += math.floor(price * Config.HAMMER_REFUND)
		end
		table.insert(results, { id = id, new = isNew })
		local hd = HammerModels.def(id)
		if hd.rarity >= 5 and isNew then
			Fx:FireAllClients("toast", { text = plr.DisplayName .. " a tiré le " .. hd.name .. " (" .. Config.Rarities[hd.rarity].name .. ") !", color = "FFB020" })
		end
	end
	if refund > 0 then
		addCoins(prof, refund, false)
	end
	prof.full = true
	Fx:FireClient(plr, "hammerRoll", { results = results, refund = refund })
end

handlers.hammerEquip = function(plr, prof, id)
	if type(id) == "string" and prof.data.hammers[id] then
		prof.data.hammer = id
		prof.full = true
		attachHammer(plr)
	end
end

Action.OnServerEvent:Connect(function(plr: Player, name: any, arg: any)
	local prof = profiles[plr]
	if not prof or type(name) ~= "string" then
		return
	end
	local h = handlers[name]
	if h then
		local ok, err = pcall(h, plr, prof, arg)
		if not ok then
			warn("[SweetPets] action", name, err)
		end
	end
end)

-- Invites de proximité : œufs et panneaux
for _, pr in prompts do
	pr.Triggered:Connect(function(plr)
		local kind = pr:GetAttribute("Kind")
		local value = pr:GetAttribute("Value") :: string
		if kind == "egg" then
			hatch(plr, value, false)
		else
			Fx:FireClient(plr, "panel", { name = value })
		end
	end)
end

---------------------------------------------------------------------------
-- Robux (si configurés dans Config)
---------------------------------------------------------------------------
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, passId, bought)
	if not bought then
		return
	end
	local prof = profiles[plr]
	if not prof then
		return
	end
	for id, gid in Config.GamePassIds :: any do
		if gid ~= 0 and gid == passId then
			prof.robux[id] = true
			toast(plr, "Merci ! Pass activé.", "3DD68C")
			refreshEquipped(plr)
		end
	end
end)

local save: (Player) -> () -- définie plus bas

-- produits Robux : gemmes, pièces, potions, chance du serveur
local function grantProduct(plr: Player, prof: Profile, prod: Config.Product)
	local d = prof.data
	if prod.kind == "gems" then
		d.gems += prod.amount
		toast(plr, "+" .. prod.amount .. " gemmes, merci !", "7FD6FF")
	elseif prod.kind == "coins" then
		local v = roundNice(math.max(1000, estimatedCps(prof) * prod.amount))
		addCoins(prof, v, false)
		toast(plr, "+" .. Config.fmt(v) .. " pièces, merci !", "FFD54A")
	elseif prod.kind == "potions" then
		for _, pt in Config.Potions do
			d.potions[pt.id] = (d.potions[pt.id] or 0) + prod.amount
		end
		toast(plr, "Potions activées, merci !", "7EE0B8")
	elseif prod.kind == "serverLuck" then
		serverLuckEnds = math.max(serverLuckEnds, os.time()) + prod.amount
		workspace:SetAttribute("ServerLuckEnds", serverLuckEnds)
		Fx:FireAllClients("toast", { text = "🍀 " .. plr.DisplayName .. " offre la CHANCE x2 à tout le serveur !", color = "3DD68C" })
	end
	prof.full = true
	prof.money = true
	Fx:FireClient(plr, "bought", {})
end

MarketplaceService.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	local prof = if plr then profiles[plr] else nil
	if not plr or not prof then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- un même achat ne doit être donné qu'une fois
	local seen = prof.data.receipts
	if table.find(seen, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	for _, prod in Config.Products do
		if prod.id ~= 0 and prod.id == info.ProductId then
			grantProduct(plr, prof, prod)
			table.insert(seen, info.PurchaseId)
			if #seen > 50 then
				table.remove(seen, 1)
			end
			task.spawn(save, plr)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

---------------------------------------------------------------------------
-- Connexion / déconnexion / sauvegarde
---------------------------------------------------------------------------
save = function(plr: Player)
	local prof = profiles[plr]
	local ds = store
	if not prof or not prof.canSave or not ds then
		return
	end
	prof.data.lastSeen = os.time()
	local ok, err = pcall(function()
		ds:SetAsync("p_" .. plr.UserId, prof.data)
	end)
	if not ok then
		warn("[SweetPets] sauvegarde impossible :", err)
	end
end

local function onCharacter(plr: Player, char: Model)
	local prof = profiles[plr]
	if not prof then
		return
	end
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hrp or not hum then
		return
	end
	prof.inBoss = false
	prof.stunUntil = 0
	plr:SetAttribute("InBoss", false)
	task.wait(0.1)
	char:PivotTo(worldSpawn(prof.data.world))
	setWalkSpeed(plr)
	refreshEquipped(plr)
	attachHammer(plr)
end

local function onPlayer(plr: Player)
	local data = nil
	local canSave = true
	local ds = store
	if ds then
		local ok, result = false, nil
		for _ = 1, 3 do
			ok, result = pcall(function()
				return ds:GetAsync("p_" .. plr.UserId)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
		if ok then
			data = result
		else
			-- on ne sauvegarde pas pour ne pas écraser une partie qu'on n'a pas pu lire
			canSave = false
			warn("[SweetPets] chargement impossible, partie temporaire :", result)
		end
	else
		canSave = false
	end
	if type(data) ~= "table" then
		data = defaultData()
	else
		reconcile(data, defaultData())
	end
	if not plr.Parent then
		return
	end
	local prof: Profile = {
		data = data,
		canSave = canSave,
		full = true,
		money = true,
		focus = nil,
		targets = {},
		arrive = {},
		eq = {},
		lastTap = 0,
		combo = 0,
		comboT = 0,
		lastHatch = 0,
		autoHatch = nil,
		stunUntil = 0,
		inBoss = false,
		robux = {},
		cpsAcc = 0,
		cpsHist = {},
		cps = 0,
		targetStr = "",
	}
	profiles[plr] = prof
	if data.world > data.maxWorld then
		data.world = data.maxWorld
	end
	for id, gid in Config.GamePassIds :: any do
		if gid ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(plr.UserId, gid)
			end)
			if ok and owns then
				prof.robux[id] = true
			end
		end
	end

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local c = Instance.new("StringValue")
	c.Name = "Pièces"
	c.Parent = ls
	local r = Instance.new("IntValue")
	r.Name = "Rebirths"
	r.Parent = ls
	ls.Parent = plr

	refreshDaily(prof)
	refreshEquipped(plr)

	-- gains hors ligne
	if data.lastSeen > 0 then
		local away = os.time() - data.lastSeen
		if away > 120 then
			local capped = math.min(away, 8 * 3600)
			local earn = math.floor(estimatedCps(prof) * capped * 0.25)
			if earn > 0 then
				addCoins(prof, earn, false)
				task.delay(4, function()
					Fx:FireClient(plr, "popup", { title = "Bon retour !", body = "Pendant ton absence (" .. Config.fmtTime(capped) .. "), tes pets ont récolté " .. Config.fmt(earn) .. " pièces." })
				end)
			end
		end
	end

	plr.CharacterAdded:Connect(function(char)
		onCharacter(plr, char)
	end)
	if plr.Character then
		task.spawn(onCharacter, plr, plr.Character)
	end
	sendState(plr)
end

---------------------------------------------------------------------------
-- Panneau admin (IA, actions manuelles, admin abusé, annonces traduites)
---------------------------------------------------------------------------
require(script:WaitForChild("Admin")).start({
	Config = Config,
	profiles = profiles,
	events = adminEvents,
	remotes = remotes,
	Fx = Fx,
	toast = toast,
	addCoins = addCoins,
	addPet = addPet,
	teleport = teleport,
	setWalkSpeed = setWalkSpeed,
	defaultData = defaultData,
	spawnBoss = function(): boolean
		if boss.state ~= "idle" then
			return false
		end
		spawnBoss()
		return true
	end,
})

Players.PlayerAdded:Connect(onPlayer)
for _, plr in Players:GetPlayers() do
	task.spawn(onPlayer, plr)
end

Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	profiles[plr] = nil
end)

game:BindToClose(function()
	for plr in profiles do
		task.spawn(save, plr)
	end
	task.wait(if RunService:IsStudio() then 1 else 3)
end)

---------------------------------------------------------------------------
-- Boucles
---------------------------------------------------------------------------
local acc, secAcc, spawnAcc, saveAcc = 0, 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	secAcc += dt
	spawnAcc += dt
	saveAcc += dt
	if acc >= PET_TICK then
		acc -= PET_TICK
		petTick()
		updateBoss(PET_TICK)
		for plr, prof in profiles do
			-- auto-éclosion
			local auto = prof.autoHatch
			if auto then
				local stand = eggStands[auto]
				local hrp = hrpOf(plr)
				if not stand or not hrp or (hrp.Position - stand).Magnitude > 24 or prof.inBoss then
					prof.autoHatch = nil
					prof.full = true
				else
					hatch(plr, auto, true)
				end
			end
			if prof.full then
				sendState(plr)
			elseif prof.money then
				sendMoney(plr)
			end
		end
	end
	if spawnAcc >= 0.5 then
		spawnAcc = 0
		for wi = 1, #Config.Worlds do
			if pileCount[wi] < 26 then
				spawnPile(wi)
			end
		end
	end
	if secAcc >= 1 then
		secAcc -= 1
		for plr, prof in profiles do
			local d = prof.data
			d.stats.play += 1
			for id, left in d.potions do
				if left > 0 then
					d.potions[id] = left - 1
					if d.potions[id] <= 0 then
						d.potions[id] = nil
						toast(plr, "Une potion vient de se terminer")
						prof.full = true
					end
				end
			end
			table.insert(prof.cpsHist, prof.cpsAcc)
			prof.cpsAcc = 0
			if #prof.cpsHist > 10 then
				table.remove(prof.cpsHist, 1)
			end
			local sum = 0
			for _, v in prof.cpsHist do
				sum += v
			end
			prof.cps = sum / #prof.cpsHist
			if d.dailyDay ~= today() then
				refreshDaily(prof)
			end
			-- les quêtes dépendent de compteurs : on rafraîchit l'état toutes les 2 s
			if d.stats.play % 2 == 0 then
				prof.full = true
			end
			if prof.stunUntil > 0 and os.clock() >= prof.stunUntil then
				prof.stunUntil = 0
				setWalkSpeed(plr)
			end
		end
	end
	if saveAcc >= 90 then
		saveAcc = 0
		for plr in profiles do
			task.spawn(save, plr)
		end
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">Admin</string>
          <string name="Source"><![CDATA[-- Panneau admin (côté serveur) : actions manuelles, assistant IA (Claude), événements
-- « admin abusé » et annonces traduites dans la langue de chaque joueur.
-- Toutes les actions sont vérifiées ici : un joueur qui n'est pas admin ne peut rien faire.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ServerStorage = game:GetService("ServerStorage")

local Admin = {}

local API_URL = "https://api.anthropic.com/v1/messages"
local MODEL = "claude-opus-5-5"
local SECRET_NAME = "anthropic_api_key"

-- Libellés et icônes des événements « admin abusé »
local ABUSE = {
	coins_x = { label = "Pièces x%s", icon = "🟡", default = 10 },
	luck_x = { label = "Chance x%s", icon = "🍀", default = 10 },
	damage_x = { label = "Dégâts x%s", icon = "💪", default = 10 },
	speed_x = { label = "Vitesse x%s", icon = "⚡", default = 2 },
	coin_rain = { label = "Pluie de pièces", icon = "💰", default = 30 },
	low_gravity = { label = "Gravité lunaire", icon = "🌙", default = 0.25 },
	giant = { label = "Géants", icon = "🦖", default = 3 },
	tiny = { label = "Minis", icon = "🐜", default = 0.4 },
	disco = { label = "Disco", icon = "🪩", default = 1 },
	night = { label = "Nuit étoilée", icon = "🌌", default = 1 },
}

function Admin.start(api)
	local Config = api.Config
	local profiles = api.profiles
	local events = api.events -- multiplicateurs lus par l'économie du serveur
	local Fx = api.Fx

	local active: { [string]: any } = {} -- kind -> { value, ends }
	local logLines: { string } = {}
	local chats: { [number]: { any } } = {}
	local busy: { [number]: boolean } = {}

	local function log(who: string, text: string)
		table.insert(logLines, 1, os.date("!%H:%M") .. " · " .. who .. " · " .. text)
		if #logLines > 40 then
			table.remove(logLines)
		end
	end

	-------------------------------------------------------------------------
	-- Qui est admin ?
	-------------------------------------------------------------------------
	local function isAdmin(plr: Player): boolean
		if RunService:IsStudio() then
			return true
		end
		if table.find(Config.AdminIds, plr.UserId) then
			return true
		end
		if game.CreatorType == Enum.CreatorType.User then
			return plr.UserId == game.CreatorId
		end
		local ok, rank = pcall(plr.GetRankInGroupAsync, plr, game.CreatorId)
		return ok and rank >= 255
	end

	local function markAdmin(plr: Player)
		task.spawn(function()
			plr:SetAttribute("IsAdmin", isAdmin(plr))
		end)
	end
	Players.PlayerAdded:Connect(markAdmin)
	for _, plr in Players:GetPlayers() do
		markAdmin(plr)
	end

	-------------------------------------------------------------------------
	-- Cibles : "all", "me", ou un nom (début du pseudo ou du nom affiché)
	-------------------------------------------------------------------------
	local function targets(admin: Player, who: any): { Player }
		local s = string.lower(tostring(who or "me"))
		if s == "me" or s == "moi" or s == "" then
			return { admin }
		end
		if s == "all" or s == "tous" or s == "tout le monde" then
			return Players:GetPlayers()
		end
		local out = {}
		for _, p in Players:GetPlayers() do
			if string.sub(string.lower(p.Name), 1, #s) == s or string.sub(string.lower(p.DisplayName), 1, #s) == s then
				table.insert(out, p)
			end
		end
		return out
	end

	local function names(list: { Player }): string
		local n = {}
		for _, p in list do
			table.insert(n, p.DisplayName)
		end
		return table.concat(n, ", ")
	end

	local function refresh(plr: Player)
		local prof = profiles[plr]
		if prof then
			prof.full = true
			prof.money = true
		end
	end

	-------------------------------------------------------------------------
	-- Clé API : secret Roblox (jeu publié) ou StringValue dans ServerStorage (tests)
	-------------------------------------------------------------------------
	local function apiKey(): any
		local ok, secret = pcall(function()
			return HttpService:GetSecret(SECRET_NAME)
		end)
		if ok and secret then
			return secret
		end
		local v = ServerStorage:FindFirstChild("ClaudeApiKey")
		if v and v:IsA("StringValue") and v.Value ~= "" then
			return v.Value
		end
		return nil
	end

	-- JSONEncode transforme une table vide en [] : l'API attend {} pour ces champs
	local function encode(body: any): string
		local s = HttpService:JSONEncode(body)
		s = string.gsub(s, '"input":%[%]', '"input":{}')
		s = string.gsub(s, '"properties":%[%]', '"properties":{}')
		return s
	end

	local function callClaude(body: any): (any, string?)
		local key = apiKey()
		if not key then
			return nil, "Clé API manquante : ajoute le secret « " .. SECRET_NAME .. " » (ou une StringValue ClaudeApiKey dans ServerStorage pour tester)."
		end
		body.model = MODEL
		body.fallbacks = "default"
		local ok, res = pcall(function()
			return HttpService:RequestAsync({
				Url = API_URL,
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json",
					["x-api-key"] = key,
					["anthropic-version"] = "2026-10-21",
					["anthropic-beta"] = "server-side-fallback-2026-07-01",
				},
				Body = encode(body),
			})
		end)
		if not ok then
			return nil, "Requête impossible (" .. tostring(res) .. "). Active Game Settings › Security › Allow HTTP Requests."
		end
		if not res.Success then
			return nil, string.format("Erreur de l'API (%d) : %s", res.StatusCode, string.sub(res.Body, 1, 300))
		end
		local okJson, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
		if not okJson then
			return nil, "Réponse illisible de l'API"
		end
		return data, nil
	end

	-------------------------------------------------------------------------
	-- Traduction des annonces (une seule requête pour toutes les langues présentes)
	-------------------------------------------------------------------------
	local function translate(text: string, locales: { string }): { [string]: string }?
		local props, required = {}, {}
		for _, loc in locales do
			props[loc] = { type = "string" }
			table.insert(required, loc)
		end
		local data = callClaude({
			max_tokens = 4000,
			output_config = {
				effort = "low",
				format = { type = "json_schema", schema = { type = "object", properties = props, required = required, additionalProperties = false } },
			},
			system = "Tu traduis les annonces d'un jeu Roblox pour enfants et ados. Pour chaque code de langue Roblox demandé (ex. en-us, es-es, pt-br), donne la traduction naturelle du message, en gardant les emojis, les noms propres et le ton. Si la langue est celle du message, recopie-le.",
			messages = { { role = "user", content = "Langues : " .. table.concat(locales, ", ") .. "\nMessage :\n" .. text } },
		})
		if not data or data.stop_reason ~= "end_turn" then
			return nil
		end
		for _, block in data.content do
			if block.type == "text" then
				local ok, map = pcall(HttpService.JSONDecode, HttpService, block.text)
				if ok and type(map) == "table" then
					return map
				end
			end
		end
		return nil
	end

	local function announce(from: string, text: string, translateIt: boolean, color: string?)
		local list = Players:GetPlayers()
		local map: { [string]: string }? = nil
		if translateIt then
			local seen, locales = {}, {}
			for _, p in list do
				local loc = string.lower(p.LocaleId)
				if not seen[loc] then
					seen[loc] = true
					table.insert(locales, loc)
				end
			end
			map = translate(text, locales)
		end
		for _, p in list do
			local msg = (map and map[string.lower(p.LocaleId)]) or text
			Fx:FireClient(p, "announce", { text = msg, from = from, color = color or "FF8FB8" })
		end
		return if translateIt and not map then "Annonce envoyée sans traduction (IA indisponible)" else "Annonce envoyée à " .. #list .. " joueur(s)" .. (if map then ", traduite" else "")
	end

	-------------------------------------------------------------------------
	-- Événements « admin abusé »
	-------------------------------------------------------------------------
	local function broadcastAbuse()
		local list = {}
		for kind, ev in active do
			local info = ABUSE[kind]
			table.insert(list, { kind = kind, icon = info.icon, label = string.format(info.label, tostring(ev.value)), left = math.max(0, math.floor(ev.ends - os.clock())) })
		end
		Fx:FireAllClients("abuse", { list = list })
	end

	local function applyScale(char: Model?, s: number)
		if char and math.abs(char:GetScale() - s) > 0.01 then
			pcall(char.ScaleTo, char, s)
		end
	end

	local function stopAbuse(kind: string)
		active[kind] = nil
		if kind == "coins_x" then
			events.coins = 1
		elseif kind == "luck_x" then
			events.luck = 1
		elseif kind == "damage_x" then
			events.dmg = 1
		elseif kind == "speed_x" then
			events.speed = 1
			for _, p in Players:GetPlayers() do
				api.setWalkSpeed(p)
			end
		elseif kind == "low_gravity" then
			workspace.Gravity = 196.2
		elseif kind == "giant" or kind == "tiny" then
			if not active.giant and not active.tiny then
				for _, p in Players:GetPlayers() do
					applyScale(p.Character, 1)
				end
			end
		elseif kind == "night" then
			Lighting.ClockTime = 14
		end
	end

	local function startAbuse(kind: string, value: number?, minutes: number?): string
		local info = ABUSE[kind]
		if not info then
			return "Événement inconnu : " .. tostring(kind)
		end
		local v = tonumber(value) or info.default
		local mins = math.clamp(tonumber(minutes) or 5, 0.25, 60)
		if kind == "giant" then
			active.tiny = nil
			v = math.clamp(v, 1, 5)
		elseif kind == "tiny" then
			active.giant = nil
			v = math.clamp(v, 0.25, 1)
		elseif kind == "low_gravity" then
			v = math.clamp(v, 0.05, 1)
			workspace.Gravity = 196.2 * v
		elseif kind == "night" then
			Lighting.ClockTime = 0
		elseif string.sub(kind, -2) == "_x" then
			v = math.clamp(v, 1, 100)
		end
		active[kind] = { value = v, ends = os.clock() + mins * 60 }
		if kind == "coins_x" then
			events.coins = v
		elseif kind == "luck_x" then
			events.luck = v
		elseif kind == "damage_x" then
			events.dmg = v
		elseif kind == "speed_x" then
			events.speed = math.clamp(v, 1, 5)
			for _, p in Players:GetPlayers() do
				api.setWalkSpeed(p)
			end
		end
		broadcastAbuse()
		Fx:FireAllClients("toast", { text = "🔥 ADMIN ABUSE : " .. info.icon .. " " .. string.format(info.label, tostring(v)) .. " pendant " .. mins .. " min !", color = "FF4F8B" })
		return string.format("%s lancé (%s, %s min)", string.format(info.label, tostring(v)), tostring(v), tostring(mins))
	end

	-- boucle : fin des événements, pluie de pièces, taille des personnages
	task.spawn(function()
		while true do
			task.wait(1)
			local changed = false
			for kind, ev in active do
				if os.clock() >= ev.ends then
					stopAbuse(kind)
					changed = true
				end
			end
			local rain = active.coin_rain
			if rain then
				for plr, prof in profiles do
					api.addCoins(prof, math.max(50, prof.cps * rain.value), false)
				end
				Fx:FireAllClients("coinRain", {})
			end
			local sc = (active.giant and active.giant.value) or (active.tiny and active.tiny.value)
			if sc then
				for _, p in Players:GetPlayers() do
					applyScale(p.Character, sc)
				end
			end
			if changed then
				broadcastAbuse()
			end
		end
	end)
	Players.PlayerAdded:Connect(function()
		task.wait(3)
		broadcastAbuse()
	end)

	-------------------------------------------------------------------------
	-- Actions (les mêmes pour les boutons et pour l'IA)
	-------------------------------------------------------------------------
	local petIds = {}
	for _, id in Config.PetOrder do
		table.insert(petIds, id)
	end
	local potionIds = {}
	for _, p in Config.Potions do
		table.insert(potionIds, p.id)
	end
	local abuseKinds = {}
	for k in ABUSE do
		table.insert(abuseKinds, k)
	end
	table.sort(abuseKinds)

	local PLAYER = { type = "string", description = "« me » (l'admin), « all » (tout le monde) ou le début du pseudo d'un joueur" }
	local TOOLS = {}
	local function tool(name: string, description: string, props: any, required: { string }, run: (Player, any) -> string)
		TOOLS[name] = { name = name, description = description, input_schema = { type = "object", properties = props, required = required }, run = run }
	end

	tool("list_players", "Liste les joueurs du serveur avec leurs pièces, gemmes, pets, monde et rebirths.", { detail = { type = "boolean", description = "Inutilisé, laisser vide" } }, {}, function()
		local lines = {}
		for _, p in Players:GetPlayers() do
			local prof = profiles[p]
			if prof then
				local d = prof.data
				table.insert(lines, string.format("%s (@%s) : %s pièces, %d gemmes, %d pets, monde %d/%d, %d rebirths", p.DisplayName, p.Name, Config.fmt(d.coins), d.gems, #d.pets, d.world, d.maxWorld, d.rebirths))
			end
		end
		return if #lines > 0 then table.concat(lines, "\n") else "Aucun joueur chargé"
	end)

	tool("give_currency", "Donne (ou retire si négatif) des pièces ou des gemmes.", {
		player = PLAYER,
		currency = { type = "string", enum = { "coins", "gems" } },
		amount = { type = "number", description = "Quantité, négative pour retirer" },
	}, { "player", "currency", "amount" }, function(admin, a)
		local list = targets(admin, a.player)
		local amount = tonumber(a.amount) or 0
		for _, p in list do
			local prof = profiles[p]
			if prof then
				if a.currency == "gems" then
					prof.data.gems = math.max(0, math.floor(prof.data.gems + amount))
				elseif amount >= 0 then
					api.addCoins(prof, amount, false)
				else
					prof.data.coins = math.max(0, prof.data.coins + amount)
				end
				refresh(p)
				api.toast(p, string.format("Un admin t'a donné %s %s", Config.fmt(amount), if a.currency == "gems" then "gemmes" else "pièces"), "FFD54A")
			end
		end
		return string.format("%s %s → %s", Config.fmt(amount), a.currency, if #list > 0 then names(list) else "personne (joueur introuvable)")
	end)

	tool("give_pet", "Donne un ou plusieurs pets. tier : 0 normal, 1 doré, 2 arc-en-ciel.", {
		player = PLAYER,
		pet = { type = "string", enum = petIds },
		tier = { type = "integer", enum = { 0, 1, 2 } },
		shiny = { type = "boolean" },
		count = { type = "integer", description = "1 à 20" },
	}, { "player", "pet" }, function(admin, a)
		local def = Config.Pets[a.pet]
		if not def then
			return "Pet inconnu : " .. tostring(a.pet)
		end
		local list = targets(admin, a.player)
		local n = math.clamp(math.floor(tonumber(a.count) or 1), 1, 20)
		local tier = math.clamp(math.floor(tonumber(a.tier) or 0), 0, 2)
		for _, p in list do
			local prof = profiles[p]
			if prof then
				for _ = 1, n do
					api.addPet(prof.data, a.pet, tier, a.shiny == true)
				end
				refresh(p)
				api.toast(p, "Un admin t'a donné " .. n .. " × " .. def.name .. " !", "FF8FB8")
			end
		end
		return string.format("%d × %s → %s", n, def.name, if #list > 0 then names(list) else "personne")
	end)

	tool("give_potion", "Donne une potion active pendant un nombre de minutes.", {
		player = PLAYER,
		potion = { type = "string", enum = potionIds },
		minutes = { type = "number" },
	}, { "player", "potion" }, function(admin, a)
		local list = targets(admin, a.player)
		local secs = math.clamp(math.floor((tonumber(a.minutes) or 10) * 60), 30, 6 * 3600)
		for _, p in list do
			local prof = profiles[p]
			if prof then
				prof.data.potions[a.potion] = (prof.data.potions[a.potion] or 0) + secs
				refresh(p)
			end
		end
		return string.format("Potion %s (%d min) → %s", tostring(a.potion), secs // 60, names(list))
	end)

	tool("teleport", "Téléporte des joueurs dans un monde (débloque ce monde si besoin).", {
		player = PLAYER,
		world = { type = "integer", description = "1 à " .. #Config.Worlds },
	}, { "player", "world" }, function(admin, a)
		local w = math.clamp(math.floor(tonumber(a.world) or 1), 1, #Config.Worlds)
		local list = targets(admin, a.player)
		for _, p in list do
			local prof = profiles[p]
			if prof and not prof.inBoss then
				prof.data.maxWorld = math.max(prof.data.maxWorld, w)
				api.teleport(p, prof, w)
				refresh(p)
			end
		end
		return "Téléportation vers " .. Config.Worlds[w].name .. " : " .. names(list)
	end)

	tool("spawn_boss", "Fait apparaître le boss Gummy Golem tout de suite.", { now = { type = "boolean", description = "Inutilisé" } }, {}, function()
		return if api.spawnBoss() then "Boss apparu" else "Le boss est déjà là"
	end)

	tool("announce", "Affiche une annonce en grand chez tous les joueurs et dans le chat. translate = traduire dans la langue de chaque joueur.", {
		message = { type = "string" },
		translate = { type = "boolean" },
	}, { "message" }, function(admin, a)
		return announce(admin.DisplayName, tostring(a.message), a.translate ~= false)
	end)

	tool("abuse_event", "Lance un événement « admin abusé » pour tout le serveur. coins_x/luck_x/damage_x/speed_x : multiplicateur (value). coin_rain : chaque seconde, value secondes de gains offertes. low_gravity : fraction de la gravité normale. giant/tiny : taille des joueurs. disco, night : ambiance.", {
		kind = { type = "string", enum = abuseKinds },
		value = { type = "number" },
		minutes = { type = "number", description = "Durée, 0,25 à 60 min (5 par défaut)" },
	}, { "kind" }, function(_, a)
		return startAbuse(a.kind, a.value, a.minutes)
	end)

	tool("pet_rain", "Pluie de pets : chaque joueur reçoit un pet au hasard de la rareté choisie (1 Commun … 7 Divin).", {
		rarity = { type = "integer", description = "1 à 7" },
	}, { "rarity" }, function()
		return "" -- remplacé plus bas (a besoin de la liste par rareté)
	end)
	local byRarity: { [number]: { string } } = {}
	for _, id in Config.PetOrder do
		local r = Config.Pets[id].rarity
		byRarity[r] = byRarity[r] or {}
		table.insert(byRarity[r], id)
	end
	TOOLS.pet_rain.run = function(_, a)
		local r = math.clamp(math.floor(tonumber(a.rarity) or 5), 1, 7)
		local pool = byRarity[r]
		for _, p in Players:GetPlayers() do
			local prof = profiles[p]
			if prof and pool then
				local id = pool[math.random(1, #pool)]
				api.addPet(prof.data, id, 0, false)
				refresh(p)
				api.toast(p, "🎁 Pluie de pets ! Tu reçois " .. Config.Pets[id].name .. " !", "FF8FB8")
			end
		end
		Fx:FireAllClients("coinRain", {})
		return "Pluie de pets " .. Config.Rarities[r].name .. " pour tout le serveur"
	end

	tool("stop_events", "Arrête tous les événements « admin abusé » en cours.", { now = { type = "boolean", description = "Inutilisé" } }, {}, function()
		for kind in active do
			stopAbuse(kind)
		end
		broadcastAbuse()
		return "Tous les événements sont arrêtés"
	end)

	tool("kick", "Expulse un joueur du serveur. Seulement si l'admin l'a clairement demandé.", {
		player = PLAYER,
		reason = { type = "string" },
	}, { "player" }, function(admin, a)
		local list = targets(admin, a.player)
		if tostring(a.player):lower() == "all" then
			return "Refusé : on n'expulse pas tout le serveur d'un coup"
		end
		for _, p in list do
			if p ~= admin then
				p:Kick(tostring(a.reason or "Expulsé par un admin"))
			end
		end
		return "Expulsé : " .. names(list)
	end)

	tool("reset_player", "Remet à zéro la partie d'un joueur. Irréversible : confirm doit valoir true, et seulement si l'admin l'a explicitement confirmé.", {
		player = PLAYER,
		confirm = { type = "boolean" },
	}, { "player", "confirm" }, function(admin, a)
		if a.confirm ~= true then
			return "Pas fait : il faut confirmer (confirm = true)"
		end
		local list = targets(admin, a.player)
		if tostring(a.player):lower() == "all" then
			return "Refusé : la remise à zéro se fait joueur par joueur"
		end
		for _, p in list do
			local prof = profiles[p]
			if prof then
				local fresh = api.defaultData()
				for k in prof.data do
					prof.data[k] = nil
				end
				for k, v in fresh do
					prof.data[k] = v
				end
				api.teleport(p, prof, 1)
				refresh(p)
			end
		end
		return "Partie remise à zéro : " .. names(list)
	end)

	local toolList = {}
	for _, name in { "list_players", "give_currency", "give_pet", "give_potion", "teleport", "spawn_boss", "announce", "abuse_event", "pet_rain", "stop_events", "kick", "reset_player" } do
		local t = TOOLS[name]
		table.insert(toolList, { name = t.name, description = t.description, input_schema = t.input_schema })
	end

	local function runTool(admin: Player, name: string, input: any): string
		local t = TOOLS[name]
		if not t then
			return "Action inconnue : " .. tostring(name)
		end
		local ok, res = pcall(t.run, admin, if type(input) == "table" then input else {})
		local text = if ok then tostring(res) else "Erreur : " .. tostring(res)
		log(admin.DisplayName, text)
		return text
	end

	-------------------------------------------------------------------------
	-- Assistant IA
	-------------------------------------------------------------------------
	local catalog = {}
	for r = 1, 7 do
		local ids = {}
		local pool: { string } = byRarity[r] or {}
		for _, id in pool do
			table.insert(ids, id .. " (" .. Config.Pets[id].name .. ")")
		end
		table.insert(catalog, Config.Rarities[r].name .. " : " .. table.concat(ids, ", "))
	end
	local worlds = {}
	for i, w in Config.Worlds do
		table.insert(worlds, i .. " " .. w.name)
	end
	local SYSTEM = table.concat({
		"Tu es l'assistant admin du jeu Roblox « Sweet Pets Factory » (simulateur de pets sur le thème des bonbons et de la mythologie).",
		"L'admin te parle en français. Fais ce qu'il demande avec les outils, puis réponds en une ou deux phrases courtes qui disent ce qui a été fait.",
		"Quand la demande est claire, agis sans demander. Si un nom de joueur est ambigu, appelle list_players d'abord.",
		"kick et reset_player sont graves : ne les utilise que si l'admin les demande clairement ; pour reset_player, demande confirmation avant si l'admin ne l'a pas déjà donnée.",
		"Pour une annonce, laisse translate à true sauf si l'admin dit le contraire : chaque joueur la reçoit dans sa langue.",
		"Mondes : " .. table.concat(worlds, ", ") .. ".",
		"Potions : " .. table.concat(potionIds, ", ") .. ".",
		"Pets par rareté (id et nom) :\n" .. table.concat(catalog, "\n"),
	}, "\n")

	local function ask(admin: Player, text: string): (string, { string })
		local hist = chats[admin.UserId]
		if not hist or #hist > 40 then
			hist = {}
			chats[admin.UserId] = hist
		end
		table.insert(hist, { role = "user", content = text })
		local done = {}
		for _ = 1, 8 do
			local data, err = callClaude({
				max_tokens = 4000,
				output_config = { effort = "low" },
				system = { { type = "text", text = SYSTEM, cache_control = { type = "ephemeral" } } },
				tools = toolList,
				messages = hist,
			})
			if not data then
				table.remove(hist) -- la question n'a pas abouti : on la retire pour pouvoir réessayer
				return err or "Erreur inconnue", done
			end
			table.insert(hist, { role = "assistant", content = data.content })
			if data.stop_reason == "refusal" then
				chats[admin.UserId] = nil
				return "L'IA a refusé cette demande.", done
			end
			if data.stop_reason ~= "tool_use" then
				local parts = {}
				for _, b in data.content do
					if b.type == "text" then
						table.insert(parts, b.text)
					end
				end
				return table.concat(parts, "\n"), done
			end
			local results = {}
			for _, b in data.content do
				if b.type == "tool_use" then
					local res = runTool(admin, b.name, b.input)
					table.insert(done, res)
					table.insert(results, { type = "tool_result", tool_use_id = b.id, content = res })
				end
			end
			table.insert(hist, { role = "user", content = results })
		end
		return "J'ai fait plusieurs actions, je m'arrête là.", done
	end

	-------------------------------------------------------------------------
	-- Remote : le panneau du joueur appelle ici
	-------------------------------------------------------------------------
	local rf = Instance.new("RemoteFunction")
	rf.Name = "Admin"
	rf.Parent = api.remotes
	rf.OnServerInvoke = function(plr: Player, kind: any, a: any, b: any)
		if not isAdmin(plr) then
			return { ok = false, text = "Tu n'es pas admin." }
		end
		if kind == "state" then
			return { ok = true, log = logLines, hasKey = apiKey() ~= nil }
		elseif kind == "act" and type(a) == "string" then
			return { ok = true, text = runTool(plr, a, b) }
		elseif kind == "ai" and type(a) == "string" then
			if busy[plr.UserId] then
				return { ok = false, text = "Une demande est déjà en cours…" }
			end
			busy[plr.UserId] = true
			local okAsk, reply, done = pcall(ask, plr, string.sub(a, 1, 1000))
			busy[plr.UserId] = nil
			if not okAsk then
				return { ok = false, text = "Erreur : " .. tostring(reply) }
			end
			return { ok = true, text = reply, done = done }
		elseif kind == "aiReset" then
			chats[plr.UserId] = nil
			return { ok = true, text = "Nouvelle conversation" }
		end
		return { ok = false, text = "Demande inconnue" }
	end
end

return Admin
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="69">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
    <Item class="Folder" referent="70">
      <Properties>
        <string name="Name">SweetSounds</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="71">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">90</float>
      <float name="CharacterWalkSpeed">22</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="72">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="73">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Sweet Pets Factory : côté joueur
-- Interface, animation d'éclosion, affichage des pets de tous les joueurs,
-- effets (dégâts, pièces, confettis) et sons. Le joueur n'envoie que des
-- demandes au serveur, qui reste seul juge.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PetModels = require(Shared:WaitForChild("PetModels"))
local MapDecor = require(Shared:WaitForChild("MapDecor"))
local HammerModels = require(Shared:WaitForChild("HammerModels"))
local THUMB = 120 -- pièces max par vignette 3D de l'interface
local UI = require(script:WaitForChild("UI"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Action = Remotes:WaitForChild("Action") :: RemoteEvent
local StateEvent = Remotes:WaitForChild("State") :: RemoteEvent
local Fx = Remotes:WaitForChild("Fx") :: RemoteEvent

local S: any = nil -- dernier état reçu du serveur
local muted = false
local fmt = Config.fmt

local function send(name: string, arg: any?)
	Action:FireServer(name, arg)
end

---------------------------------------------------------------------------
-- Sons : sons publics de la bibliothèque Roblox (Roblox, ProSoundEffects, APM),
-- utilisables dans n'importe quel jeu. Pour en changer un, mets un Sound du même
-- nom dans SoundService › SweetSounds : il remplace celui de la liste.
---------------------------------------------------------------------------
local SOUNDS: { [string]: { id: number, vol: number, start: number? } } = {
	click = { id = 15675059323, vol = 0.5 }, -- Roblox_UI_Bright_Click
	open = { id = 15675012262, vol = 0.35 }, -- Roblox_UI_Whoosh_04
	close = { id = 17208186900, vol = 0.35 }, -- Roblox GUI - Back
	error = { id = 17208353912, vol = 0.5 }, -- Roblox GUI - Negative
	tap = { id = 9113537815, vol = 0.3 }, -- Boink Pop Blip
	coin = { id = 17208319162, vol = 0.35 }, -- Roblox GUI - Pickup
	["break"] = { id = 9113959343, vol = 0.6, start = 0.15 }, -- Crack Egg Crunchy
	pop = { id = 17208204604, vol = 0.45 }, -- Roblox GUI - Bubble
	buy = { id = 17208380755, vol = 0.5 }, -- Roblox GUI - Purchase
	quest = { id = 17208361335, vol = 0.5 }, -- Roblox GUI - Notification High
	hatch = { id = 9125805579, vol = 0.45 }, -- montée qui siffle pendant que l'œuf tremble
	crack = { id = 9113959071, vol = 0.6, start = 0.16 }, -- l'œuf craque
	reveal = { id = 15675043410, vol = 0.5 }, -- Roblox_UI_Tonal_Stinger
	reveal_rare = { id = 17208327798, vol = 0.5 }, -- Roblox GUI - Aura
	legend = { id = 1845411858, vol = 0.55, start = 0.24 }, -- APM « Top Prize »
	divine = { id = 9047024260, vol = 0.6 }, -- APM « Epic Win - Stinger 1 »
	burst = { id = 9116384485, vol = 0.5, start = 0.1 }, -- Magic Burst (avec divine)
	travel = { id = 15675024286, vol = 0.55 }, -- Roblox_UI_Whoosh_01
}
local sweet = SoundService:FindFirstChild("SweetSounds")
local soundObjs: { [string]: Sound } = {}
for name, info in SOUNDS do
	local custom = sweet and sweet:FindFirstChild(name)
	local id = if custom and custom:IsA("Sound") and custom.SoundId ~= "" then custom.SoundId else "rbxassetid://" .. info.id
	soundObjs[name] = UI.new("Sound", { Name = "Sfx_" .. name, SoundId = id, Volume = info.vol, Parent = SoundService })
end
local lastSound: { [string]: number } = {}
local coinStreak = 0
local function play(name: string)
	if muted then
		return
	end
	local now = os.clock()
	local last = lastSound[name] or 0
	if now - last < 0.06 then
		return
	end
	lastSound[name] = now
	local snd = soundObjs[name]
	if not snd then
		return
	end
	if name == "coin" then
		-- pièces ramassées à la suite : le son monte d'un demi-ton à chaque fois (une octave max)
		coinStreak = if now - last < 1.2 then math.min(coinStreak + 1, 12) else 0
		snd.PlaybackSpeed = 2 ^ (coinStreak / 12)
	elseif name == "tap" then
		snd.PlaybackSpeed = 0.92 + math.random() * 0.2
	end
	local start = SOUNDS[name].start
	if start then
		-- son local (créé par ce joueur) : on peut sauter le silence du début
		snd.TimePosition = start
		snd:Play()
	else
		SoundService:PlayLocalSound(snd)
	end
end
UI.onClick = function()
	play("click")
end

-- Musique : une par monde, une pour le boss, en fondu
local musicOn = true
local music = UI.new("Sound", { Name = "Music", Looped = true, Volume = 0, Parent = SoundService })
local musicId = 0
local function updateMusic(inBoss: boolean)
	local want = 0
	if musicOn and S then
		want = if inBoss then Config.Music.boss else Config.Music.worlds[S.world] or Config.Music.worlds[1]
	end
	if want == musicId then
		return
	end
	musicId = want
	TweenService:Create(music, TweenInfo.new(0.6), { Volume = 0 }):Play()
	task.delay(0.6, function()
		if musicId ~= want then
			return
		end
		if want == 0 then
			music:Stop()
			return
		end
		music.SoundId = "rbxassetid://" .. want
		music.TimePosition = 0
		music:Play()
		TweenService:Create(music, TweenInfo.new(1.2), { Volume = Config.Music.volume }):Play()
	end)
end
UI.onError = function()
	play("error")
end

---------------------------------------------------------------------------
-- Racine de l'interface
---------------------------------------------------------------------------
local gui = UI.new("ScreenGui", {
	Name = "SweetPets",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
	Parent = player:WaitForChild("PlayerGui"),
})
local uiScale = UI.new("UIScale", { Parent = gui })
local function rescale()
	local cam = workspace.CurrentCamera
	if cam then
		local vs = cam.ViewportSize
		uiScale.Scale = math.clamp(math.min(vs.X / 1280, vs.Y / 720), 0.55, 1.4)
	end
end
rescale()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(rescale)
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
end

local L = Enum.TextXAlignment.Left
local R = Enum.TextXAlignment.Right

local hud = UI.new("Frame", { Name = "HUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = gui })

---------------------------------------------------------------------------
-- Notifications et fenêtres
---------------------------------------------------------------------------
local toastHost = UI.new("Frame", {
	Name = "Toasts",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(600, 300),
	Position = UDim2.new(0.5, 0, 0, 140),
	AnchorPoint = Vector2.new(0.5, 0),
	ZIndex = 10,
	Parent = gui,
})
UI.new("UIListLayout", { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = toastHost })

local toastN = 0
local function toast(text: string, color: Color3?)
	toastN += 1
	local f = UI.box(toastHost, { Size = UDim2.fromOffset(560, 42), Color = if color then UI.lighten(color, 0.55) else UI.WHITE, Radius = 18 })
	local holder = f.Parent :: Frame
	holder.LayoutOrder = toastN
	UI.text(f, { Text = text, TextSize = 19, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), Wrap = true })
	for _, k in toastHost:GetChildren() do
		if k:IsA("Frame") and k.LayoutOrder <= toastN - 4 then
			k:Destroy()
		end
	end
	Debris:AddItem(holder, 3.2)
end

local popupHost = UI.new("Frame", { Name = "Popup", BackgroundColor3 = Color3.fromHex("1B1030"), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), Visible = false, Active = true, ZIndex = 9, Parent = gui })

local function popup(title: string, body: string, okText: string?, onOk: (() -> ())?, cancel: boolean?)
	popupHost:ClearAllChildren()
	popupHost.Visible = true
	local f = UI.box(popupHost, { Size = UDim2.fromOffset(540, 300), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Radius = 26 })
	UI.text(f, { Text = title, TextSize = 34, Color = UI.YELLOW, Outline = 3, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 14) })
	UI.text(f, { Text = body, TextSize = 21, Wrap = true, Size = UDim2.new(1, -60, 0, 130), Position = UDim2.fromOffset(30, 76) })
	local function close()
		popupHost.Visible = false
		popupHost:ClearAllChildren()
	end
	local function ok()
		close()
		if onOk then
			onOk()
		end
	end
	if cancel then
		UI.button(f, { Text = "Annuler", Color = UI.RED, Size = UDim2.fromOffset(200, 54), Position = UDim2.new(0.5, -210, 1, -78) }, close)
		UI.button(f, { Text = okText or "OK", Color = UI.GREEN, Size = UDim2.fromOffset(200, 54), Position = UDim2.new(0.5, 10, 1, -78) }, ok)
	else
		UI.button(f, { Text = okText or "OK", Color = UI.GREEN, Size = UDim2.fromOffset(220, 54), Position = UDim2.new(0.5, -110, 1, -78) }, ok)
	end
end

