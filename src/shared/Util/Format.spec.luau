return function()
	local Format = require(script.Parent.Format)

	describe("short", function()
		it("abbreviates large numbers", function()
			expect(Format.short(0)).to.equal("0")
			expect(Format.short(999)).to.equal("999")
			expect(Format.short(1000)).to.equal("1.00K")
			expect(Format.short(1234)).to.equal("1.23K")
			expect(Format.short(45678)).to.equal("45.6K")
			expect(Format.short(1500000)).to.equal("1.50M")
			expect(Format.short(0 / 0)).to.equal("0")
		end)
	end)

	describe("thousands", function()
		it("groups digits by three", function()
			expect(Format.thousands(5)).to.equal("5")
			expect(Format.thousands(1000)).to.equal("1 000")
			expect(Format.thousands(1000000)).to.equal("1 000 000")
			expect(Format.thousands(250000)).to.equal("250 000")
		end)
	end)

	describe("odds", function()
		it("formats 1 in N", function()
			expect(Format.odds(5000)).to.equal("1 sur 5 000")
		end)
	end)
end
