{
  "name": "revise-ia",
  "productName": "ReviseIA",
  "version": "1.2.0",
  "description": "Scanne tes cours, genere synthèses et exercices avec l'IA, recite tes cours - PC + telephone",
  "main": "main.js",
  "author": "ReviseIA",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win portable --x64",
    "dist:all": "electron-builder --win portable nsis --x64",
    "android": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.reviseia.app",
    "productName": "ReviseIA",
    "files": [
      "main.js",
      "server.js",
      "core.js",
      "ai.js",
      "public/**/*",
      "!public/standalone.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ReviseIA-Portable.exe"
    },
    "nsis": {
      "artifactName": "ReviseIA-Installation.exe",
      "oneClick": true,
      "createDesktopShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zfrnoah5353/Claude..git"
  }
}
